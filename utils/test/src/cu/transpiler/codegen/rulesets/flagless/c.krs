krs 1
# C source, a language of the register lane (code_generator.h), which NVRTC compiles under the prelude. The format is the
# comment at the head of ptx.krs. The file and its signs lie in the thread block's shared memory: place p of this
# thread is word p . threads + thread of cycle_words, and its sign the byte at sign_base + p . threads, past every
# place's word: a lane's frame holds only its own temporaries. The other banks are the lane's own arrays, each
# indexed only by numbers the text names; the compiler holds them as registers. A carry chain passes its carry in
# the variable carry through cycle_c_add and cycle_c_subtract, which the lane's opening defines; an error and a loop
# are a goto, and a lane that is done returns. A word's value is an unsigned 32-bit literal.
ruleset c
toolchain nvrtc
header prelude

# the lane's registers
bank file = cycle_words[({n}u * threads) + thread]
bank sign = ((s8 *)cycle_words)[sign_base + ({n}u * threads)]
bank out = o[{n}]
bank atom = a[{n}]
bank temporary = t[{n}]
bank wide = w[{n}]
bank predicate = p[{n}]
bank member = member[{n}]
bank immediate = {n}u
fixed zero = zero
fixed lane_number = lane_number
fixed record = record_address
fixed index = index_address
fixed body = body_number
fixed bodies = bodies
fixed tables = tables
fixed threads = threads
fixed sign_base = sign_base
fixed indexed = indexed
fixed one = one
fixed ok = ok

# the program's text around the lane
form program_note steps major minor compiler_major compiler_minor block = // a record program of {steps} steps, for sm_{major}{minor}, NVRTC {compiler_major}.{compiler_minor}, as C for the target {block}\n
form lane_open = \nextern __shared__ u32 cycle_words[];\n\n// a 32-bit sum and its carry out, the carry in added\n__device__ static inline u32 cycle_c_add(const u32 left, const u32 right, const u32 carried, u32 *const carry)\n{\n    const u64 total = (u64)left + (u64)right + (u64)carried;\n    *carry = (u32)(total >> 32u);\n    return (u32)total;\n}\n\n// a 32-bit difference and its borrow out, the borrow in taken too\n__device__ static inline u32 cycle_c_subtract(const u32 left, const u32 right, const u32 borrowed, u32 *const borrow)\n{\n    const u64 total = (u64)left - (u64)right - (u64)borrowed;\n    *borrow = (u32)((total >> 32u) & 1u);\n    return (u32)total;\n}\n\n// a product's low word with a word added, and the sum's carry out\n__device__ static inline u32 cycle_c_product_low(const u32 left, const u32 right, const u32 added, u32 *const carry)\n{\n    const u64 total = (u64)(left * right) + (u64)added;\n    *carry = (u32)(total >> 32u);\n    return (u32)total;\n}\n\nextern "C" __device__ void cycle_lane(const CycleCompiledLaunch *launch_given, const u64 lane_given)\n{\n
nop lane_body
form lane_close = }\n

# the lane's declarations
form declare_predicates count =     int p[{count}];\n
form declare_fixed_predicates =     int indexed, one, ok;\n
nop declare_file count
nop declare_signs count
form declare_out count =     u32 o[{count}];\n
form declare_atoms count =     u32 a[{count}];\n
form declare_temporaries count =     u32 t[{count}];\n
form declare_wides count =     u64 w[{count}];\n
form declare_fixed_words =     u32 zero, carry, thread, threads, sign_base;\n
form declare_fixed_wides =     u64 launch, lane_number, record_address, index_address, body_number, bodies, tables;\n
form declare_members count =     u64 member[{count}];\n

# the lane's opening and close
form launch_open =     launch = (u64)launch_given;\n    lane_number = lane_given;\n    zero = 0u;\n    carry = 0u;\n
form launch_load_wide to offset =     {to} = *(const u64 *)(launch + {offset}ull);\n
nop cast_global to
form shared_open =     thread = threadIdx.x;\n    threads = blockDim.x;\n    sign_base = thread;\n
nop shared_close
form global_load_word_if where to address =     if ({where})\n    {\n        {to} = *(const u32 *){address};\n    }\n
form wide_from_word_if where to from =     if ({where})\n    {\n        {to} = (u64){from};\n    }\n
form error_open_unless where =     if (!{where})\n    {\n        goto error_open;\n    }\n
form error_if where at =     if ({where})\n    {\n        goto error{at};\n    }\n
form label_error_open = error_open:\n
form label_error at = error{at}:\n
form global_add_atomic_word address =     atomicAdd((u32 *){address}, 1u);\n
form return =     return;\n
form step_note at operation =     // step {at}, operation {operation}\n

# carry chains through a register's limbs: alone for a register of one limb, else first, middle and last
form word_add to left right =     {to} = {left} + {right};\n
form word_add_first to left right =     {to} = cycle_c_add({left}, {right}, 0u, &carry);\n
form word_add_middle to left right =     {to} = cycle_c_add({left}, {right}, carry, &carry);\n
form word_add_last to left right =     {to} = {left} + {right} + carry;\n
form word_sub to left right =     {to} = {left} - {right};\n
form word_sub_first to left right =     {to} = cycle_c_subtract({left}, {right}, 0u, &carry);\n
form word_sub_middle to left right =     {to} = cycle_c_subtract({left}, {right}, carry, &carry);\n
form word_sub_last to left right =     {to} = {left} - {right} - carry;\n
# the subtract chain whose top limb leaves its borrow for word_borrow_read
form word_borrow to left right =     {to} = cycle_c_subtract({left}, {right}, 0u, &carry);\n
form word_borrow_first to left right =     {to} = cycle_c_subtract({left}, {right}, 0u, &carry);\n
form word_borrow_middle to left right =     {to} = cycle_c_subtract({left}, {right}, carry, &carry);\n
form word_borrow_last to left right =     {to} = cycle_c_subtract({left}, {right}, carry, &carry);\n
form word_borrow_read held where =     {held} = 0u - carry;\n    {where} = (carry != 0u);\n

# a word's arithmetic
form word_copy to from =     {to} = {from};\n
form word_set to value =     {to} = (u32){value};\n
form word_bitand to left right =     {to} = {left} & {right};\n
form word_bitor to left right =     {to} = {left} | {right};\n
form word_bitxor to left right =     {to} = {left} ^ {right};\n
form word_shl to from bits =     {to} = {from} << {bits}u;\n
form word_shr to from bits =     {to} = {from} >> {bits}u;\n
form word_funnel_right to low high bits =     {to} = (u32)((((u64){high} << 32u) | (u64){low}) >> {bits}u);\n
form word_mul to left right =     {to} = {left} * {right};\n
form word_mul_add to left right added =     {to} = ({left} * {right}) + {added};\n
form word_div to left right =     {to} = {left} / {right};\n
form word_select to chosen otherwise where =     {to} = ({where}) ? (u32){chosen} : (u32){otherwise};\n
form word_mul_low to left right added =     {to} = cycle_c_product_low({left}, {right}, {added}, &carry);\n
form word_mul_high to left right =     {to} = (u32)(((u64){left} * (u64){right}) >> 32u) + carry;\n

# a sign's arithmetic, a signed byte of -1, 0 or 1
form sign_set to value =     {to} = (s8)({value});\n
form sign_select to chosen otherwise where =     {to} = (s8)(({where}) ? (int)({chosen}) : (int)({otherwise}));\n
form sign_mul to left right =     {to} = (s8)((int)(s8){left} * (int)(s8){right});\n
form sign_absolute to from =     {to} = ((int)(s8){from} < 0) ? (u32)(-(int)(s8){from}) : (u32)(s8){from};\n
form sign_neg to from =     {to} = (s8)(-(int)(s8){from});\n

# tests, each setting a predicate
form test_word_nonzero where value =     {where} = ({value} != 0u);\n
form test_word_zero where value =     {where} = ({value} == 0u);\n
form test_signed_word_negative where value =     {where} = ((int){value} < 0);\n
form test_sign_ne where left right =     {where} = ((int)(s8){left} != (int)({right}));\n
form test_sign_gt where left right =     {where} = ((int)(s8){left} > (int)(s8){right});\n
form test_wide_nonzero where value =     {where} = ({value} != (u64)0u);\n
form test_wide_zero where value =     {where} = ({value} == (u64)0u);\n
form test_wide_eq where left right =     {where} = ({left} == (u64){right});\n
form test_wide_lt where left right =     {where} = ({left} < {right});\n
form test_wide_lt_and where left right also =     {where} = ({left} < {right}) && {also};\n
err test_word_nonzero_and where value also
err test_word_nonzero_or where value also
err test_wide_nonzero_and where value also
err test_wide_nonzero_or where value also
form predicate_bitxor where left right =     {where} = {left} ^ {right};\n
form predicate_bitand where left right =     {where} = {left} && {right};\n

# 64-bit words: addresses, the lane's number and a division's parts
form wide_from_word to from =     {to} = (u64){from};\n
form word_from_wide to from =     {to} = (u32){from};\n
form wide_pack to low high =     {to} = ((u64){high} << 32u) | (u64){low};\n
form wide_unpack low high from =     {low} = (u32){from};\n    {high} = (u32)({from} >> 32u);\n
form wide_mul to left right =     {to} = {left} * (u64){right};\n
form wide_mul_word to left right =     {to} = (u64){left} * (u64){right};\n
form wide_add to left right =     {to} = {left} + {right};\n
form wide_shl to from bits =     {to} = {from} << {bits}u;\n
form wide_select to chosen otherwise where =     {to} = ({where}) ? (u64){chosen} : (u64){otherwise};\n
form wide_div to left right =     {to} = {left} / {right};\n

# memory: the members' and the tables' words and the record's words
form global_load_constant_word to address offset =     {to} = *(const u32 *)({address} + {offset}ull);\n
form record_store_word offset from =     *(u32 *)(record_address + {offset}ull) = {from};\n

# the states a target that clocks the lane a state at a time cuts it into (vhdl.krs); a C lane runs straight through
nop declare_states count
nop state_start state
nop state_open state
nop state_next state error
nop state_exit
nop state_dispatch error state

# a memory read's address named a state ahead of the read (vhdl.krs); a C load names its address itself
nop launch_ask offset
nop global_ask address offset
nop global_ask_if where address
nop global_ask_atomic address

# a loop: its label, and the goto back to it where the predicate holds
form label_loop loop = loop{loop}:\n
form loop_back_if loop where =     if ({where})\n    {\n        goto loop{loop};\n    }\n
nop state_loop back where next

# the program resident around the lane: the kernel the record machine launches, which takes the launch's lanes a round
# a thread block and holds the program to its block (vhdl.krs writes the same resident as a circuit)
form program_unit launch_bytes count_offset hot_offset block_offset number_offset ttl_offset checkin_every_offset next_offset start_offset finished_offset checkins_offset owner_at command_at state_at offset_at step_at launch_time_at exectime_at checkin_at checkin_time_at run_command stop_command done_state stopped_state yielded_state = \n// the device's timer, in nanoseconds, where a device's compiler builds the text; 0 on a host that only compiles it\n__device__ __forceinline__ static u64 cycle_clock(void)\n{\n    u64 now = 0ull;\n#if defined(__CUDACC__)\n    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(now));\n#endif\n    return now;\n}\n\n// The program resident: each thread block takes the next round of lanes from the one counter, and before each round\n// its first thread reads the clock. Past the launch's time to live, or told by the block's command, the thread block\n// leaves without taking more; every so often it checks in to the block. The thread block that opens the launch runs\n// one round before the clock can send it out: every launch moves the program on however short its time to live. A\n// launch that does not find its number as the block's owner leaves at once and writes nothing. The last thread block\n// out writes where the program stands, its state last. The block's words are read at their byte offsets\nextern "C" __global__ void __launch_bounds__(256) cycle_program(CycleCompiledLaunch launch)\n{\n    __shared__ u64 claimed;\n    volatile u64 *const block = launch.block;\n    u64 checked = 0ull;\n    u64 rounds = 0ull;\n    int opened = 0;\n    if (threadIdx.x == 0u)\n    {\n        opened = (atomicCAS(&launch.hot->launch_start, 0ull, cycle_clock()) == 0ull) ? 1 : 0;\n    }\n    for (;;)\n    {\n        if (threadIdx.x == 0u)\n        {\n            const u64 now = cycle_clock();\n            const u64 ran = now - *(volatile u64 *)&launch.hot->launch_start;\n            int leave = (((opened == 0) || (rounds != 0ull)) && (ran >= launch.ttl)) ? 1 : 0;\n            if ((now - checked) >= launch.checkin_every)\n            {\n                checked = now;\n                const int owned = (block[{owner_at}u / 8u] == launch.launch_number) ? 1 : 0;\n                leave = ((owned == 0) || (block[{command_at}u / 8u] != {run_command}ull)) ? 1 : leave;\n                if (owned != 0)\n                {\n                    const u64 next = *(volatile u64 *)&launch.hot->next_lane;\n                    block[{checkin_at}u / 8u] = atomicAdd(&launch.hot->checkins, 1ull) + 1ull;\n                    block[{checkin_time_at}u / 8u] = now;\n                    block[{offset_at}u / 8u] = (next < launch.count) ? next : launch.count;\n                }\n            }\n            claimed = (leave != 0) ? launch.count : atomicAdd(&launch.hot->next_lane, (u64)blockDim.x);\n            rounds += 1ull;\n        }\n        __syncthreads();\n        const u64 first = claimed;\n        __syncthreads();\n        if (first >= launch.count)\n        {\n            break;\n        }\n        if ((first + threadIdx.x) < launch.count)\n        {\n            cycle_lane(&launch, first + threadIdx.x);\n        }\n    }\n    if (threadIdx.x == 0u)\n    {\n        __threadfence();\n        if (atomicAdd(&launch.hot->finished, 1ull) == ((u64)gridDim.x - 1ull))\n        {\n            const u64 now = cycle_clock();\n            const u64 next = *(volatile u64 *)&launch.hot->next_lane;\n            const u64 start = *(volatile u64 *)&launch.hot->launch_start;\n            if (block[{owner_at}u / 8u] == launch.launch_number)\n            {\n                const u64 command = block[{command_at}u / 8u];\n                block[{offset_at}u / 8u] = (next < launch.count) ? next : launch.count;\n                block[{step_at}u / 8u] = 0ull;\n                block[{launch_time_at}u / 8u] = start;\n                block[{exectime_at}u / 8u] = now - start;\n                block[{checkin_at}u / 8u] = atomicAdd(&launch.hot->checkins, 1ull) + 1ull;\n                block[{checkin_time_at}u / 8u] = now;\n                __threadfence();\n                block[{state_at}u / 8u] = (next >= launch.count) ? {done_state}ull\n                                        : ((command == {stop_command}ull) ? {stopped_state}ull : {yielded_state}ull);\n                __threadfence();\n            }\n        }\n    }\n}\n

# a kernel of its own, which this language does not write
err kernel_open
err kernel_close
err thread_idx_x to
err thread_idx_y to
err thread_idx_z to
err block_idx_x to
err block_idx_y to
err block_idx_z to
err block_dim_x to
err block_dim_y to
err block_dim_z to
err grid_dim_x to
err grid_dim_y to
err grid_dim_z to
err warp_size to
err parameter_load_word to offset
err parameter_load_wide to offset
err test_word_lt where left right
err exit_unless where
err wide_mul_word_add to left right added
err global_load_word to address offset
err global_load_wide to address offset
err global_load_byte to address offset
err global_load_signed_byte to address offset
err global_load_halfword to address offset
err global_load_signed_halfword to address offset
err global_store_wide address offset from
err wide_from_signed_word to from
err word_from_byte to from
err word_from_signed_byte to from
err word_from_halfword to from
err word_from_signed_halfword to from
err test_word_ge where left right
err exit_if where
err test_word_le where left right
err test_word_ne where left right
err test_word_eq where left right
err test_word_gt where left right
err test_signed_word_lt where left right
err test_signed_word_ge where left right
err test_signed_word_le where left right
err test_signed_word_gt where left right
err test_wide_ne where left right
err test_wide_le where left right
err test_wide_gt where left right
err test_wide_ge where left right
err test_signed_wide_lt where left right
err test_signed_wide_le where left right
err test_signed_wide_gt where left right
err test_signed_wide_ge where left right
