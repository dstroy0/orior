;
; The entries archive/utils/test/src/python/engine/nbody/orior/sift_test.py reads from the orior kernel built alone as a Windows DLL, with
; ORIOR_COUNT_READS=1 so the read counters exist. A shared object on Linux exports them without this file.
LIBRARY orior_host
EXPORTS
    orior_naive
    orior_inorder
    orior_free
    orior_run
    orior_choose
    orior_engine_name
    orior_anchors_for
    orior_counters_reset
    orior_probes DATA
    orior_verifications DATA
    orior_field_census
    orior_steer_magnitude
    orior_steer_probe_order
    orior_steer_prefers_free
    orior_steer_count
    orior_steer_count_with_probes
    orior_steer_probe_fits
    orior_steer_probes_reset
    orior_steer_probes DATA
