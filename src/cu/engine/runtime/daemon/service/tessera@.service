# tessera's daemon for one device, started by its socket: systemd passes the listening socket over as fd 3
# (LISTEN_FDS=1), the daemon takes it instead of binding its own, and ends once it has held no job for its idle time.
# The next connection starts it again. Each job's own idle time replaces the one given here.
[Unit]
Description=tessera daemon for device %i
Requires=tessera@%i.socket
After=tessera@%i.socket
# a daemon that gives an error (a history whose seal fails, a device that it cannot measure) closes every connection
# that waits before it exits. Thus each start answers a real client. The start limit of systemd would only turn
# clients away
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/tessera_daemon --device %i --luid 0 --idle 5000000
