krs 1
# CUDA C++, a language of the register lane (code_generator.h), which nvcc compiles. The format is the comment at
# the head of ptx.krs. Each form is spelled in the language itself: its own types, and its own intrinsic where the
# language gives one for the form. The lane's file, signs and banks lie as c.krs lays them, and its opening and its
# resident read the launch the prelude defines.
ruleset cu
toolchain nvcc
header prelude

# the lane's registers
bank file = cycle_words[({n}u * threads) + thread]
bank sign = ((signed char *)cycle_words)[sign_base + ({n}u * threads)]
bank out = o[{n}]
bank atom = a[{n}]
bank temporary = t[{n}]
bank wide = w[{n}]
bank predicate = p[{n}]
bank member = member[{n}]
bank immediate = {n}u
fixed zero = zero
fixed lane_number = lane_number
fixed record = record_address
fixed index = index_address
fixed body = body_number
fixed bodies = bodies
fixed tables = tables
fixed threads = threads
fixed sign_base = sign_base
fixed indexed = indexed
fixed one = one
fixed ok = ok

# the program's text around the lane
form program_note steps major minor compiler_major compiler_minor block = // a record program of {steps} steps, for sm_{major}{minor}, NVRTC {compiler_major}.{compiler_minor}, as C for the target {block}\n
form lane_open = \nextern __shared__ unsigned int cycle_words[];\n\n// a 32-bit sum and its carry out, the carry in added\n__device__ static inline unsigned int cycle_c_add(const unsigned int left, const unsigned int right, const unsigned int carried, unsigned int *const carry)\n{\n    const unsigned long long total = (unsigned long long)left + (unsigned long long)right + (unsigned long long)carried;\n    *carry = (unsigned int)(total >> 32u);\n    return (unsigned int)total;\n}\n\n// a 32-bit difference and its borrow out, the borrow in taken too\n__device__ static inline unsigned int cycle_c_subtract(const unsigned int left, const unsigned int right, const unsigned int borrowed, unsigned int *const borrow)\n{\n    const unsigned long long total = (unsigned long long)left - (unsigned long long)right - (unsigned long long)borrowed;\n    *borrow = (unsigned int)((total >> 32u) & 1u);\n    return (unsigned int)total;\n}\n\n// a product's low word with a word added, and the sum's carry out\n__device__ static inline unsigned int cycle_c_product_low(const unsigned int left, const unsigned int right, const unsigned int added, unsigned int *const carry)\n{\n    const unsigned long long total = (unsigned long long)(left * right) + (unsigned long long)added;\n    *carry = (unsigned int)(total >> 32u);\n    return (unsigned int)total;\n}\n\nextern "C" __device__ void cycle_lane(const CycleCompiledLaunch *launch_given, const unsigned long long lane_given)\n{\n
nop lane_body
form lane_close = }\n

# the lane's declarations
form declare_predicates count =     int p[{count}];\n
form declare_fixed_predicates =     int indexed, one, ok;\n
nop declare_file count
nop declare_signs count
form declare_out count =     unsigned int o[{count}];\n
form declare_atoms count =     unsigned int a[{count}];\n
form declare_temporaries count =     unsigned int t[{count}];\n
form declare_wides count =     unsigned long long w[{count}];\n
form declare_fixed_words =     unsigned int zero, carry, thread, threads, sign_base;\n
form declare_fixed_wides =     unsigned long long launch, lane_number, record_address, index_address, body_number, bodies, tables;\n
form declare_members count =     unsigned long long member[{count}];\n

# the lane's opening and close
form open_launch =     launch = (unsigned long long)launch_given;\n    lane_number = lane_given;\n    zero = 0u;\n    carry = 0u;\n
form launch_load to offset =     {to} = *(const unsigned long long *)(launch + {offset}ull);\n
nop to_global to
form shared_open =     thread = threadIdx.x;\n    threads = blockDim.x;\n    sign_base = thread;\n
nop shared_close
form guarded_load where to address =     if ({where})\n    {\n        {to} = *(const unsigned int *){address};\n    }\n
form guarded_widen where to from =     if ({where})\n    {\n        {to} = (unsigned long long){from};\n    }\n
form open_error_unless where =     if (!{where})\n    {\n        goto error_open;\n    }\n
form error where at =     if ({where})\n    {\n        goto error{at};\n    }\n
form label_error_open = error_open:\n
form label_error at = error{at}:\n
form count_add address =     atomicAdd((unsigned int *){address}, 1u);\n
form return =     return;\n
form step_note at operation =     // step {at}, operation {operation}\n

# carry chains through a register's limbs: alone for a register of one limb, else first, middle and last
form add_alone to left right =     {to} = {left} + {right};\n
form add_first to left right =     {to} = cycle_c_add({left}, {right}, 0u, &carry);\n
form add_middle to left right =     {to} = cycle_c_add({left}, {right}, carry, &carry);\n
form add_last to left right =     {to} = {left} + {right} + carry;\n
form subtract_alone to left right =     {to} = {left} - {right};\n
form subtract_first to left right =     {to} = cycle_c_subtract({left}, {right}, 0u, &carry);\n
form subtract_middle to left right =     {to} = cycle_c_subtract({left}, {right}, carry, &carry);\n
form subtract_last to left right =     {to} = {left} - {right} - carry;\n
# the subtract chain whose top limb leaves its borrow for borrow_read
form borrow_alone to left right =     {to} = cycle_c_subtract({left}, {right}, 0u, &carry);\n
form borrow_first to left right =     {to} = cycle_c_subtract({left}, {right}, 0u, &carry);\n
form borrow_middle to left right =     {to} = cycle_c_subtract({left}, {right}, carry, &carry);\n
form borrow_last to left right =     {to} = cycle_c_subtract({left}, {right}, carry, &carry);\n
form borrow_read borrow where =     {borrow} = 0u - carry;\n    {where} = (carry != 0u);\n

# a word's arithmetic
form word_copy to from =     {to} = {from};\n
form word_set to value =     {to} = (unsigned int){value};\n
form word_and to left right =     {to} = {left} & {right};\n
form word_or to left right =     {to} = {left} | {right};\n
form word_xor to left right =     {to} = {left} ^ {right};\n
form word_shift_left to from bits =     {to} = {from} << {bits}u;\n
form word_shift_right to from bits =     {to} = {from} >> {bits}u;\n
form word_funnel_right to low high bits =     {to} = __funnelshift_r({low}, {high}, {bits}u);\n
form word_multiply to left right =     {to} = {left} * {right};\n
form word_multiply_add to left right added =     {to} = ({left} * {right}) + {added};\n
form word_divide to left right =     {to} = {left} / {right};\n
form word_select to chosen otherwise where =     {to} = ({where}) ? (unsigned int){chosen} : (unsigned int){otherwise};\n
form product_low to left right added =     {to} = cycle_c_product_low({left}, {right}, {added}, &carry);\n
form product_high to left right =     {to} = __umulhi({left}, {right}) + carry;\n

# a sign's arithmetic, a signed byte of -1, 0 or 1
form sign_set to value =     {to} = (signed char)({value});\n
form sign_select to chosen otherwise where =     {to} = (signed char)(({where}) ? (int)({chosen}) : (int)({otherwise}));\n
form sign_multiply to left right =     {to} = (signed char)((int)(signed char){left} * (int)(signed char){right});\n
form sign_absolute to from =     {to} = ((int)(signed char){from} < 0) ? (unsigned int)(-(int)(signed char){from}) : (unsigned int)(signed char){from};\n
form sign_negate to from =     {to} = (signed char)(-(int)(signed char){from});\n

# tests, each setting a predicate
form test_nonzero where value =     {where} = ({value} != 0u);\n
form test_zero where value =     {where} = ({value} == 0u);\n
form test_negative where value =     {where} = ((int){value} < 0);\n
form test_signed_differ where left right =     {where} = ((int)(signed char){left} != (int)({right}));\n
form test_signed_greater where left right =     {where} = ((int)(signed char){left} > (int)(signed char){right});\n
form test_wide_nonzero where value =     {where} = ({value} != 0ull);\n
form test_wide_equal where left right =     {where} = ({left} == (unsigned long long){right});\n
form test_wide_below where left right =     {where} = ({left} < {right});\n
form test_wide_below_and where left right also =     {where} = ({left} < {right}) && {also};\n
form predicate_xor where left right =     {where} = {left} ^ {right};\n
form predicate_and where left right =     {where} = {left} && {right};\n

# 64-bit words: addresses, the lane's number and a division's parts
form wide_from_word to from =     {to} = (unsigned long long){from};\n
form word_from_wide to from =     {to} = (unsigned int){from};\n
form wide_pack to low high =     {to} = ((unsigned long long){high} << 32u) | (unsigned long long){low};\n
form wide_unpack low high from =     {low} = (unsigned int){from};\n    {high} = (unsigned int)({from} >> 32u);\n
form wide_multiply to left right =     {to} = {left} * (unsigned long long){right};\n
form wide_multiply_word to left right =     {to} = (unsigned long long){left} * (unsigned long long){right};\n
form wide_add to left right =     {to} = {left} + {right};\n
form wide_add_unsigned to left right =     {to} = {left} + (unsigned long long){right};\n
form wide_shift_left to from bits =     {to} = {from} << {bits}u;\n
form wide_select to chosen otherwise where =     {to} = ({where}) ? (unsigned long long){chosen} : (unsigned long long){otherwise};\n
form wide_divide to left right =     {to} = {left} / {right};\n

# memory: the members' and the tables' words and the record's words
form global_load to address offset =     {to} = *(const unsigned int *)({address} + {offset}ull);\n
form record_store offset from =     *(unsigned int *)(record_address + {offset}ull) = {from};\n

# the states a target that clocks the lane a state at a time cuts it into (vhdl.krs); a C lane runs straight through
nop states_declare count
nop state_start state
nop state_open state
nop state_next state error
nop state_exit
nop dispatch_to error state

# a memory read's address named a state ahead of the read (vhdl.krs); a C load names its address itself
nop launch_ask offset
nop global_ask address offset
nop guarded_ask where address
nop count_ask address

# a loop: its label, and the goto back to it where the predicate holds
form loop_label loop = loop{loop}:\n
form loop_back loop where =     if ({where})\n    {\n        goto loop{loop};\n    }\n
nop state_loop back where next

# the program resident around the lane: the kernel the record machine launches, which takes the launch's lanes a round
# a thread block and holds the program to its block (vhdl.krs writes the same resident as a circuit)
form program_unit launch_bytes count_offset hot_offset block_offset number_offset ttl_offset checkin_every_offset next_offset start_offset finished_offset checkins_offset owner_at command_at state_at offset_at step_at launch_time_at exectime_at checkin_at checkin_time_at run_command stop_command done_state stopped_state yielded_state = \n// the device's timer, in nanoseconds, where a device's compiler builds the text; 0 on a host that only compiles it\n__device__ __forceinline__ static unsigned long long cycle_clock(void)\n{\n    unsigned long long now = 0ull;\n#if defined(__CUDACC__)\n    asm volatile("mov.unsigned long long %0, %%globaltimer;" : "=l"(now));\n#endif\n    return now;\n}\n\n// The program resident: each thread block takes the next round of lanes from the one counter, and before each round\n// its first thread reads the clock. Past the launch's time to live, or told by the block's command, the thread block\n// leaves without taking more; every so often it checks in to the block. The thread block that opens the launch runs\n// one round before the clock can send it out: every launch moves the program on however short its time to live. A\n// launch that does not find its number as the block's owner leaves at once and writes nothing. The last thread block\n// out writes where the program stands, its state last. The block's words are read at their byte offsets\nextern "C" __global__ void __launch_bounds__(256) cycle_program(CycleCompiledLaunch launch)\n{\n    __shared__ unsigned long long claimed;\n    volatile unsigned long long *const block = launch.block;\n    unsigned long long checked = 0ull;\n    unsigned long long rounds = 0ull;\n    int opened = 0;\n    if (threadIdx.x == 0u)\n    {\n        opened = (atomicCAS(&launch.hot->launch_start, 0ull, cycle_clock()) == 0ull) ? 1 : 0;\n    }\n    for (;;)\n    {\n        if (threadIdx.x == 0u)\n        {\n            const unsigned long long now = cycle_clock();\n            const unsigned long long ran = now - *(volatile unsigned long long *)&launch.hot->launch_start;\n            int leave = (((opened == 0) || (rounds != 0ull)) && (ran >= launch.ttl)) ? 1 : 0;\n            if ((now - checked) >= launch.checkin_every)\n            {\n                checked = now;\n                const int owned = (block[{owner_at}u / 8u] == launch.launch_number) ? 1 : 0;\n                leave = ((owned == 0) || (block[{command_at}u / 8u] != {run_command}ull)) ? 1 : leave;\n                if (owned != 0)\n                {\n                    const unsigned long long next = *(volatile unsigned long long *)&launch.hot->next_lane;\n                    block[{checkin_at}u / 8u] = atomicAdd(&launch.hot->checkins, 1ull) + 1ull;\n                    block[{checkin_time_at}u / 8u] = now;\n                    block[{offset_at}u / 8u] = (next < launch.count) ? next : launch.count;\n                }\n            }\n            claimed = (leave != 0) ? launch.count : atomicAdd(&launch.hot->next_lane, (unsigned long long)blockDim.x);\n            rounds += 1ull;\n        }\n        __syncthreads();\n        const unsigned long long first = claimed;\n        __syncthreads();\n        if (first >= launch.count)\n        {\n            break;\n        }\n        if ((first + threadIdx.x) < launch.count)\n        {\n            cycle_lane(&launch, first + threadIdx.x);\n        }\n    }\n    if (threadIdx.x == 0u)\n    {\n        __threadfence();\n        if (atomicAdd(&launch.hot->finished, 1ull) == ((unsigned long long)gridDim.x - 1ull))\n        {\n            const unsigned long long now = cycle_clock();\n            const unsigned long long next = *(volatile unsigned long long *)&launch.hot->next_lane;\n            const unsigned long long start = *(volatile unsigned long long *)&launch.hot->launch_start;\n            if (block[{owner_at}u / 8u] == launch.launch_number)\n            {\n                const unsigned long long command = block[{command_at}u / 8u];\n                block[{offset_at}u / 8u] = (next < launch.count) ? next : launch.count;\n                block[{step_at}u / 8u] = 0ull;\n                block[{launch_time_at}u / 8u] = start;\n                block[{exectime_at}u / 8u] = now - start;\n                block[{checkin_at}u / 8u] = atomicAdd(&launch.hot->checkins, 1ull) + 1ull;\n                block[{checkin_time_at}u / 8u] = now;\n                __threadfence();\n                block[{state_at}u / 8u] = (next >= launch.count) ? {done_state}ull\n                                        : ((command == {stop_command}ull) ? {stopped_state}ull : {yielded_state}ull);\n                __threadfence();\n            }\n        }\n    }\n}\n

# a kernel of its own: its body's braces, the built-in variables, a comparison, a return under a guard, and the global
# memory a pointer parameter reaches. CUDA names a parameter and never reads one at an offset
form kernel_open = {\n
form kernel_close = }\n
form thread_idx_x to =     {to} = threadIdx.x;\n
form thread_idx_y to =     {to} = threadIdx.y;\n
form thread_idx_z to =     {to} = threadIdx.z;\n
form block_idx_x to =     {to} = blockIdx.x;\n
form block_idx_y to =     {to} = blockIdx.y;\n
form block_idx_z to =     {to} = blockIdx.z;\n
form block_dim_x to =     {to} = blockDim.x;\n
form block_dim_y to =     {to} = blockDim.y;\n
form block_dim_z to =     {to} = blockDim.z;\n
form grid_dim_x to =     {to} = gridDim.x;\n
form grid_dim_y to =     {to} = gridDim.y;\n
form grid_dim_z to =     {to} = gridDim.z;\n
form warp_size to =     {to} = warpSize;\n
err parameter_load to offset
err parameter_load_wide to offset
form test_word_below where left right =     {where} = ({left} < {right});\n
form exit_unless where =     if (!{where})\n    {\n        return;\n    }\n
form wide_multiply_word_add to left right added =     {to} = ((unsigned long long){left} * {right}) + {added};\n
form global_load_word to address offset =     {to} = *(const unsigned int *)({address} + {offset}ull);\n
form global_load_wide to address offset =     {to} = *(const unsigned long long *)({address} + {offset}ull);\n
form global_store_wide address offset from =     *(unsigned long long *)({address} + {offset}ull) = {from};\n
form wide_from_signed_word to from =     {to} = (unsigned long long)(long long)(int){from};\n
form test_word_geq where left right =     {where} = ({left} >= {right});\n
form exit_if where =     if ({where})\n    {\n        return;\n    }\n
form test_word_leq where left right =     {where} = ({left} <= {right});\n
form test_word_neq where left right =     {where} = ({left} != {right});\n
form test_word_identical where left right =     {where} = ({left} == {right});\n
