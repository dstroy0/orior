krs 1
# OpenQASM 2.0 with the gates of qelib1.inc, which Qiskit reads, transpiles to a backend's own gates, and runs. The
# format is the comment at the head of ptx.krs. A program opens with OPENQASM 2.0; and includes qelib1.inc, declares
# its quantum and classical registers, applies gates to qubits, and measures qubits into bits. An angle is an
# expression of numbers, pi and a gate's own parameters under + - * / ^, unary minus and sin, cos, tan, exp, ln and
# sqrt.
ruleset openqasm2_0
toolchain qiskit
header OPENQASM

# the program's statements
form OPENQASM = OPENQASM 2.0;\n
form include file = include "{file}";\n
form qreg name size = qreg {name}[{size}];\n
form creg name size = creg {name}[{size}];\n
form gate name parameters qubits body = gate {name}({parameters}) {qubits} { {body} }\n
form opaque name parameters qubits = opaque {name}({parameters}) {qubits};\n
form measure qubit bit = measure {qubit} -> {bit};\n
form reset qubit = reset {qubit};\n
form barrier qubits = barrier {qubits};\n
form if register value = if({register}=={value})

# an angle's constant and functions
form pi = pi
form sin angle = sin({angle})
form cos angle = cos({angle})
form tan angle = tan({angle})
form exp angle = exp({angle})
form ln angle = ln({angle})
form sqrt angle = sqrt({angle})

# the two gates the language holds without qelib1.inc
form U theta phi lambda q = U({theta},{phi},{lambda}) {q};\n
form CX c t = CX {c},{t};\n

# the gates of qelib1.inc on one qubit
form u3 theta phi lambda q = u3({theta},{phi},{lambda}) {q};\n
form u theta phi lambda q = u({theta},{phi},{lambda}) {q};\n
form u2 phi lambda q = u2({phi},{lambda}) {q};\n
form u1 lambda q = u1({lambda}) {q};\n
form p lambda q = p({lambda}) {q};\n
form u0 gamma q = u0({gamma}) {q};\n
form id a = id {a};\n
form iden a = iden {a};\n
form x a = x {a};\n
form y a = y {a};\n
form z a = z {a};\n
form h a = h {a};\n
form s a = s {a};\n
form sdg a = sdg {a};\n
form t a = t {a};\n
form tdg a = tdg {a};\n
form rx theta a = rx({theta}) {a};\n
form ry theta a = ry({theta}) {a};\n
form rz phi a = rz({phi}) {a};\n
form sx a = sx {a};\n
form sxdg a = sxdg {a};\n

# the gates of qelib1.inc on two qubits
form cx c t = cx {c},{t};\n
form cz a b = cz {a},{b};\n
form cy a b = cy {a},{b};\n
form swap a b = swap {a},{b};\n
form ch a b = ch {a},{b};\n
form crx lambda a b = crx({lambda}) {a},{b};\n
form cry lambda a b = cry({lambda}) {a},{b};\n
form crz lambda a b = crz({lambda}) {a},{b};\n
form cu1 lambda a b = cu1({lambda}) {a},{b};\n
form cp lambda a b = cp({lambda}) {a},{b};\n
form cu3 theta phi lambda c t = cu3({theta},{phi},{lambda}) {c},{t};\n
form cu theta phi lambda gamma c t = cu({theta},{phi},{lambda},{gamma}) {c},{t};\n
form csx a b = csx {a},{b};\n
form rzz theta a b = rzz({theta}) {a},{b};\n
form rxx theta a b = rxx({theta}) {a},{b};\n
form ryy theta a b = ryy({theta}) {a},{b};\n

# the gates of qelib1.inc on three qubits and more
form ccx a b c = ccx {a},{b},{c};\n
form cswap a b c = cswap {a},{b},{c};\n
form c3x a b c d = c3x {a},{b},{c},{d};\n
form c4x a b c d e = c4x {a},{b},{c},{d},{e};\n
