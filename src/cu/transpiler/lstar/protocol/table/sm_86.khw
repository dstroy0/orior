forms 2
# The part's instructions as the cell's probes read them back: one line a form, an operation and
# the kind and mark of each printed operand, with the encoding the form was first seen with and
# the instruction it was seen as. The format is the comment at the head of sass_machine.h.
part sm_86
form IADD register,register,register,register,register 0x0000000700077210 0x004fca0007ffe0ff 0:18-18:2;1:24-27:0;2:32-34:1;3:63-63:-;4:72-72:- ladder.add 0 IADD R1, R0, R7, R0, R0
form IADD register,register,register,register,register,register,register,register 0x0000000700077210 0x004fca0007ffe4ff 0:18-18:2;1:24-27:0;2:32-34:1;3:63-63:-;4:72-72:-;5:75-75:-;6:77-80:-;7:87-90:- ladder.add 0 IADD R1, R0, R7, R0, R0, R0, R15, R15
form IADD register,register,register,register,register,register 0x0000000700077210 0x004fca0007ffe8ff 0:18-18:2;1:24-27:0;2:32-34:1;3:63-63:-;4:72-72:-;5:74-74:- ladder.add 0 IADD R1, R0, R7, R0, R0, R0
form IADD register,register,register 0x0020800700077210 0x004fca0007ffe2ff 0:18-18:2;1:63-63:-;2:72-72:- ladder.add 0 IADD R1, R0, R0
form IADD3 register,register,register,register 0x0020800700077210 0x004fca0007ffe4ff 0:18-18:2;1:63-63:-;2:72-72:-;3:74-74:- ladder.add 0 IADD3 R1, R0, R0, R0
form IADD register,register,register,register 0x0000800700077210 0x004fca0007f7e8ff 0:12-12:2;0:18-18:2;1:63-63:-;2:72-72:-;3:74-74:- ladder.add 0 IADD R1, R0, R0, R0
form S2R register,register 0x0000000000077919 0x000e280000002500 0:18-18:0;1:72-79:- frame.block 0 S2R R1, R37
form S2R register 0x0000000000077919 0x000e240000002100 0:18-18:0 frame.lane 0 S2R R1
form EXIT none 0x000000000000794d 0x000fea0003800000 8:12-15:0;8:87-90:0 frame.exit 0 EXIT
form MOV register,immediate 0x0000002000077802 0x000fe20000000f00 0:18-18:1;1:32-63:0;0:74-74:1 frame.number 0 MOV R1, 0x20
form LD register,address,immediate,register 0x0000000402077981 0x000ea8000c1e9900 0:18-18:2;1:24-31:0;2:42-44:1;2:53-60:1;3:63-67:- frame.load 0 LD R1, [R2.64], 0x0, R0
form ST address,register,immediate 0x0000040704007986 0x000fe8000c101904 8:12-15:-;0:24-31:-;1:32-34:1;2:42-51:0;2:53-60:0 frame.store 0 ST [R4.64], R7, 0x1
