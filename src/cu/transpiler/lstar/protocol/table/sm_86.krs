krs 1
form word_shl to from bits = ISHF {to}, {from}, {bits}\n
form word_shr to from bits = ISHF.U32 {to}, {from}, {bits}\n
form word_add to left right = IADD {to}, {left}, {right}, R0, R0\n
form thread_idx_x to = S2R {to}\n
form block_idx_x to = S2R {to}, R37\n
form word_set to value = MOV {to}, {value}\n
form global_load_constant_word to address offset = LD {to}, [{address}.64], {offset}, R0\n
form record_store_word offset from = ST [R4.64], {from}, {offset}\n
form return = EXIT\n
form exit_if where = @{where} EXIT\n
