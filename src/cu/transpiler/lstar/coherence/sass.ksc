ksc sass
# How this system is asked, and what came back. A probe is not a thing of its own: it is a
# question put on one of the channels below and the answer read back. Written by the interface's
# SASS probe; every line here is something the system said, and nothing here was assumed.

# the channels this system answers on
channel run      the system takes the question as its own code, runs it, and a word comes back
channel decode   the system's disassembler is handed an encoding and names it
channel compile  the system's compiler is handed a source and emits instructions for it
channel clock    two codings of one thing are run against each other and timed

# what an answer can be
class answers  the question was put and the answer came back as the question says
class nothing  the question was taken and left nothing a reader here can see
class illegal  the question was refused: the system will not take it as it stands
class folds    the compiler answered but folded the operand the question varied away, so the answer names a form of its own and not the operator

# every question put, counted by the channel it went out on and what came back
count run      answers  0
count run      nothing  0
count run      illegal  0
count run      folds    0
count decode   answers  0
count decode   nothing  0
count decode   illegal  0
count decode   folds    0
count compile  answers  0
count compile  nothing  0
count compile  illegal  0
count compile  folds    32
count clock    answers  0
count clock    nothing  0
count clock    illegal  0
count clock    folds    0

# every question the system was asked in its own code, one a line: the channel, what came
# back, the word it answered, and the question. These are the ones the system answered for
# itself, with no compiler and no disassembler standing between.
compile folds 00000000 word_mul: the system folds the pow2 put for left
compile folds 00000000 word_set: the system folds the word_used_once put for value
compile folds 00000000 sign_select: the system folds the number put for otherwise
compile folds 00000000 sign_set: the system folds the number put for value
compile folds 00000000 test_sign_ne: the system folds the number put for right
compile folds 00000000 wide_add: the system folds the number put for right
compile folds 00000000 wide_mul: the system folds the number put for right
compile folds 00000000 wide_select: the system folds the number put for otherwise
compile folds 00000000 wide_unpack: the system folds the register put for low
compile folds 00000000 word_copy: the system folds the register put for to
compile folds 00000000 word_mul: the system folds the number put for right
compile folds 00000000 word_set: the system folds the number put for value
compile folds 00000000 word_shl: the system folds the number put for bits
compile folds 00000000 block_dim_x: the system folds the register put for to
compile folds 00000000 global_load_wide: the system folds the offset put for address
compile folds 00000000 global_load_word: the system folds the offset put for address
compile folds 00000000 parameter_load_wide: the system folds the register put for to
compile folds 00000000 parameter_load_word: the system folds the register put for to
compile folds 00000000 test_signed_wide_le: the system folds the complement put for where
compile folds 00000000 test_signed_wide_lt: the system folds the complement put for where
compile folds 00000000 test_signed_word_le: the system folds the complement put for where
compile folds 00000000 test_signed_word_lt: the system folds the complement put for where
compile folds 00000000 test_wide_eq: the system folds the complement put for where
compile folds 00000000 test_wide_le: the system folds the complement put for where
compile folds 00000000 test_wide_lt: the system folds the complement put for where
compile folds 00000000 test_wide_zero: the system folds the complement put for where
compile folds 00000000 test_word_eq: the system folds the complement put for where
compile folds 00000000 test_word_le: the system folds the complement put for where
compile folds 00000000 test_word_lt: the system folds the complement put for where
compile folds 00000000 test_word_zero: the system folds the complement put for where
compile folds 00000000 wide_from_signed_word: the system folds the register put for from
compile folds 00000000 wide_from_word: the system folds the register put for from

# writings the system answers alike: an operation written where the ruleset holds the other, each
# giving the same machine code. A reading in one is the ruleset's form in the other.
equal mul.lo.u32 mul.lo.s32

# forms the system folds into one instruction of its own, as the ruleset beside this file reads
# them after its own lines and its part's.
form word_mul_add to left right added = \tIMAD \t{to}, {left}, {right}, {added};\n
form test_wide_lt_and where left right also = \tISETP.LT.U32.AND \t{predicate:0}, PT, {left}, {right}, PT;\n\tISETP.LT.U32.AND.EX \t{where}, PT, {left}.hi, {right}.hi, {also}, {predicate:0};\n
form test_word_nonzero_and where value also = \tISETP.NE.AND \t{where}, PT, {value}, RZ, {also};\n
form test_word_nonzero_or where value also = \tISETP.NE.OR \t{where}, PT, {value}, RZ, {also};\n
form test_wide_nonzero_and where value also = \tISETP.NE.U32.AND \t{predicate:0}, PT, {value}, RZ, PT;\n\tISETP.NE.AND.EX \t{where}, PT, {value}.hi, RZ, {also}, {predicate:0};\n
form test_wide_nonzero_or where value also = \tISETP.NE.U32.AND \t{predicate:0}, PT, {value}, RZ, PT;\n\tISETP.NE.OR.EX \t{where}, PT, {value}.hi, RZ, {also}, {predicate:0};\n
form block_idx_y to = \tS2UR \tUR6, SR_CTAID.Y;\n\tMOV \t{to}, UR6;\n
form block_idx_z to = \tS2UR \tUR6, SR_CTAID.Z;\n\tMOV \t{to}, UR6;\n
form wide_mul_word_add to left right added = \tIMAD.WIDE.U32 \t{to}, {left}, {right}, {added};\n
