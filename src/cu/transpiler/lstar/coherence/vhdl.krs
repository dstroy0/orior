krs 1
# VHDL-2008, a language of the register lane (code_generator.h), which GHDL analyzes and runs. The format is the comment at
# the head of ptx.krs. The lane is one clocked process in the entity cycle_lane_unit, cut into states a clock each by
# the state forms at the end of this file: its registers are the process's variables, a word unsigned(31 downto 0)
# and a wide word unsigned(63 downto 0), its predicates booleans, and its carry a variable the chains set and read, as
# PTX's carry flag is set and read. Memory is one array of words the process holds, the launch laid in it as the
# device lays CycleCompiledLaunch, with one write site and one read site so a part can hold it as a RAM: the bottom of
# each clock writes the one word a state names, then reads the word asked for and the one after it into the registers
# the next clock takes them from: each read is a registered read, as a block RAM reads. While
# idle, the unit's ports load it and read it back. The text holds its own conversions (word_of, wide_of, signed_of,
# word_index) in the package cycle_program; the file needs no package but ieee's. A word's value is the bank
# immediate, a 32-bit literal; a count, an offset or a shift is a VHDL integer. How much one state holds is the
# target's construction set's and the refinement loop's, not this file's. Around the lane, the entity
# cycle_program_unit (program_unit, at the end of this file) runs a launch's lanes as the kernel written by ptx.krs and c.krs does,
# and the two are the whole circuit.
ruleset vhdl
toolchain ghdl
header lane_open
write_ports 1

# the lane's registers
bank file = v({n})
bank sign = g({n})
bank out = o({n})
bank atom = a({n})
bank temporary = t({n})
bank wide = w({n})
bank predicate = p({n})
bank member = member({n})
# a word's value written into a form, a 32-bit literal: VHDL's integer holds only +-(2^31 - 1), and a word is a
# vector of its own width
bank immediate = unsigned'(32D"{n}")
fixed zero = zero
fixed lane_number = lane_number
fixed record = record_address
fixed index = index_address
fixed body = body_number
fixed bodies = bodies
fixed tables = tables
fixed threads = threads
fixed sign_base = sign_base
fixed indexed = indexed
fixed one = one
fixed ok = ok

# the program's text around the lane
form program_note steps major minor compiler_major compiler_minor block = -- a record program of {steps} steps, as VHDL-2008\n
form lane_open = \nlibrary ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\npackage cycle_program is\n    subtype cycle_word is unsigned(31 downto 0);\n    subtype cycle_wide is unsigned(63 downto 0);\n    type cycle_memory is array (natural range <>) of cycle_word;\n    type cycle_words is array (natural range <>) of cycle_word;\n    type cycle_wides is array (natural range <>) of cycle_wide;\n    type cycle_predicates is array (natural range <>) of boolean;\n\n    function word_of(value : integer) return cycle_word;\n    function word_of(value : unsigned) return cycle_word;\n    function wide_of(value : integer) return cycle_wide;\n    function wide_of(value : unsigned) return cycle_wide;\n    function signed_of(value : cycle_word) return integer;\n    function word_index(address : cycle_wide) return natural;\nend package cycle_program;\n\npackage body cycle_program is\n\n    function word_of(value : integer) return cycle_word is\n    begin\n        return unsigned(to_signed(value, 32));\n    end function word_of;\n\n    function word_of(value : unsigned) return cycle_word is\n    begin\n        return resize(value, 32);\n    end function word_of;\n\n    function wide_of(value : integer) return cycle_wide is\n    begin\n        return unsigned(to_signed(value, 64));\n    end function wide_of;\n\n    function wide_of(value : unsigned) return cycle_wide is\n    begin\n        return resize(value, 64);\n    end function wide_of;\n\n    function signed_of(value : cycle_word) return integer is\n    begin\n        return to_integer(signed(value));\n    end function signed_of;\n\n    function word_index(address : cycle_wide) return natural is\n    begin\n        return to_integer(address(31 downto 2));\n    end function word_index;\n\nend package body cycle_program;\n\nlibrary ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse work.cycle_program.all;\n\n-- one lane at a time. While idle, a clock with load at 1 writes load_word at load_at, and each clock reads the word at\n-- read_at into read_word; start begins lane lane_given of the launch at launch_given, which holds both until idle is 1\n-- again\nentity cycle_lane_unit is\n    generic (words : positive);\n    port (clock : in std_ulogic;\n          start : in std_ulogic;\n          launch_given : in cycle_wide;\n          lane_given : in cycle_wide;\n          load : in std_ulogic;\n          load_at : in natural range 0 to words - 1;\n          load_word : in cycle_word;\n          read_at : in natural range 0 to words - 1;\n          read_word : out cycle_word;\n          idle : out std_ulogic);\nend entity cycle_lane_unit;\n\narchitecture lane of cycle_lane_unit is\nbegin\n    run : process (clock)\n        variable memory : cycle_memory(0 to words);\n        variable asked : natural range 0 to words - 1;\n        variable low_word, high_word : cycle_word;\n        variable write_at : natural range 0 to words;\n        variable write_word : cycle_word;\n        variable writing : boolean;\n        variable error : integer;\n        variable carry : natural range 0 to 1;\n        variable total : unsigned(32 downto 0);\n        variable product : unsigned(63 downto 0);\n
form lane_body =     begin\n        if rising_edge(clock) then\n            case state is\n                when 0 =>\n                    write_at := load_at;\n                    write_word := load_word;\n                    writing := load = '1';\n                    read_word <= low_word;\n                    asked := read_at;\n
form lane_close =                 when others =>\n                    state := 0;\n            end case;\n            if writing then\n                memory(write_at) := write_word;\n                writing := false;\n            end if;\n            low_word := memory(asked);\n            high_word := memory(asked + 1);\n            if state = 0 then\n                idle <= '1';\n            else\n                idle <= '0';\n            end if;\n        end if;\n    end process run;\nend architecture lane;\n

# the lane's declarations
form declare_predicates count =         variable p : cycle_predicates(0 to {count} - 1);\n
form declare_fixed_predicates =         variable indexed, one, ok : boolean;\n
form declare_file count =         variable v : cycle_words(0 to {count} - 1);\n
form declare_signs count =         variable g : cycle_words(0 to {count} - 1);\n
form declare_out count =         variable o : cycle_words(0 to {count} - 1);\n
form declare_atoms count =         variable a : cycle_words(0 to {count} - 1);\n
form declare_temporaries count =         variable t : cycle_words(0 to {count} - 1);\n
form declare_wides count =         variable w : cycle_wides(0 to {count} - 1);\n
form declare_fixed_words =         variable zero, thread, threads, sign_base : cycle_word;\n
form declare_fixed_wides =         variable launch, lane_number, record_address, index_address, body_number, bodies, tables : cycle_wide;\n
form declare_members count =         variable member : cycle_wides(0 to {count} - 1);\n

# the lane's opening and close: an error sets error to its step (-1 at the open) and ends its state, which then
# goes to the dispatch state and on to that error's states; the success path and each error's stores end in
# state_exit, and a label only notes where an error's states begin
form launch_open =             launch := launch_given;\n            lane_number := lane_given;\n            zero := (others => '0');\n
form launch_load_wide to offset =             {to} := high_word & low_word;\n
nop cast_global to
nop shared_open
nop shared_close
form global_load_word_if where to address =             if {where} then\n                {to} := low_word;\n            end if;\n
form wide_from_word_if where to from =             if {where} then\n                {to} := wide_of({from});\n            end if;\n
form error_open_unless where =             if not {where} then\n                error := -1;\n            end if;\n
form error_if where at =             if {where} then\n                error := {at};\n            end if;\n
form label_error_open =             -- errored at the open\n
form label_error at =             -- errored at step {at}\n
form global_add_atomic_word address =             write_at := word_index({address});\n            write_word := low_word + 1;\n            writing := true;\n
nop return
form step_note at operation =             -- step {at}, operation {operation}\n

# carry chains through a register's limbs: alone for a register of one limb, else first, middle and last; the carry is
# a variable each link sets and the next reads, as PTX's carry flag
form word_add to left right =             {to} := word_of({left}) + word_of({right});\n
form word_add_first to left right =             total := resize(word_of({left}), 33) + word_of({right});\n            {to} := total(31 downto 0);\n            carry := to_integer(total(32 downto 32));\n
form word_add_middle to left right =             total := resize(word_of({left}), 33) + word_of({right}) + carry;\n            {to} := total(31 downto 0);\n            carry := to_integer(total(32 downto 32));\n
form word_add_last to left right =             {to} := word_of({left}) + word_of({right}) + carry;\n
form word_sub to left right =             {to} := word_of({left}) - word_of({right});\n
form word_sub_first to left right =             total := resize(word_of({left}), 33) - word_of({right});\n            {to} := total(31 downto 0);\n            carry := to_integer(total(32 downto 32));\n
form word_sub_middle to left right =             total := resize(word_of({left}), 33) - word_of({right}) - carry;\n            {to} := total(31 downto 0);\n            carry := to_integer(total(32 downto 32));\n
form word_sub_last to left right =             {to} := word_of({left}) - word_of({right}) - carry;\n
# the subtract chain whose top limb leaves its borrow for word_borrow_read
form word_borrow_read borrow where =             {borrow} := word_of(0) - carry;\n            {where} := carry /= 0;\n

# a word's arithmetic
form word_copy to from =             {to} := word_of({from});\n
form word_set to value =             {to} := word_of({value});\n
form word_bitand to left right =             {to} := word_of({left}) and word_of({right});\n
form word_bitor to left right =             {to} := word_of({left}) or word_of({right});\n
form word_bitxor to left right =             {to} := word_of({left}) xor word_of({right});\n
err word_not to from
form word_shl to from bits =             {to} := shift_left(word_of({from}), {bits});\n
form word_shr to from bits =             {to} := shift_right(word_of({from}), {bits});\n
form word_funnel_right to low high bits =             {to} := resize(shift_right(word_of({high}) & word_of({low}), {bits}), 32);\n
err signed_word_shr to from bits
form word_mul to left right =             {to} := resize(word_of({left}) * word_of({right}), 32);\n
form word_mul_add to left right added =             {to} := resize(word_of({left}) * word_of({right}) + word_of({added}), 32);\n
form word_div to left right =             {to} := word_of({left}) / word_of({right});\n
form word_select to chosen otherwise where =             if {where} then\n                {to} := word_of({chosen});\n            else\n                {to} := word_of({otherwise});\n            end if;\n
form word_mul_low to left right added =             product := word_of({left}) * word_of({right});\n            total := resize(product(31 downto 0), 33) + word_of({added});\n            {to} := total(31 downto 0);\n            carry := to_integer(total(32 downto 32));\n
form word_mul_high to left right =             product := word_of({left}) * word_of({right});\n            {to} := product(63 downto 32) + carry;\n

# a sign's arithmetic, a signed word of -1, 0 or 1
form sign_set to value =             {to} := word_of({value});\n
form sign_select to chosen otherwise where =             if {where} then\n                {to} := word_of({chosen});\n            else\n                {to} := word_of({otherwise});\n            end if;\n
form sign_mul to left right =             {to} := word_of(signed_of(word_of({left})) * signed_of(word_of({right})));\n
form sign_absolute to from =             {to} := unsigned(abs(signed(word_of({from}))));\n
form sign_neg to from =             {to} := word_of(-signed_of(word_of({from})));\n

# tests, each setting a predicate
form test_word_nonzero where value =             {where} := word_of({value}) /= 0;\n
form test_word_zero where value =             {where} := word_of({value}) = 0;\n
form test_signed_word_negative where value =             {where} := signed_of(word_of({value})) < 0;\n
form test_sign_ne where left right =             {where} := signed_of(word_of({left})) /= signed_of(word_of({right}));\n
form test_sign_gt where left right =             {where} := signed_of(word_of({left})) > signed_of(word_of({right}));\n
form test_wide_nonzero where value =             {where} := wide_of({value}) /= 0;\n
form test_wide_zero where value =             {where} := wide_of({value}) = 0;\n
form test_wide_eq where left right =             {where} := wide_of({left}) = wide_of({right});\n
form test_wide_lt where left right =             {where} := wide_of({left}) < wide_of({right});\n
form test_wide_lt_and where left right also =             {where} := (wide_of({left}) < wide_of({right})) and {also};\n
form test_word_nonzero_and where value also =             {where} := (word_of({value}) /= 0) and {also};\n
form test_word_nonzero_or where value also =             {where} := (word_of({value}) /= 0) or {also};\n
form test_wide_nonzero_and where value also =             {where} := (wide_of({value}) /= 0) and {also};\n
form test_wide_nonzero_or where value also =             {where} := (wide_of({value}) /= 0) or {also};\n
form predicate_bitxor where left right =             {where} := {left} xor {right};\n
form predicate_bitand where left right =             {where} := {left} and {right};\n

# 64-bit words: addresses, the lane's number and a division's parts
form wide_from_word to from =             {to} := wide_of({from});\n
form word_from_wide to from =             {to} := word_of({from});\n
form wide_pack to low high =             {to} := word_of({high}) & word_of({low});\n
form wide_unpack low high from =             {low} := {from}(31 downto 0);\n            {high} := {from}(63 downto 32);\n
form wide_mul to left right =             {to} := resize(wide_of({left}) * wide_of({right}), 64);\n
form wide_mul_word to left right =             {to} := word_of({left}) * word_of({right});\n
form wide_add to left right =             {to} := wide_of({left}) + wide_of({right});\n
form wide_shl to from bits =             {to} := shift_left(wide_of({from}), {bits});\n
form wide_select to chosen otherwise where =             if {where} then\n                {to} := wide_of({chosen});\n            else\n                {to} := wide_of({otherwise});\n            end if;\n
form wide_div to left right =             {to} := wide_of({left}) / wide_of({right});\n

# memory: the members' and the tables' words and the record's words
form global_load_constant_word to address offset =             {to} := low_word;\n
form record_store_word offset from =             write_at := word_index(record_address + {offset});\n            write_word := word_of({from});\n            writing := true;\n

# the states the lane is cut into, a clock each (code_generator.h): state 0 waits to begin, state 1 sends an errored lane
# to its error's states, and the lane's opening begins in the state state_start names. A state goes on to the next
# unless the lane errored in it, and a lane that is done goes back to 0
form declare_states count =         variable state : natural range 0 to {count};\n
form state_start state =                     if start = '1' then\n                        error := -2;\n                        carry := 0;\n                        state := {state};\n                    end if;\n
form state_open state =                 when {state} =>\n
form state_next state error =             if error = -2 then\n                state := {state};\n            else\n                state := {error};\n            end if;\n
form state_exit =             state := 0;\n
form state_dispatch error state =             if error = {error} then\n                state := {state};\n            end if;\n

# memory read by asking: an ask names the word's address and ends its state, and the take in the next state reads
# the word, and the one after it, that the bottom of the asking clock read
form launch_ask offset =             asked := word_index(launch + {offset});\n
form global_ask address offset =             asked := word_index({address} + {offset});\n
form global_ask_if where address =             if {where} then\n                asked := word_index({address});\n            end if;\n
form global_ask_atomic address =             asked := word_index({address});\n

# a loop: its label begins a state, and its branch back ends the state going back to the label's state where the
# predicate holds and on to the next where not
form label_loop loop =             -- loop {loop}\n
nop loop_back_if loop where
form state_loop back where next =             if {where} then\n                state := {back};\n            else\n                state := {next};\n            end if;\n

# the program resident around the lane, as the resident kernel is on NVIDIA: the entity cycle_program_unit,
# which takes the launch, runs its lanes on cycle_lane_unit one at a time from the hot word's next lane to the
# launch's count, holds each to the program block's owner and command, and writes where the program stands as it
# leaves. It and the lane unit are the whole circuit a part is built from; the bench only loads it, starts it and
# reads it back. The offsets are bytes, of the launch, its hot words and its block, and the commands and states the
# engine's (engine_config.h), as the code generator gives them
form program_unit launch_bytes count_offset hot_offset block_offset number_offset ttl_offset checkin_every_offset next_offset start_offset finished_offset checkins_offset owner_at command_at state_at offset_at step_at launch_time_at exectime_at checkin_at checkin_time_at run_command stop_command done_state stopped_state yielded_state = \nlibrary ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse work.cycle_program.all;\n\n-- the program resident, as the resident kernel is on NVIDIA. A clock with run at 1 begins the launch at\n-- launch_given, which holds until done is 1 again, and the unit runs its lanes on the lane unit one at a time, from\n-- the hot word next_lane to the launch's count, each to the lane unit's idle. Before each lane it reads the program's\n-- block, and leaves where the block's owner is not this launch, writing nothing, or where its command is not run. A\n-- launch that owns the block leaves by writing where the program stands: the next lane to the hot word and to the\n-- block's offset, 0 to the block's step, and the block's state last, done, stopped or yielded. The block's times and\n-- check-ins, which the device's timer gives on NVIDIA, are not kept: the unit reads no timer. While done is 1 the\n-- unit's ports load the memory and read it back, as the lane unit's do while it is idle\nentity cycle_program_unit is\n    generic (words : positive);\n    port (clock : in std_ulogic;\n          run : in std_ulogic;\n          launch_given : in cycle_wide;\n          load : in std_ulogic;\n          load_at : in natural range 0 to words - 1;\n          load_word : in cycle_word;\n          read_at : in natural range 0 to words - 1;\n          read_word : out cycle_word;\n          done : out std_ulogic);\nend entity cycle_program_unit;\n\narchitecture resident of cycle_program_unit is\n    type cycle_phase is (waiting, asking, taking, count_low, count_high, hot_low, hot_high, next_low, next_high,\n                         block_low, block_high, number_low, number_high, checking, owner_low, owner_high,\n                         command_low, command_high, choosing, starting, started, running, finishing, leaving);\n    signal resting : std_ulogic := '1';\n    signal owning : std_ulogic := '0';\n    signal start : std_ulogic := '0';\n    signal lane_given : cycle_wide := (others => '0');\n    signal own_load : std_ulogic := '0';\n    signal own_load_at : natural range 0 to words - 1 := 0;\n    signal own_load_word : cycle_word := (others => '0');\n    signal own_read_at : natural range 0 to words - 1 := 0;\n    signal unit_load : std_ulogic;\n    signal unit_load_at : natural range 0 to words - 1;\n    signal unit_load_word : cycle_word;\n    signal unit_read_at : natural range 0 to words - 1;\n    signal unit_read_word : cycle_word;\n    signal idle : std_ulogic;\nbegin\n    -- the lane unit's ports are the unit's own while it runs a launch, and the caller's while it rests\n    unit_load <= own_load when owning = '1' else load;\n    unit_load_at <= own_load_at when owning = '1' else load_at;\n    unit_load_word <= own_load_word when owning = '1' else load_word;\n    unit_read_at <= own_read_at when owning = '1' else read_at;\n    read_word <= unit_read_word;\n    done <= resting;\n\n    lanes : entity work.cycle_lane_unit\n        generic map (words => words)\n        port map (clock => clock, start => start, launch_given => launch_given, lane_given => lane_given,\n                  load => unit_load, load_at => unit_load_at, load_word => unit_load_word, read_at => unit_read_at,\n                  read_word => unit_read_word, idle => idle);\n\n    -- a word is read by asking: its address goes to the lane unit, which reads it at the next clock and gives it the\n    -- clock after: the word is taken three clocks after the ask; each phase named for a word takes it, and asks the\n    -- next\n    order : process (clock)\n        variable phase : cycle_phase := waiting;\n        variable following : cycle_phase := waiting;\n        variable address : cycle_wide := (others => '0');\n        variable taken : cycle_word := (others => '0');\n        variable pause : natural range 0 to 2 := 0;\n        variable count, hot, program_block, number, owner, command, lane : cycle_wide := (others => '0');\n        variable standing : cycle_word := (others => '0');\n        variable written : natural range 0 to 7 := 0;\n    begin\n        if rising_edge(clock) then\n            case phase is\n                when waiting =>\n                    if run = '1' then\n                        resting <= '0';\n                        owning <= '1';\n                        address := launch_given + {count_offset};\n                        following := count_low;\n                        phase := asking;\n                    end if;\n                when asking =>\n                    own_read_at <= word_index(address);\n                    pause := 2;\n                    phase := taking;\n                when taking =>\n                    if pause = 0 then\n                        taken := unit_read_word;\n                        phase := following;\n                    else\n                        pause := pause - 1;\n                    end if;\n                when count_low =>\n                    count(31 downto 0) := taken;\n                    address := launch_given + {count_offset} + 4;\n                    following := count_high;\n                    phase := asking;\n                when count_high =>\n                    count(63 downto 32) := taken;\n                    address := launch_given + {hot_offset};\n                    following := hot_low;\n                    phase := asking;\n                when hot_low =>\n                    hot(31 downto 0) := taken;\n                    address := launch_given + {hot_offset} + 4;\n                    following := hot_high;\n                    phase := asking;\n                when hot_high =>\n                    hot(63 downto 32) := taken;\n                    address := hot + {next_offset};\n                    following := next_low;\n                    phase := asking;\n                when next_low =>\n                    lane(31 downto 0) := taken;\n                    address := hot + {next_offset} + 4;\n                    following := next_high;\n                    phase := asking;\n                when next_high =>\n                    lane(63 downto 32) := taken;\n                    address := launch_given + {block_offset};\n                    following := block_low;\n                    phase := asking;\n                when block_low =>\n                    program_block(31 downto 0) := taken;\n                    address := launch_given + {block_offset} + 4;\n                    following := block_high;\n                    phase := asking;\n                when block_high =>\n                    program_block(63 downto 32) := taken;\n                    address := launch_given + {number_offset};\n                    following := number_low;\n                    phase := asking;\n                when number_low =>\n                    number(31 downto 0) := taken;\n                    address := launch_given + {number_offset} + 4;\n                    following := number_high;\n                    phase := asking;\n                when number_high =>\n                    number(63 downto 32) := taken;\n                    phase := checking;\n                when checking =>\n                    address := program_block + {owner_at};\n                    following := owner_low;\n                    phase := asking;\n                when owner_low =>\n                    owner(31 downto 0) := taken;\n                    address := program_block + {owner_at} + 4;\n                    following := owner_high;\n                    phase := asking;\n                when owner_high =>\n                    owner(63 downto 32) := taken;\n                    address := program_block + {command_at};\n                    following := command_low;\n                    phase := asking;\n                when command_low =>\n                    command(31 downto 0) := taken;\n                    address := program_block + {command_at} + 4;\n                    following := command_high;\n                    phase := asking;\n                when command_high =>\n                    command(63 downto 32) := taken;\n                    phase := choosing;\n                when choosing =>\n                    if lane >= count then\n                        standing := word_of({done_state});\n                    elsif command = {stop_command} then\n                        standing := word_of({stopped_state});\n                    else\n                        standing := word_of({yielded_state});\n                    end if;\n                    if owner /= number then\n                        phase := leaving;\n                    elsif (command /= {run_command}) or (lane >= count) then\n                        written := 0;\n                        phase := finishing;\n                    else\n                        phase := starting;\n                    end if;\n                when starting =>\n                    start <= '1';\n                    lane_given <= lane;\n                    phase := started;\n                when started =>\n                    -- the lane unit took start at this clock and is not idle from it on\n                    start <= '0';\n                    phase := running;\n                when running =>\n                    if idle = '1' then\n                        lane := lane + 1;\n                        phase := checking;\n                    end if;\n                when finishing =>\n                    own_load <= '1';\n                    case written is\n                        when 0 =>\n                            own_load_at <= word_index(hot + {next_offset});\n                            own_load_word <= lane(31 downto 0);\n                        when 1 =>\n                            own_load_at <= word_index(hot + {next_offset}) + 1;\n                            own_load_word <= lane(63 downto 32);\n                        when 2 =>\n                            own_load_at <= word_index(program_block + {offset_at});\n                            own_load_word <= lane(31 downto 0);\n                        when 3 =>\n                            own_load_at <= word_index(program_block + {offset_at}) + 1;\n                            own_load_word <= lane(63 downto 32);\n                        when 4 =>\n                            own_load_at <= word_index(program_block + {step_at});\n                            own_load_word <= (others => '0');\n                        when 5 =>\n                            own_load_at <= word_index(program_block + {step_at}) + 1;\n                            own_load_word <= (others => '0');\n                        when 6 =>\n                            own_load_at <= word_index(program_block + {state_at}) + 1;\n                            own_load_word <= (others => '0');\n                        when others =>\n                            own_load_at <= word_index(program_block + {state_at});\n                            own_load_word <= standing;\n                    end case;\n                    if written = 7 then\n                        phase := leaving;\n                    else\n                        written := written + 1;\n                    end if;\n                when leaving =>\n                    own_load <= '0';\n                    owning <= '0';\n                    resting <= '1';\n                    phase := waiting;\n            end case;\n        end if;\n    end process order;\nend architecture resident;\n

# a kernel of its own, which this language does not write
