krs 1
# NVIDIA PTX, the record machine's first target. A line is one entry and its first word the entry's kind:
#   ruleset <name>                     the target this file describes
#   toolchain <name>                   what turns the text into a program the target loads
#   header <name>                      where the text's opening lines come from
#   shared 1                           the lane holds the file and its signs in the thread block's shared memory
#   write_ports <count>                the memory writes the text makes in one state, unbounded where not given
#   part <name>                        the part whose <name>.krs and <name>.kdm are read after this file
#   bank <name> = <text>               a bank of registers, {n} the register's number in it
#   fixed <name> = <text>              one register every lane holds throughout
#   form <name> <parameter>... = <text>
#   construct <name> <parameter>...    a form built from more basic ones, its lines to `end`, each a form or a
#                                      construct and its arguments
# A form's text is the rest of its line after "= ", byte for byte, where \t is a tab, \n a line's end and \\ a
# backslash, and {p} is parameter p's argument; a brace that does not close a parameter's name is itself. A line that
# begins with # is a comment, and a blank line is nothing.
ruleset ptx
toolchain nvjitlink
header probe_nvrtc

# the lane's registers
bank file = %v{n}
bank sign = %g{n}
bank out = %o{n}
bank atom = %a{n}
bank temporary = %t{n}
bank wide = %w{n}
bank predicate = %p{n}
bank member = %member{n}
# a word's value written into a form, a PTX immediate
bank immediate = {n}
fixed zero = %zero
fixed lane_number = %lane_number
fixed record = %record
fixed index = %index
fixed body = %body
fixed bodies = %bodies
fixed tables = %tables
fixed threads = %threads
fixed sign_base = %sign_base
fixed indexed = %indexed
fixed one = %one
fixed ok = %ok
fixed launch = %launch

# the program's text around the lane
form program_note steps major minor compiler_major compiler_minor block = // a record program of {steps} steps, for sm_{major}{minor}, NVRTC {compiler_major}.{compiler_minor}, as PTX for the target {block}\n
form lane_open = \n.visible .func cycle_lane(\n\t.param .b64 cycle_lane_param_0,\n\t.param .b64 cycle_lane_param_1\n)\n{\n
form lane_body = \n
form lane_close = }\n

# the lane's declarations
form declare_predicates count = \t.reg .pred \t%p<{count}>;\n
form declare_fixed_predicates = \t.reg .pred \t%indexed, %one, %ok;\n
form declare_file count = \t.reg .b32 \t%v<{count}>;\n
form declare_signs count = \t.reg .b32 \t%g<{count}>;\n
form declare_out count = \t.reg .b32 \t%o<{count}>;\n
form declare_atoms count = \t.reg .b32 \t%a<{count}>;\n
form declare_temporaries count = \t.reg .b32 \t%t<{count}>;\n
form declare_wides count = \t.reg .b64 \t%w<{count}>;\n
form declare_fixed_words = \t.reg .b32 \t%zero, %thread, %threads, %word_base, %word_stride, %sign_base;\n
form declare_fixed_wides = \t.reg .b64 \t%launch, %lane_number, %record, %index, %body, %bodies, %tables;\n
form declare_members count = \t.reg .b64 \t%member<{count}>;\n

# the lane's opening and close
form launch_open = \tld.param.u64 \t%launch, [cycle_lane_param_0];\n\tld.param.u64 \t%lane_number, [cycle_lane_param_1];\n\tmov.u32 \t%zero, 0;\n
form launch_load_wide to offset = \tld.u64 \t{to}, [%launch+{offset}];\n
form cast_global to = \tcvta.to.global.u64 \t{to}, {to};\n
form shared_open = \tmov.u32 \t%thread, %tid.x;\n\tmov.u32 \t%threads, %ntid.x;\n\tmov.u32 \t%word_base, cycle_words;\n\tadd.u32 \t%sign_base, %word_base, %thread;\n
form shared_close = \tmad.lo.u32 \t%word_base, %thread, 4, %word_base;\n\tshl.b32 \t%word_stride, %threads, 2;\n
form global_load_word_if where to address = \t@{where} ld.global.nc.u32 \t{to}, [{address}];\n
form wide_from_word_if where to from = \t@{where} cvt.u64.u32 \t{to}, {from};\n
form error_open_unless where = \t@!{where} bra \t$Lerror_open;\n
form error_if where at = \t@{where} bra \t$Lerror{at};\n
form label_error_open = $Lerror_open:\n
form label_error at = $Lerror{at}:\n
form global_add_atomic_word address = \tred.global.add.u32 \t[{address}], 1;\n
form return = \tret;\n
form step_note at operation = \t// step {at}, operation {operation}\n

# carry chains through a register's limbs: alone for a register of one limb, else first, middle and last
form word_add to left right = \tadd.u32 \t{to}, {left}, {right};\n
form word_add_first to left right = \tadd.cc.u32 \t{to}, {left}, {right};\n
form word_add_middle to left right = \taddc.cc.u32 \t{to}, {left}, {right};\n
form word_add_last to left right = \taddc.u32 \t{to}, {left}, {right};\n
form word_sub to left right = \tsub.u32 \t{to}, {left}, {right};\n
form word_sub_first to left right = \tsub.cc.u32 \t{to}, {left}, {right};\n
form word_sub_middle to left right = \tsubc.cc.u32 \t{to}, {left}, {right};\n
form word_sub_last to left right = \tsubc.u32 \t{to}, {left}, {right};\n
# the subtract chain whose top limb leaves its borrow for word_borrow_read
form word_borrow_read borrow where = \tsubc.u32 \t{borrow}, %zero, %zero;\n\tsetp.ne.u32 \t{where}, {borrow}, 0;\n

# a word's arithmetic
form word_copy to from = \tmov.b32 \t{to}, {from};\n
form word_set to value = \tmov.u32 \t{to}, {value};\n
form word_bitand to left right = \tand.b32 \t{to}, {left}, {right};\n
form word_bitor to left right = \tor.b32 \t{to}, {right}, {left};\n
form word_bitxor to left right = \txor.b32 \t{to}, {right}, {left};\n
form word_not to from = \tnot.b32 \t{to}, {from};\n
err word_nand to left right
err word_nor to left right
form word_shl to from bits = \tshl.b32 \t{to}, {from}, {bits};\n
form word_shr to from bits = \tshr.u32 \t{to}, {from}, {bits};\n
form word_funnel_right to low high bits = \tshf.r.clamp.b32 \t{to}, {low}, {high}, {bits};\n
form signed_word_shr to from bits = \tshr.s32 \t{to}, {from}, {bits};\n
err word_rol to from bits
err word_ror to from bits
form word_mul to left right = \tmul.lo.u32 \t{to}, {left}, {right};\n
form word_mul_add to left right added = \tmad.lo.s32 \t{to}, {left}, {right}, {added};\n
form word_div to left right = \tdiv.u32 \t{to}, {left}, {right};\n
form word_select to chosen otherwise where = \tselp.b32 \t{to}, {chosen}, {otherwise}, {where};\n
form word_mul_low to left right added = \tmad.lo.cc.u32 \t{to}, {left}, {right}, {added};\n
form word_mul_high to left right = \tmadc.hi.u32 \t{to}, {left}, {right}, %zero;\n

# a sign's arithmetic, a signed word of -1, 0 or 1
form sign_set to value = \tmov.s32 \t{to}, {value};\n
form sign_select to chosen otherwise where = \tselp.s32 \t{to}, {chosen}, {otherwise}, {where};\n
form sign_mul to left right = \tmul.lo.s32 \t{to}, {left}, {right};\n
form sign_absolute to from = \tabs.s32 \t{to}, {from};\n
form sign_neg to from = \tneg.s32 \t{to}, {from};\n

# tests, each setting a predicate
form test_word_nonzero where value = \tsetp.ne.s32 \t{where}, {value}, 0;\n
form test_word_zero where value = \tsetp.eq.s32 \t{where}, {value}, 0;\n
form test_signed_word_negative where value = \tsetp.lt.s32 \t{where}, {value}, 0;\n
form test_sign_ne where left right = \tsetp.ne.s32 \t{where}, {left}, {right};\n
form test_sign_gt where left right = \tsetp.gt.s32 \t{where}, {left}, {right};\n
form test_wide_nonzero where value = \tsetp.ne.s64 \t{where}, {value}, 0;\n
form test_wide_zero where value = \tsetp.eq.s64 \t{where}, {value}, 0;\n
form test_wide_eq where left right = \tsetp.eq.s64 \t{where}, {left}, {right};\n
form test_wide_lt where left right = \tsetp.lt.u64 \t{where}, {left}, {right};\n
form test_wide_lt_and where left right also = \tsetp.lt.and.u64 \t{where}, {left}, {right}, {also};\n
form test_word_nonzero_and where value also = \tsetp.ne.and.u32 \t{where}, {value}, 0, {also};\n
form test_word_nonzero_or where value also = \tsetp.ne.or.u32 \t{where}, {value}, 0, {also};\n
form test_wide_nonzero_and where value also = \tsetp.ne.and.u64 \t{where}, {value}, 0, {also};\n
form test_wide_nonzero_or where value also = \tsetp.ne.or.u64 \t{where}, {value}, 0, {also};\n
form predicate_bitxor where left right = \txor.pred \t{where}, {left}, {right};\n
form predicate_bitand where left right = \tand.pred \t{where}, {left}, {right};\n

# 64-bit words: addresses, the lane's number and a division's parts
form wide_from_word to from = \tcvt.u64.u32 \t{to}, {from};\n
form word_from_wide to from = \tcvt.u32.u64 \t{to}, {from};\n
form wide_pack to low high = \tmov.b64 \t{to}, {{low}, {high}};\n
form wide_unpack low high from = \tmov.b64 \t{{low}, {high}}, {from};\n
form wide_mul to left right = \tmul.lo.u64 \t{to}, {left}, {right};\n
form wide_mul_word to left right = \tmul.wide.u32 \t{to}, {left}, {right};\n
form wide_add to left right = \tadd.s64 \t{to}, {left}, {right};\n
form wide_shl to from bits = \tshl.b64 \t{to}, {from}, {bits};\n
form wide_select to chosen otherwise where = \tselp.b64 \t{to}, {chosen}, {otherwise}, {where};\n
form wide_div to left right = \tdiv.u64 \t{to}, {left}, {right};\n

# memory: the members' and the tables' words and the record's words
form global_load_constant_word to address offset = \tld.global.nc.u32 \t{to}, [{address}+{offset}];\n
form record_store_word offset from = \tst.global.u32 \t[%record+{offset}], {from};\n

# the states a target that clocks the lane a state at a time cuts it into (vhdl.krs); a PTX lane runs straight
# through, and has none
nop declare_states count
nop state_start state
nop state_open state
nop state_next state error
nop state_exit
nop state_dispatch error state

# a memory read's address named a state ahead of the read, for a target that reads memory a clock after it is asked
# (vhdl.krs); a PTX load names its address itself
nop launch_ask offset
nop global_ask address offset
nop global_ask_if where address
nop global_ask_atomic address

# a loop: its label, and the branch back to it where the predicate holds; a PTX lane branches, and a target that cuts
# the lane into states goes back a state (state_loop, which PTX has none of)
form label_loop loop = $Lloop{loop}:\n
form loop_back_if loop where = \t@{where} bra \t$Lloop{loop};\n
nop state_loop back where next

# the program resident around the lane: the kernel the record machine launches, which takes the launch's lanes a round
# a thread block and holds the program to its block (vhdl.krs writes the same resident as a circuit)
form program_unit launch_bytes count_offset hot_offset block_offset number_offset ttl_offset checkin_every_offset next_offset start_offset finished_offset checkins_offset owner_at command_at state_at offset_at step_at launch_time_at exectime_at checkin_at checkin_time_at run_command stop_command done_state stopped_state yielded_state = \n// The program resident, the lane's own: each thread block takes the next round of lanes from the hot word next_lane,\n// and before each round its first thread reads the device's timer. Past the launch's time to live, or told by the\n// block's command, the thread block leaves without taking more; every so often it checks in to the block. The thread\n// block that opens the launch runs one round before the timer can send it out. A launch that does not find its number\n// as the block's owner leaves at once and writes nothing. The last thread block out writes where the program stands,\n// its state last. Each thread copies the launch to its local memory, where the lane reads it through a generic address\n.shared .align 8 .u64 \tcycle_claimed;\n\n.visible .entry cycle_program(\n\t.param .align 8 .b8 cycle_program_param_0[{launch_bytes}]\n)\n.maxntid 256, 1, 1\n{\n\t.local .align 8 .b8 \tcycle_launch_copy[{launch_bytes}];\n\t.reg .pred \t%k_first_thread, %k_opened, %k_going, %k_leave, %k_early, %k_owned, %k_other, %k_not, %k_past, %k_last, %k_done, %k_stopping, %k_copying;\n\t.reg .b32 \t%k_thread, %k_width, %k_grid;\n\t.reg .b64 \t%k_param, %k_copy, %k_moved, %k_word, %k_at, %k_launch, %k_hot, %k_block, %k_count, %k_ttl, %k_every, %k_number;\n\t.reg .b64 \t%k_now, %k_checked, %k_rounds, %k_start, %k_ran, %k_owner, %k_command, %k_next, %k_checkin, %k_claimed;\n\t.reg .b64 \t%k_first, %k_lane, %k_threads, %k_finished, %k_blocks, %k_state, %k_old, %k_zero;\n\n\tmov.u64 \t%k_param, cycle_program_param_0;\n\tmov.u64 \t%k_copy, cycle_launch_copy;\n\tmov.u64 \t%k_moved, 0;\n$Lcopy:\n\tadd.u64 \t%k_at, %k_param, %k_moved;\n\tld.param.u64 \t%k_word, [%k_at];\n\tadd.u64 \t%k_at, %k_copy, %k_moved;\n\tst.local.u64 \t[%k_at], %k_word;\n\tadd.u64 \t%k_moved, %k_moved, 8;\n\tsetp.lt.u64 \t%k_copying, %k_moved, {launch_bytes};\n\t@%k_copying bra \t$Lcopy;\n\tcvta.local.u64 \t%k_launch, %k_copy;\n\tld.param.u64 \t%k_count, [cycle_program_param_0+{count_offset}];\n\tld.param.u64 \t%k_hot, [cycle_program_param_0+{hot_offset}];\n\tcvta.to.global.u64 \t%k_hot, %k_hot;\n\tld.param.u64 \t%k_block, [cycle_program_param_0+{block_offset}];\n\tcvta.to.global.u64 \t%k_block, %k_block;\n\tld.param.u64 \t%k_ttl, [cycle_program_param_0+{ttl_offset}];\n\tld.param.u64 \t%k_every, [cycle_program_param_0+{checkin_every_offset}];\n\tld.param.u64 \t%k_number, [cycle_program_param_0+{number_offset}];\n\tmov.u32 \t%k_thread, %tid.x;\n\tmov.u32 \t%k_width, %ntid.x;\n\tcvt.u64.u32 \t%k_threads, %k_width;\n\tmov.u64 \t%k_zero, 0;\n\tmov.u64 \t%k_checked, 0;\n\tmov.u64 \t%k_rounds, 0;\n\tsetp.eq.u32 \t%k_first_thread, %k_thread, 0;\n\tsetp.ne.u32 \t%k_opened, %k_thread, %k_thread;\n\t@!%k_first_thread bra \t$Lround;\n\tmov.u64 \t%k_now, %globaltimer;\n\tatom.global.cas.b64 \t%k_old, [%k_hot+{start_offset}], %k_zero, %k_now;\n\tsetp.eq.u64 \t%k_opened, %k_old, 0;\n$Lround:\n\t@!%k_first_thread bra \t$Lwait;\n\tmov.u64 \t%k_now, %globaltimer;\n\tld.volatile.global.u64 \t%k_start, [%k_hot+{start_offset}];\n\tsub.u64 \t%k_ran, %k_now, %k_start;\n\tsetp.ne.u64 \t%k_going, %k_rounds, 0;\n\tnot.pred \t%k_not, %k_opened;\n\tor.pred \t%k_going, %k_going, %k_not;\n\tsetp.ge.u64 \t%k_leave, %k_ran, %k_ttl;\n\tand.pred \t%k_leave, %k_leave, %k_going;\n\tsub.u64 \t%k_word, %k_now, %k_checked;\n\tsetp.lt.u64 \t%k_early, %k_word, %k_every;\n\t@%k_early bra \t$Lclaim;\n\tmov.u64 \t%k_checked, %k_now;\n\tld.volatile.global.u64 \t%k_owner, [%k_block+{owner_at}];\n\tsetp.eq.u64 \t%k_owned, %k_owner, %k_number;\n\tld.volatile.global.u64 \t%k_command, [%k_block+{command_at}];\n\tsetp.ne.u64 \t%k_other, %k_command, {run_command};\n\tor.pred \t%k_leave, %k_leave, %k_other;\n\tnot.pred \t%k_not, %k_owned;\n\tor.pred \t%k_leave, %k_leave, %k_not;\n\t@!%k_owned bra \t$Lclaim;\n\tld.volatile.global.u64 \t%k_next, [%k_hot+{next_offset}];\n\tatom.global.add.u64 \t%k_checkin, [%k_hot+{checkins_offset}], 1;\n\tadd.u64 \t%k_checkin, %k_checkin, 1;\n\tst.volatile.global.u64 \t[%k_block+{checkin_at}], %k_checkin;\n\tst.volatile.global.u64 \t[%k_block+{checkin_time_at}], %k_now;\n\tmin.u64 \t%k_next, %k_next, %k_count;\n\tst.volatile.global.u64 \t[%k_block+{offset_at}], %k_next;\n$Lclaim:\n\tmov.u64 \t%k_claimed, %k_count;\n\t@%k_leave bra \t$Lclaimed;\n\tatom.global.add.u64 \t%k_claimed, [%k_hot+{next_offset}], %k_threads;\n$Lclaimed:\n\tst.shared.u64 \t[cycle_claimed], %k_claimed;\n\tadd.u64 \t%k_rounds, %k_rounds, 1;\n$Lwait:\n\tbar.sync \t0;\n\tld.shared.u64 \t%k_first, [cycle_claimed];\n\tbar.sync \t0;\n\tsetp.ge.u64 \t%k_done, %k_first, %k_count;\n\t@%k_done bra \t$Lout;\n\tcvt.u64.u32 \t%k_lane, %k_thread;\n\tadd.u64 \t%k_lane, %k_first, %k_lane;\n\tsetp.ge.u64 \t%k_past, %k_lane, %k_count;\n\t@%k_past bra \t$Lround;\n\t{\n\t.param .b64 cycle_lane_launch;\n\tst.param.b64 \t[cycle_lane_launch], %k_launch;\n\t.param .b64 cycle_lane_number;\n\tst.param.b64 \t[cycle_lane_number], %k_lane;\n\tcall \tcycle_lane, (cycle_lane_launch, cycle_lane_number);\n\t}\n\tbra \t$Lround;\n$Lout:\n\t@!%k_first_thread bra \t$Lend;\n\tmembar.gl;\n\tatom.global.add.u64 \t%k_finished, [%k_hot+{finished_offset}], 1;\n\tmov.u32 \t%k_grid, %nctaid.x;\n\tcvt.u64.u32 \t%k_blocks, %k_grid;\n\tsub.u64 \t%k_blocks, %k_blocks, 1;\n\tsetp.ne.u64 \t%k_last, %k_finished, %k_blocks;\n\t@%k_last bra \t$Lend;\n\tmov.u64 \t%k_now, %globaltimer;\n\tld.volatile.global.u64 \t%k_next, [%k_hot+{next_offset}];\n\tld.volatile.global.u64 \t%k_start, [%k_hot+{start_offset}];\n\tld.volatile.global.u64 \t%k_owner, [%k_block+{owner_at}];\n\tsetp.ne.u64 \t%k_last, %k_owner, %k_number;\n\t@%k_last bra \t$Lend;\n\tld.volatile.global.u64 \t%k_command, [%k_block+{command_at}];\n\tmin.u64 \t%k_word, %k_next, %k_count;\n\tst.volatile.global.u64 \t[%k_block+{offset_at}], %k_word;\n\tst.volatile.global.u64 \t[%k_block+{step_at}], %k_zero;\n\tst.volatile.global.u64 \t[%k_block+{launch_time_at}], %k_start;\n\tsub.u64 \t%k_word, %k_now, %k_start;\n\tst.volatile.global.u64 \t[%k_block+{exectime_at}], %k_word;\n\tatom.global.add.u64 \t%k_checkin, [%k_hot+{checkins_offset}], 1;\n\tadd.u64 \t%k_checkin, %k_checkin, 1;\n\tst.volatile.global.u64 \t[%k_block+{checkin_at}], %k_checkin;\n\tst.volatile.global.u64 \t[%k_block+{checkin_time_at}], %k_now;\n\tmembar.gl;\n\tsetp.eq.u64 \t%k_stopping, %k_command, {stop_command};\n\tselp.u64 \t%k_state, {stopped_state}, {yielded_state}, %k_stopping;\n\tsetp.ge.u64 \t%k_done, %k_next, %k_count;\n\tselp.u64 \t%k_state, {done_state}, %k_state, %k_done;\n\tst.volatile.global.u64 \t[%k_block+{state_at}], %k_state;\n\tmembar.gl;\n$Lend:\n\tret;\n}\n

# a kernel of its own: the built-in variables as PTX's special registers, a comparison, an exit under a guard, and the
# global memory a pointer parameter reaches. PTX names a kernel's parameters and opens and closes a kernel itself
err kernel_open
err kernel_close
form thread_idx_x to = \tmov.u32 \t{to}, %tid.x;\n
form thread_idx_y to = \tmov.u32 \t{to}, %tid.y;\n
form thread_idx_z to = \tmov.u32 \t{to}, %tid.z;\n
form block_idx_x to = \tmov.u32 \t{to}, %ctaid.x;\n
form block_idx_y to = \tmov.u32 \t{to}, %ctaid.y;\n
form block_idx_z to = \tmov.u32 \t{to}, %ctaid.z;\n
form block_dim_x to = \tmov.u32 \t{to}, %ntid.x;\n
form block_dim_y to = \tmov.u32 \t{to}, %ntid.y;\n
form block_dim_z to = \tmov.u32 \t{to}, %ntid.z;\n
form grid_dim_x to = \tmov.u32 \t{to}, %nctaid.x;\n
form grid_dim_y to = \tmov.u32 \t{to}, %nctaid.y;\n
form grid_dim_z to = \tmov.u32 \t{to}, %nctaid.z;\n
form warp_size to = \tmov.u32 \t{to}, WARP_SZ;\n
err parameter_load_word to offset
err parameter_load_wide to offset
form test_word_lt where left right = \tsetp.lo.u32 \t{where}, {left}, {right};\n
form exit_unless where = \t@!{where} exit;\n
form wide_mul_word_add to left right added = \tmad.wide.u32 \t{to}, {left}, {right}, {added};\n
form global_load_word to address offset = \tld.global.u32 \t{to}, [{address}+{offset}];\n
form global_load_wide to address offset = \tld.global.u64 \t{to}, [{address}+{offset}];\n
form global_load_byte to address offset = \tld.global.u8 \t{to}, [{address}+{offset}];\n
form global_load_signed_byte to address offset = \tld.global.s8 \t{to}, [{address}+{offset}];\n
form global_load_halfword to address offset = \tld.global.u16 \t{to}, [{address}+{offset}];\n
form global_load_signed_halfword to address offset = \tld.global.s16 \t{to}, [{address}+{offset}];\n
form global_store_wide address offset from = \tst.global.u64 \t[{address}+{offset}], {from};\n
form wide_from_signed_word to from = \tcvt.s64.s32 \t{to}, {from};\n
form word_from_byte to from = \tbfe.u32 \t{to}, {from}, 0, 8;\n
form word_from_signed_byte to from = \tbfe.s32 \t{to}, {from}, 0, 8;\n
form word_from_halfword to from = \tbfe.u32 \t{to}, {from}, 0, 16;\n
form word_from_signed_halfword to from = \tbfe.s32 \t{to}, {from}, 0, 16;\n
form test_word_ge where left right = \tsetp.hs.u32 \t{where}, {left}, {right};\n
form exit_if where = \t@{where} exit;\n
form test_word_le where left right = \tsetp.ls.u32 \t{where}, {left}, {right};\n
form test_word_ne where left right = \tsetp.ne.u32 \t{where}, {left}, {right};\n
form test_word_eq where left right = \tsetp.eq.u32 \t{where}, {left}, {right};\n
form test_word_gt where left right = \tsetp.hi.u32 \t{where}, {left}, {right};\n
form test_signed_word_lt where left right = \tsetp.lt.s32 \t{where}, {left}, {right};\n
form test_signed_word_ge where left right = \tsetp.ge.s32 \t{where}, {left}, {right};\n
form test_signed_word_le where left right = \tsetp.le.s32 \t{where}, {left}, {right};\n
form test_signed_word_gt where left right = \tsetp.gt.s32 \t{where}, {left}, {right};\n
form test_wide_ne where left right = \tsetp.ne.u64 \t{where}, {left}, {right};\n
form test_wide_le where left right = \tsetp.le.u64 \t{where}, {left}, {right};\n
form test_wide_gt where left right = \tsetp.gt.u64 \t{where}, {left}, {right};\n
form test_wide_ge where left right = \tsetp.ge.u64 \t{where}, {left}, {right};\n
form test_signed_wide_lt where left right = \tsetp.lt.s64 \t{where}, {left}, {right};\n
form test_signed_wide_le where left right = \tsetp.le.s64 \t{where}, {left}, {right};\n
form test_signed_wide_gt where left right = \tsetp.gt.s64 \t{where}, {left}, {right};\n
form test_signed_wide_ge where left right = \tsetp.ge.s64 \t{where}, {left}, {right};\n
form wide_sub to left right = \tsub.s64 \t{to}, {left}, {right};\n
form wide_bitand to left right = \tand.b64 \t{to}, {left}, {right};\n
form wide_bitor to left right = \tor.b64 \t{to}, {left}, {right};\n
form wide_bitxor to left right = \txor.b64 \t{to}, {left}, {right};\n
form wide_not to from = \tnot.b64 \t{to}, {from};\n
form wide_shr to from bits = \tshr.u64 \t{to}, {from}, {bits};\n
form signed_wide_shr to from bits = \tshr.s64 \t{to}, {from}, {bits};\n
