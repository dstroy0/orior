{
  "tools": [
    {
      "id": "git",
      "name": "Git",
      "group": "orior's own",
      "needed": true,
      "for": "the gutter's changes, the Timeline and Revert, and on Windows the bash every job runs in",
      "programs": ["git"],
      "version": ["--version"],
      "install": {"windows": "https://git-scm.com/downloads/win", "macos": "https://git-scm.com/downloads/mac", "linux": "https://git-scm.com/downloads/linux"},
      "places": {"windows": ["%ProgramFiles%\\Git\\cmd", "%LOCALAPPDATA%\\Programs\\Git\\cmd"], "macos": ["/opt/homebrew/bin", "/usr/local/bin"]}
    },
    {
      "id": "bash",
      "name": "Bash",
      "group": "orior's own",
      "needed": true,
      "for": "every job's script and the terminal; on Windows it is the one that comes with Git",
      "programs": ["bash"],
      "runs": {"shell": "{program} {file}"},
      "version": ["--version"],
      "env": "ORIOR_BASH",
      "notIn": ["System32", "WindowsApps"],
      "install": {"windows": "https://git-scm.com/downloads/win", "any": "https://www.gnu.org/software/bash/"},
      "places": {"windows": ["%ProgramFiles%\\Git\\bin", "%LOCALAPPDATA%\\Programs\\Git\\bin"], "macos": ["/opt/homebrew/bin", "/bin"], "linux": ["/bin", "/usr/bin"]}
    },
    {
      "id": "python",
      "name": "Python",
      "group": "orior's own",
      "needed": true,
      "for": "the tree's Python scripts, the jobs that run them, and Black",
      "programs": ["python3", "python"],
      "runs": {"python": "{program} {file}"},
      "debugger": {"program": "python", "args": ["-m", "debugpy.adapter"], "languages": ["python"], "setup": "python -m pip install debugpy", "launch": {"program": "{program}", "cwd": "{root}", "console": "internalConsole", "justMyCode": true}},
      "version": ["--version"],
      "env": "ORIOR_PYTHON",
      "notIn": ["WindowsApps"],
      "install": {"any": "https://www.python.org/downloads/"},
      "places": {"windows": ["%LOCALAPPDATA%\\Programs\\Python\\Python3*", "%ProgramFiles%\\Python3*"], "macos": ["/Library/Frameworks/Python.framework/Versions/Current/bin", "/opt/homebrew/bin"]}
    },
    {
      "id": "pwsh",
      "name": "PowerShell 7",
      "group": "orior's own",
      "for": "the PowerShell scripts of the tree",
      "programs": ["pwsh"],
      "runs": {"powershell": "{program} -NoProfile -File {file}"},
      "version": ["-NoProfile", "-Command", "$PSVersionTable.PSVersion.ToString()"],
      "install": {"any": "https://learn.microsoft.com/powershell/scripting/install/installing-powershell"},
      "places": {"windows": ["%ProgramFiles%\\PowerShell\\7"], "macos": ["/usr/local/microsoft/powershell/7", "/opt/homebrew/bin"], "linux": ["/opt/microsoft/powershell/7"]}
    },
    {
      "id": "gh",
      "name": "GitHub CLI",
      "group": "orior's own",
      "for": "filing error reports and bug reports as issues",
      "programs": ["gh"],
      "version": ["--version"],
      "install": {"any": "https://cli.github.com/"},
      "places": {"windows": ["%ProgramFiles%\\GitHub CLI"], "macos": ["/opt/homebrew/bin", "/usr/local/bin"]}
    },
    {
      "id": "cuda",
      "name": "CUDA Toolkit",
      "group": "C, C++ and CUDA",
      "for": "nvcc, which builds the .cu sims and the tracking driver",
      "programs": ["nvcc"],
      "runs": {"c.cu": "{nvcc} {file} -o {out} && {out}"},
      "version": ["--version"],
      "install": {"windows": "https://developer.nvidia.com/cuda-downloads", "linux": "https://developer.nvidia.com/cuda-downloads"},
      "places": {"windows": ["%ProgramFiles%\\NVIDIA GPU Computing Toolkit\\CUDA\\v*\\bin"], "linux": ["/usr/local/cuda/bin"]}
    },
    {
      "id": "msvc",
      "name": "MSVC Build Tools",
      "group": "C, C++ and CUDA",
      "for": "cl, the host compiler nvcc calls on Windows; it compiles from a Developer prompt, so PATH alone is not all it needs",
      "programs": ["cl"],
      "version": [],
      "only": "windows",
      "install": {"windows": "https://visualstudio.microsoft.com/visual-cpp-build-tools/"},
      "places": {"windows": ["%ProgramFiles(x86)%\\Microsoft Visual Studio\\*\\*\\VC\\Tools\\MSVC\\*\\bin\\Hostx64\\x64", "%ProgramFiles%\\Microsoft Visual Studio\\*\\*\\VC\\Tools\\MSVC\\*\\bin\\Hostx64\\x64"]}
    },
    {
      "id": "gcc",
      "name": "GCC",
      "group": "C, C++ and CUDA",
      "for": "gcc and g++, for C and C++",
      "programs": ["gcc", "g++"],
      "runs": {"c.c": "{gcc} {file} -o {out} && {out}", "c.cpp": "{g++} {file} -o {out} && {out}", "c.cc": "{g++} {file} -o {out} && {out}"},
      "builds": {"c.c": ["{gcc}", "-g", "-O0", "{path}", "-o", "{out}"], "c.cpp": ["{g++}", "-g", "-O0", "{path}", "-o", "{out}"], "c.cc": ["{g++}", "-g", "-O0", "{path}", "-o", "{out}"]},
      "debugger": {"program": "gdb", "args": ["--interpreter=dap"], "languages": ["c"], "systems": ["linux", "macos"], "launch": {"program": "{program}", "cwd": "{root}", "args": []}},
      "version": ["--version"],
      "install": {"windows": "https://www.msys2.org/", "macos": "https://formulae.brew.sh/formula/gcc", "linux": "https://gcc.gnu.org/install/binaries.html"},
      "places": {"windows": ["C:\\msys64\\ucrt64\\bin", "C:\\msys64\\mingw64\\bin", "C:\\Strawberry\\c\\bin"], "macos": ["/opt/homebrew/bin"], "linux": ["/usr/bin"]}
    },
    {
      "id": "llvm",
      "name": "LLVM: Clang and clangd",
      "group": "C, C++ and CUDA",
      "for": "clang and clang++, and clangd, which reads C, C++ and CUDA for an editor",
      "programs": ["clang", "clang++", "clangd"],
      "runs": {"c.c": "{clang} {file} -o {out} && {out}", "c.cpp": "{clang++} {file} -o {out} && {out}", "c.cc": "{clang++} {file} -o {out} && {out}"},
      "builds": {"c.c": ["{clang}", "-g", "-O0", "{path}", "-o", "{out}"], "c.cpp": ["{clang++}", "-g", "-O0", "{path}", "-o", "{out}"], "c.cc": ["{clang++}", "-g", "-O0", "{path}", "-o", "{out}"]},
      "debugger": {"program": "lldb-dap", "args": [], "languages": ["c", "rust"], "launch": {"program": "{program}", "cwd": "{root}", "args": [], "stopOnEntry": false}, "path": {"windows": ["%LOCALAPPDATA%\\Programs\\Python\\Python311", "%ProgramFiles%\\Python311"]}},
      "server": {"program": "clangd", "args": ["--background-index", "--header-insertion=never", "--log=error"], "languages": ["c"], "ids": {"c": "c", "h": "cpp", "cpp": "cpp", "hpp": "cpp", "cc": "cpp", "cu": "cuda-cpp", "cuh": "cuda-cpp"}},
      "version": ["--version"],
      "install": {"any": "https://github.com/llvm/llvm-project/releases"},
      "places": {"windows": ["%ProgramFiles%\\LLVM\\bin"], "macos": ["/opt/homebrew/opt/llvm/bin", "/usr/local/opt/llvm/bin"], "linux": ["/usr/bin", "/usr/lib/llvm-*/bin"]}
    },
    {
      "id": "cmake",
      "name": "CMake",
      "group": "C, C++ and CUDA",
      "for": "the builds that are CMake projects",
      "programs": ["cmake"],
      "version": ["--version"],
      "install": {"any": "https://cmake.org/download/"},
      "places": {"windows": ["%ProgramFiles%\\CMake\\bin"], "macos": ["/Applications/CMake.app/Contents/bin", "/opt/homebrew/bin"], "linux": ["/usr/bin"]}
    },
    {
      "id": "ninja",
      "name": "Ninja",
      "group": "C, C++ and CUDA",
      "for": "the build CMake writes",
      "programs": ["ninja"],
      "version": ["--version"],
      "install": {"any": "https://github.com/ninja-build/ninja/releases"},
      "places": {"windows": ["%ProgramFiles%\\CMake\\bin", "%ProgramFiles%\\Microsoft Visual Studio\\*\\*\\Common7\\IDE\\CommonExtensions\\Microsoft\\CMake\\Ninja", "%ProgramFiles(x86)%\\Microsoft Visual Studio\\*\\*\\Common7\\IDE\\CommonExtensions\\Microsoft\\CMake\\Ninja"], "macos": ["/opt/homebrew/bin"], "linux": ["/usr/bin"]}
    },
    {
      "id": "make",
      "name": "GNU Make",
      "group": "C, C++ and CUDA",
      "for": "the builds that are makefiles",
      "programs": ["make"],
      "version": ["--version"],
      "install": {"windows": "https://www.msys2.org/", "any": "https://www.gnu.org/software/make/"},
      "places": {"windows": ["C:\\msys64\\usr\\bin"], "macos": ["/usr/bin"], "linux": ["/usr/bin"]}
    },
    {
      "id": "rust",
      "name": "Rust",
      "group": "Languages",
      "for": "cargo and rustc, which build orior itself, rustfmt, and rust-analyzer, which reads Rust for an editor",
      "programs": ["cargo", "rustc", "rustfmt"],
      "runs": {"rust": "{rustc} {file} -o {out} && {out}"},
      "builds": {"rust": ["{rustc}", "-g", "-C", "opt-level=0", "{path}", "-o", "{out}"]},
      "server": {"program": "rust-analyzer", "args": [], "languages": ["rust"], "setup": "rustup component add rust-analyzer", "projects": "Cargo.toml", "checks": "rust-analyzer/runFlycheck"},
      "version": ["--version"],
      "formats": ["rust"],
      "format": {"program": "rustfmt", "args": ["--edition", "{edition}"]},
      "install": {"any": "https://rustup.rs/"},
      "places": {"windows": ["%USERPROFILE%\\.cargo\\bin"], "any": ["~/.cargo/bin"]}
    },
    {
      "id": "pyright",
      "name": "Pyright",
      "group": "Languages",
      "for": "reads Python for an editor",
      "programs": ["pyright-langserver"],
      "server": {"program": "pyright-langserver", "args": ["--stdio"], "languages": ["python"]},
      "install": {"any": "https://microsoft.github.io/pyright/#/installation"},
      "places": {
        "windows": ["%APPDATA%\\npm", "%LOCALAPPDATA%\\Programs\\Python\\Python3*\\Scripts", "%APPDATA%\\Python\\Python3*\\Scripts"],
        "macos": ["/opt/homebrew/bin", "/usr/local/bin"],
        "any": ["~/.local/bin"]
      }
    },
    {
      "id": "node",
      "name": "Node.js",
      "group": "Languages",
      "for": "JavaScript, and npm, which installs Prettier",
      "programs": ["node", "npm", "npx"],
      "runs": {"javascript": "{node} {file}"},
      "version": ["--version"],
      "install": {"any": "https://nodejs.org/en/download"},
      "places": {"windows": ["%ProgramFiles%\\nodejs"], "macos": ["/opt/homebrew/bin", "/usr/local/bin"], "linux": ["/usr/bin", "/usr/local/bin"]}
    },
    {
      "id": "ruby",
      "name": "Ruby",
      "group": "Languages",
      "for": "the tree's Ruby scripts",
      "programs": ["ruby", "gem"],
      "runs": {"ruby": "{ruby} {file}"},
      "version": ["--version"],
      "install": {"windows": "https://rubyinstaller.org/downloads/", "any": "https://www.ruby-lang.org/en/documentation/installation/"},
      "places": {"windows": ["C:\\Ruby3*\\bin", "C:\\tools\\ruby3*\\bin"], "macos": ["/opt/homebrew/opt/ruby/bin", "/usr/local/opt/ruby/bin"], "linux": ["/usr/bin"]}
    },
    {
      "id": "r",
      "name": "R",
      "group": "Languages",
      "for": "Rscript, which runs the tree's R",
      "programs": ["Rscript", "R"],
      "runs": {"r": "{Rscript} {file}"},
      "version": ["--version"],
      "install": {"any": "https://cran.r-project.org/"},
      "places": {"windows": ["%ProgramFiles%\\R\\R-*\\bin"], "macos": ["/Library/Frameworks/R.framework/Resources/bin", "/opt/homebrew/bin"], "linux": ["/usr/bin"]}
    },
    {
      "id": "matlab",
      "name": "MATLAB",
      "group": "Languages",
      "for": "the tree's MATLAB, run as matlab -batch",
      "programs": ["matlab"],
      "runs": {"matlab": "{program} -batch \"run('{path}')\""},
      "install": {"any": "https://www.mathworks.com/downloads/"},
      "places": {"windows": ["%ProgramFiles%\\MATLAB\\R20*\\bin"], "macos": ["/Applications/MATLAB_R20*.app/bin"], "linux": ["/usr/local/MATLAB/R20*/bin"]}
    },
    {
      "id": "octave",
      "name": "GNU Octave",
      "group": "Languages",
      "for": "the tree's .m files where MATLAB is not there",
      "programs": ["octave-cli", "octave"],
      "runs": {"octave": "{program} {file}", "matlab": "{program} {file}"},
      "version": ["--version"],
      "install": {"any": "https://octave.org/download"},
      "places": {"windows": ["%ProgramFiles%\\GNU Octave\\Octave-*\\mingw64\\bin", "%LOCALAPPDATA%\\Programs\\GNU Octave\\Octave-*\\mingw64\\bin"], "macos": ["/opt/homebrew/bin"], "linux": ["/usr/bin"]}
    },
    {
      "id": "lean",
      "name": "Lean",
      "group": "Languages",
      "for": "lean and lake, through elan, which keeps each project on its own Lean",
      "programs": ["lean", "lake", "elan"],
      "runs": {"lean": "{lean} --run {file}"},
      "version": ["--version"],
      "install": {"any": "https://lean-lang.org/install/"},
      "setup": {
        "windows": "d=\"$(mktemp -d)\" && curl -sSfL -o \"$d/elan.zip\" https://github.com/leanprover/elan/releases/latest/download/elan-x86_64-pc-windows-msvc.zip && unzip -q -o \"$d/elan.zip\" -d \"$d\" && \"$d/elan-init.exe\" -y --default-toolchain stable && ~/.elan/bin/lean --version; rm -rf \"$d\"",
        "any": "curl -sSfL https://elan.lean-lang.org/elan-init.sh | sh -s -- -y --default-toolchain stable && ~/.elan/bin/lean --version"
      },
      "places": {"windows": ["%USERPROFILE%\\.elan\\bin"], "any": ["~/.elan/bin"]}
    },
    {
      "id": "zig",
      "name": "Zig",
      "group": "Languages",
      "for": "builds and runs Zig",
      "programs": ["zig"],
      "version": ["version"],
      "install": {"any": "https://ziglang.org/download/"},
      "places": {"windows": ["%LOCALAPPDATA%\\Microsoft\\WinGet\\Links", "%USERPROFILE%\\scoop\\shims", "%LOCALAPPDATA%\\Programs\\zig-*"], "any": ["/opt/homebrew/bin", "/usr/local/bin", "~/.local/bin"]}
    },
    {
      "id": "zls",
      "name": "ZLS",
      "group": "Languages",
      "for": "reads Zig for an editor",
      "programs": ["zls"],
      "server": {"program": "zls", "args": [], "languages": ["zig"]},
      "install": {"any": "https://github.com/zigtools/zls/releases"},
      "places": {"windows": ["%LOCALAPPDATA%\\Microsoft\\WinGet\\Links", "%USERPROFILE%\\scoop\\shims"], "any": ["/opt/homebrew/bin", "/usr/local/bin", "~/.local/bin"]}
    },
    {
      "id": "mojo",
      "name": "Mojo",
      "group": "Languages",
      "for": "builds and runs Mojo, and reads it for an editor",
      "programs": ["mojo", "mojo-lsp-server"],
      "server": {"program": "mojo-lsp-server", "args": [], "languages": ["mojo"]},
      "install": {"any": "https://docs.modular.com/mojo/manual/get-started"},
      "places": {"any": ["~/.modular/bin", "~/.pixi/bin", "~/.local/bin"]}
    },
    {
      "id": "quarto",
      "name": "Quarto",
      "group": "Languages",
      "for": "renders a .qmd to a document",
      "programs": ["quarto"],
      "version": ["--version"],
      "install": {"any": "https://quarto.org/docs/get-started/"},
      "places": {"windows": ["%LOCALAPPDATA%\\Programs\\Quarto\\bin", "%ProgramFiles%\\Quarto\\bin"], "any": ["/usr/local/bin", "/opt/quarto/bin"]}
    },
    {
      "id": "ansible-language-server",
      "name": "Ansible Language Server",
      "group": "Languages",
      "for": "reads Ansible's playbooks and roles for an editor",
      "programs": ["ansible-language-server"],
      "server": {"program": "ansible-language-server", "args": ["--stdio"], "languages": ["ansible"]},
      "install": {"any": "https://github.com/ansible/vscode-ansible"},
      "places": {"windows": ["%APPDATA%\\npm"], "any": ["~/.local/bin", "/opt/homebrew/bin", "/usr/local/bin"]}
    },
    {
      "id": "tex",
      "name": "TeX: MiKTeX or TeX Live",
      "group": "Languages",
      "for": "latexmk and the engines it runs, which build the research papers",
      "programs": ["latexmk", "lualatex", "pdflatex"],
      "runs": {"tex": "{latexmk} -pdf -interaction=nonstopmode -cd {file}"},
      "version": ["-v"],
      "install": {"windows": "https://miktex.org/download", "any": "https://tug.org/texlive/"},
      "places": {"windows": ["%LOCALAPPDATA%\\Programs\\MiKTeX\\miktex\\bin\\x64", "%ProgramFiles%\\MiKTeX\\miktex\\bin\\x64", "C:\\texlive\\20*\\bin\\windows", "C:\\texlive\\20*\\bin\\win64"], "macos": ["/Library/TeX/texbin"], "linux": ["/usr/local/texlive/20*/bin/x86_64-linux", "/usr/bin"]}
    },
    {
      "id": "ngspice",
      "name": "ngspice",
      "group": "Circuits and hardware",
      "for": "running SPICE netlists from the command line",
      "programs": ["ngspice_con", "ngspice"],
      "runs": {"ngspice": "{program} -b {file}"},
      "install": {"any": "https://ngspice.sourceforge.io/download.html"},
      "places": {"windows": ["%ProgramFiles%\\Spice64\\bin", "C:\\Spice64\\bin"], "macos": ["/opt/homebrew/bin"], "linux": ["/usr/bin"]}
    },
    {
      "id": "ltspice",
      "name": "LTspice",
      "group": "Circuits and hardware",
      "for": "opening and running the .asc schematics",
      "programs": ["LTspice", "XVIIx64"],
      "runs": {"ltspice.asc": "{program} -b {file}", "ltspice.net": "{program} -b {file}"},
      "install": {"windows": "https://www.analog.com/en/resources/design-tools-and-calculators/ltspice-simulator.html", "macos": "https://www.analog.com/en/resources/design-tools-and-calculators/ltspice-simulator.html"},
      "places": {"windows": ["%ProgramFiles%\\ADI\\LTspice", "%LOCALAPPDATA%\\Programs\\ADI\\LTspice", "%ProgramFiles%\\LTC\\LTspiceXVII"], "macos": ["/Applications/LTspice.app/Contents/MacOS"]}
    },
    {
      "id": "ghdl",
      "name": "GHDL",
      "group": "Circuits and hardware",
      "for": "analyzing and simulating VHDL",
      "programs": ["ghdl"],
      "runs": {"vhdl": "{ghdl} -c --std=08 {file} -r {stem}"},
      "version": ["--version"],
      "install": {"any": "https://github.com/ghdl/ghdl/releases"},
      "places": {"windows": ["C:\\msys64\\ucrt64\\bin", "C:\\msys64\\mingw64\\bin"], "macos": ["/opt/homebrew/bin"], "linux": ["/usr/bin", "/usr/local/bin"]}
    },
    {
      "id": "cces",
      "name": "CrossCore Embedded Studio",
      "group": "Circuits and hardware",
      "for": "cc21k and easm21k, which build SHARC code",
      "programs": ["cc21k", "easm21k"],
      "only": "windows",
      "install": {"windows": "https://www.analog.com/en/resources/evaluation-hardware-and-software/software/adswt-cces.html"},
      "places": {"windows": ["%ProgramFiles%\\Analog Devices\\CrossCore Embedded Studio *", "%ProgramFiles(x86)%\\Analog Devices\\CrossCore Embedded Studio *"]}
    },
    {
      "id": "black",
      "name": "Black",
      "group": "Formatters",
      "for": "formats Python",
      "programs": ["black"],
      "version": ["--version"],
      "formats": ["python"],
      "format": {"program": "black", "args": ["-q", "--stdin-filename", "{file}", "-"]},
      "install": {"any": "https://black.readthedocs.io/en/stable/getting_started.html"},
      "places": {"windows": ["%LOCALAPPDATA%\\Programs\\Python\\Python3*\\Scripts", "%APPDATA%\\Python\\Python3*\\Scripts"], "any": ["~/.local/bin", "/opt/homebrew/bin"]}
    },
    {
      "id": "clang-format",
      "name": "clang-format",
      "group": "Formatters",
      "for": "formats C, C++ and CUDA; it comes with LLVM",
      "programs": ["clang-format"],
      "version": ["--version"],
      "formats": ["c"],
      "format": {"program": "clang-format", "args": ["--assume-filename={file}"]},
      "install": {"any": "https://github.com/llvm/llvm-project/releases"},
      "places": {"windows": ["%ProgramFiles%\\LLVM\\bin", "%ProgramFiles%\\Microsoft Visual Studio\\*\\*\\VC\\Tools\\Llvm\\x64\\bin", "%ProgramFiles(x86)%\\Microsoft Visual Studio\\*\\*\\VC\\Tools\\Llvm\\x64\\bin"], "macos": ["/opt/homebrew/opt/llvm/bin", "/opt/homebrew/bin"], "linux": ["/usr/bin"]}
    },
    {
      "id": "prettier",
      "name": "Prettier",
      "group": "Formatters",
      "for": "formats JavaScript, CSS, HTML, JSON, Markdown and YAML; npm installs it",
      "programs": ["prettier"],
      "version": ["--version"],
      "formats": ["javascript", "css", "html", "json", "markdown", "yaml"],
      "format": {"program": "prettier", "args": ["--stdin-filepath", "{file}"]},
      "install": {"any": "https://prettier.io/docs/install"},
      "places": {"windows": ["%APPDATA%\\npm"], "macos": ["/opt/homebrew/bin", "/usr/local/bin"], "linux": ["/usr/local/bin", "/usr/bin"]}
    },
    {
      "id": "ruff",
      "name": "Ruff",
      "group": "Checkers",
      "for": "checks Python as ruff does, its fixes offered as quick fixes",
      "programs": ["ruff"],
      "version": ["--version"],
      "checker": {"program": "ruff", "languages": ["python"], "args": ["check", "--output-format", "json", "--exit-zero", "--stdin-filename", "{file}", "-"], "stdin": true, "tree": ["check", "--output-format", "json", "--exit-zero", "."], "reads": "ruff"},
      "install": {"any": "https://docs.astral.sh/ruff/installation/"},
      "places": {"windows": ["%LOCALAPPDATA%\\Programs\\Python\\Python3*\\Scripts", "%APPDATA%\\Python\\Python3*\\Scripts"], "any": ["~/.local/bin", "/opt/homebrew/bin"]}
    },
    {
      "id": "flake8",
      "name": "flake8",
      "group": "Checkers",
      "for": "checks Python as flake8 does",
      "programs": ["flake8"],
      "version": ["--version"],
      "checker": {"program": "flake8", "languages": ["python"], "args": ["--format", "%(path)s:%(row)d:%(col)d: %(code)s %(text)s", "--stdin-display-name", "{file}", "-"], "stdin": true, "tree": ["--format", "%(path)s:%(row)d:%(col)d: %(code)s %(text)s", "."], "reads": "lines"},
      "install": {"any": "https://flake8.pycqa.org/en/latest/"},
      "places": {"windows": ["%LOCALAPPDATA%\\Programs\\Python\\Python3*\\Scripts", "%APPDATA%\\Python\\Python3*\\Scripts"], "any": ["~/.local/bin"]}
    },
    {
      "id": "mypy",
      "name": "mypy",
      "group": "Checkers",
      "for": "checks Python's types as mypy does",
      "programs": ["mypy"],
      "version": ["--version"],
