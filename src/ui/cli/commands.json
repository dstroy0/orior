{
  "menus": [
    {
      "title": "File",
      "items": [
        {
          "label": "Create",
          "items": [
            { "label": "File…", "command": "create-file", "keys": "Ctrl+N", "args": "[path]" },
            { "label": "Folder…", "command": "create-folder", "args": "[path]" },
            { "label": "Repository…", "command": "create-repository", "args": "[folder]" }
          ]
        },
        {
          "label": "Open",
          "items": [
            { "label": "File…", "command": "open-file", "keys": "Ctrl+O", "args": "[file]" },
            { "label": "Folder…", "command": "open-folder", "args": "[folder]" },
            { "label": "Repository…", "command": "open-repository", "args": "[url]" }
          ]
        },
        { "label": "Clone Repository…", "command": "clone", "args": "[url] [folder]", "console": true },
        "-",
        { "label": "Save", "command": "save", "keys": "Ctrl+S", "needs": "changed-active" },
        { "label": "Save All", "command": "save-all", "needs": "changed" },
        { "label": "Auto Save", "command": "auto-save", "args": "[on|off]", "checks": "auto-save" },
        { "label": "Format on Save", "command": "format-on-save", "args": "[on|off]", "checks": "format-on-save" },
        "-",
        { "label": "Print…", "command": "print", "needs": "editor" },
        "-",
        { "label": "Close Editor", "command": "close-editor", "keys": "Ctrl+W", "needs": "tab" },
        { "label": "Close All Editors", "command": "close-all", "needs": "tabs" },
        "-",
        { "label": "Preferences", "command": "preferences", "keys": "Ctrl+," },
        { "label": "User Stylesheet", "command": "user-css", "console": true },
        "-",
        { "label": "Plugins…", "command": "plugins", "console": true },
        { "label": "New Language Plugin…", "command": "new-plugin", "args": "<name> --ext <ext,...> [--from <plugin>] [--line-comment <text>] [--block-comment <open> <close>] [--keywords <a,b>] [--types <a,b>] [--constants <a,b>] [--quotes <q,q>] [--replace]", "console": true },
        { "label": "Reload Plugins", "command": "reload-plugins" },
        "-",
        { "label": "Toolchains…", "command": "toolchains", "args": "[check|install <tool>|add-path <tool|orior>|use <tool> <folder>|forget <tool>|add <name> --group <group> --program <name,...> [--for <text>] [--id <id>] [--version <word,...>] [--install <url>]|add-group <group>|remove <tool>|remove-group <group>]", "console": true },
        "-",
        { "label": "Exit", "command": "exit" }
      ]
    },
    {
      "title": "Edit",
      "items": [
        { "label": "Undo", "command": "undo", "keys": "Ctrl+Z", "needs": "editor" },
        { "label": "Redo", "command": "redo", "keys": "Ctrl+Y", "needs": "editor" },
        { "label": "Undo History", "command": "undo-history" },
        "-",
        { "label": "Cut", "command": "cut", "keys": "Ctrl+X", "needs": "editor" },
        { "label": "Copy", "command": "copy", "keys": "Ctrl+C", "needs": "editor" },
        { "label": "Paste", "command": "paste", "keys": "Ctrl+V", "needs": "editor" },
        "-",
        {
          "label": "Macros",
          "items": [
            { "label": "Record Macro", "command": "macro-record", "needs": "editor", "checks": "macro-recording" },
            { "label": "Play Back Last Macro", "command": "macro-play", "args": "[times] [name]", "needs": "macro" },
            { "label": "Keep Last Macro…", "command": "macro-keep", "args": "[name]", "needs": "macro" },
            { "fill": "macros" }
          ]
        },
        "-",
        { "label": "Find", "command": "find", "keys": "Ctrl+F", "needs": "editor" },
        { "label": "Replace", "command": "replace", "keys": "Ctrl+H", "needs": "editor" },
        "-",
        { "label": "Find in Files", "command": "search", "keys": "Ctrl+Shift+F", "args": "[--case] [--word] [--regex] <text>", "console": true },
        "-",
        { "label": "Toggle Line Comment", "command": "comment", "keys": "Ctrl+/", "needs": "editor" },
        { "label": "Format Document", "command": "format", "keys": "Shift+Alt+F", "args": "[--check] <file>...", "needs": "editor", "console": true },
        "-",
        { "label": "Rename Symbol…", "command": "rename", "keys": "F2", "also": "Shift+F6", "needs": "editor" },
        {
          "label": "Refactor",
          "items": [
            { "label": "Extract Variable", "command": "extract-variable", "keys": "Ctrl+Alt+V", "needs": "editor" },
            { "label": "Extract Constant", "command": "extract-constant", "keys": "Ctrl+Alt+C", "needs": "editor" },
            { "label": "Extract Function", "command": "extract-function", "keys": "Ctrl+Alt+M", "needs": "editor" },
            { "label": "Inline Variable", "command": "inline-variable", "keys": "Ctrl+Alt+N", "needs": "editor" }
          ]
        },
        { "label": "Quick Fix…", "command": "quick-fix", "keys": "Ctrl+.", "also": "Alt+Enter", "needs": "editor" },
        { "label": "Parameter Info", "command": "parameter-info", "keys": "Ctrl+Shift+Space", "needs": "editor" },
        { "label": "Quick Documentation", "command": "quick-doc", "keys": "Ctrl+K Ctrl+I", "also": "Ctrl+Q", "needs": "editor" }
      ]
    },
    {
      "title": "Selection",
      "items": [
        { "label": "Select All", "command": "select-all", "keys": "Ctrl+A", "needs": "editor" },
        { "label": "Select Line", "command": "select-line", "keys": "Ctrl+L", "needs": "editor" },
        "-",
        { "label": "Copy Line Up", "command": "copy-line-up", "keys": "Shift+Alt+Up", "needs": "editor" },
        { "label": "Copy Line Down", "command": "copy-line-down", "keys": "Shift+Alt+Down", "needs": "editor" },
        { "label": "Move Line Up", "command": "move-line-up", "keys": "Alt+Up", "needs": "editor" },
        { "label": "Move Line Down", "command": "move-line-down", "keys": "Alt+Down", "needs": "editor" },
        { "label": "Join Lines", "command": "join-lines", "keys": "Ctrl+J", "needs": "editor" },
        { "label": "Sort Lines Ascending", "command": "sort-ascending", "needs": "editor" },
        { "label": "Sort Lines Descending", "command": "sort-descending", "needs": "editor" },
        { "label": "Delete Duplicate Lines", "command": "unique-lines", "needs": "editor" },
        { "label": "Transform to Uppercase", "command": "upper-case", "needs": "editor" },
        { "label": "Transform to Lowercase", "command": "lower-case", "needs": "editor" },
        { "label": "Transform to Title Case", "command": "title-case", "needs": "editor" },
        "-",
        { "label": "Add Cursor Above", "command": "cursor-above", "keys": "Ctrl+Alt+Up", "needs": "editor" },
        { "label": "Add Cursor Below", "command": "cursor-below", "keys": "Ctrl+Alt+Down", "needs": "editor" },
        { "label": "Add Next Occurrence", "command": "next-occurrence", "keys": "Ctrl+D", "needs": "editor" },
        { "label": "Select All Occurrences", "command": "all-occurrences", "keys": "Ctrl+Shift+L", "needs": "editor" },
        { "label": "Expand Selection", "command": "expand-selection", "keys": "Shift+Alt+Right", "needs": "editor" },
        { "label": "Shrink Selection", "command": "shrink-selection", "keys": "Shift+Alt+Left", "needs": "editor" },
        { "label": "Column Selection Mode", "command": "column-mode", "args": "[on|off]", "checks": "column-mode" }
      ]
    },
    {
      "title": "View",
      "items": [
        { "label": "Command Palette…", "command": "palette", "keys": "Ctrl+Shift+P" },
        "-",
        { "label": "Edit", "command": "edit-view", "keys": "Ctrl+Shift+E" },
        { "label": "Run", "command": "run-view", "keys": "Ctrl+Shift+D" },
        "-",
        { "label": "Primary Side Bar", "command": "side-bar", "keys": "Ctrl+B", "args": "[show|hide]", "checks": "side-bar" },
        { "label": "Auto Collapse Panes", "command": "auto-collapse", "args": "[on|off]", "checks": "auto-collapse" },
        { "label": "Sticky Scroll", "command": "sticky-scroll", "args": "[on|off]", "checks": "sticky-scroll" },
        { "label": "Breadcrumbs", "command": "breadcrumbs", "args": "[on|off]", "checks": "breadcrumbs" },
        { "label": "Bracket Pair Colorization", "command": "bracket-pairs", "args": "[on|off]", "checks": "bracket-pairs" },
        { "label": "Show Whitespace", "command": "whitespace", "args": "[on|off]", "checks": "whitespace" },
        { "label": "Cursor Past Line Ends", "command": "past-ends", "args": "[on|off]", "checks": "past-ends" },
        { "label": "Hide Comments", "command": "hide-comments", "keys": "Ctrl+Alt+/", "args": "[on|off]", "checks": "hide-comments" },
        { "label": "Terminal", "command": "terminal-view", "keys": "Ctrl+`" },
        { "label": "Debug", "command": "debug-view", "keys": "Alt+5" },
        "-",
        { "label": "Split Right", "command": "split-right", "keys": "Ctrl+\\", "needs": "editor" },
        { "label": "Split Down", "command": "split-down", "needs": "editor" },
        { "label": "Unsplit", "command": "unsplit", "checks": "split" },
        "-",
        { "label": "Light", "command": "scheme", "args": "[light|dark]", "labels": { "dark": "Light", "light": "Dark" } },
        { "label": "Follow System Theme", "command": "scheme-system", "args": "[on|off]", "checks": "scheme-system" },
        { "label": "Zoom In", "command": "zoom-in", "keys": "Ctrl+=" },
        { "label": "Zoom Out", "command": "zoom-out", "keys": "Ctrl+-" },
        { "label": "Reset Zoom", "command": "zoom-reset", "keys": "Ctrl+0" },
        "-",
        { "label": "Fold All", "command": "fold-all", "keys": "Ctrl+K Ctrl+0", "needs": "editor" },
        { "label": "Unfold All", "command": "unfold-all", "keys": "Ctrl+K Ctrl+J", "needs": "editor" }
      ]
    },
    {
      "title": "Go",
      "items": [
        { "label": "Back", "command": "back", "keys": "Alt+Left" },
        { "label": "Forward", "command": "forward", "keys": "Alt+Right" },
        { "label": "Last Editor", "command": "last-editor", "keys": "Ctrl+Tab" },
        "-",
        { "label": "Search Everywhere…", "command": "search-everywhere", "keys": "Shift Shift" },
        { "label": "Recent Files…", "command": "recent-files", "keys": "Ctrl+E" },
        { "label": "Go to File…", "command": "file", "keys": "Ctrl+P", "args": "[path[:line[:column]]]" },
        { "label": "Go to Symbol in Editor…", "command": "symbol", "keys": "Ctrl+Shift+O", "args": "[name]", "needs": "text" },
        { "label": "Go to Symbol in Tree…", "command": "symbol-tree", "keys": "Ctrl+T", "args": "[name]" },
        { "label": "Go to Line…", "command": "line", "keys": "Ctrl+G", "args": "[line]", "needs": "editor" },
        { "label": "Go to Bracket", "command": "bracket", "keys": "Ctrl+Shift+\\", "needs": "editor" },
        { "label": "Jump to a Place", "command": "jump", "keys": "Ctrl+;", "needs": "editor" },
        { "label": "Toggle Bookmark", "command": "bookmark", "keys": "Ctrl+F11", "needs": "editor" },
        { "label": "Bookmarks…", "command": "bookmarks", "keys": "Ctrl+Shift+F11" },
        { "label": "Go to Bridge Key…", "command": "bridge", "args": "[key]", "console": true },
        { "label": "Go to Definition", "command": "definition", "keys": "F12", "needs": "editor" },
        { "label": "Find Usages", "command": "usages", "keys": "Shift+F12", "also": "Alt+F7", "needs": "editor" },
        "-",
        { "label": "Next Problem", "command": "next-problem", "keys": "F8", "needs": "editor" },
        { "label": "Previous Problem", "command": "previous-problem", "keys": "Shift+F8", "needs": "editor" },
        "-",
        { "label": "Next Change", "command": "next-change", "keys": "Alt+F5", "needs": "changes" },
        { "label": "Previous Change", "command": "previous-change", "keys": "Shift+Alt+F5", "needs": "changes" },
        "-",
        { "label": "Next Match", "command": "next-match", "keys": "F3", "needs": "editor" },
        { "label": "Previous Match", "command": "previous-match", "keys": "Shift+F3", "needs": "editor" }
      ]
    },
    {
      "title": "Run",
      "groups": ["run"],
      "items": [
        { "label": "Continue", "command": "continue", "keys": "F5", "needs": "paused" },
        { "label": "Stop Debugging", "command": "stop-debug", "keys": "Shift+F5", "also": "Ctrl+F2", "needs": "debugging" },
        { "label": "Start", "command": "start", "keys": "F5", "args": "<job> [key=value ...] [-- words]", "needs": "job", "console": true },
        { "label": "Stop", "command": "stop", "keys": "Shift+F5", "needs": "live" },
        { "label": "Run File", "command": "run-file", "keys": "Ctrl+F5", "args": "<file>", "needs": "tab", "console": true },
        { "label": "Validate", "command": "validate", "keys": "Ctrl+Alt+F5", "args": "[--json] <file>...", "needs": "tab", "console": true },
        "-",
        { "label": "Debug File", "command": "debug", "keys": "Shift+F9", "needs": "tab" },
        { "label": "Restart Debugging", "command": "restart-debug", "keys": "Ctrl+Shift+F5", "needs": "debugged" },
        { "label": "Step Over", "command": "step-over", "keys": "F10", "needs": "paused" },
        { "label": "Step Into", "command": "step-into", "keys": "F11", "also": "F7", "needs": "paused" },
        { "label": "Step Out", "command": "step-out", "keys": "Shift+F11", "needs": "paused" },
        { "label": "Pause", "command": "pause", "keys": "F6", "needs": "running" },
        { "label": "Toggle Breakpoint", "command": "breakpoint", "keys": "F9", "also": "Ctrl+F8", "needs": "editor" },
        "-",
        { "label": "List Jobs…", "command": "list", "args": "[word]", "console": true },
        { "label": "Show Job…", "command": "show", "args": "<job>", "console": true }
      ]
    },
    { "title": "Build", "groups": ["build"] },
    { "title": "Protocol", "strip": "protocol", "groups": ["protocol"] },
    { "title": "Ingest", "strip": "ingest", "groups": ["ingest"] },
    { "title": "Render", "strip": "render", "groups": ["render", "view"] },
    { "title": "Sim", "strip": "sim", "groups": ["sim"] },
    { "title": "Pipeline", "strip": "pipeline", "groups": ["pipeline"] },
    { "title": "Stage", "strip": "stage", "groups": ["stage"], "split": "subject" },
    { "title": "Test", "groups": ["test"] },
    {
      "title": "Terminal",
      "items": [
        { "label": "New Terminal", "command": "new", "keys": "Ctrl+Shift+`" },
        { "label": "Toggle Terminal", "command": "toggle", "keys": "Ctrl+`" },
        "-",
        { "label": "Clear", "command": "clear" },
        { "label": "Kill Terminal", "command": "kill" }
      ]
    },
    {
      "title": "Help",
      "items": [
        { "label": "Keyboard Shortcuts", "command": "keys", "console": true },
        "-",
        { "label": "Report a Bug…", "command": "report", "args": "[library|cli|ui|unknown] [title]", "console": true },
        { "label": "Automatic Error Reports", "command": "auto-report", "args": "[on|off]", "console": true, "checks": "auto-report" },
        "-",
        { "label": "About", "command": "about", "console": true }
      ]
    }
  ]
}
