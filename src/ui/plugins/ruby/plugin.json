{
  "id": "ruby",
  "name": "Ruby",
  "version": "1.0.0",
  "kind": "language",
  "extensions": ["rb","rake","gemspec"],
  "comments": {"line":"#"},
  "pairs": ["()","[]","{}"],
  "quotes": ["\"","'"],
  "indentAfter": "(?:^\\s*(?:def|class|module|if|unless|elsif|else|while|until|for|case|when|begin|rescue|ensure)\\b.*|\\bdo(?:\\s*\\|[^|]*\\|)?|[{[(])\\s*(?:#.*)?$",
  "grammar": {
    "words": [
      "BEGIN", "END", "alias", "and", "begin", "break", "case", "class", "def", "defined?", "do", "else", "elsif",
      "end", "ensure", "for", "if", "in", "module", "next", "not", "or", "redo", "rescue", "retry", "return",
      "self", "super", "then", "undef", "unless", "until", "when", "while", "yield", "__method__", "__dir__"
    ],
    "constants": ["true", "false", "nil", "__FILE__", "__LINE__", "__ENCODING__"],
    "functions": [
      "puts", "print", "p", "pp", "require", "require_relative", "include", "extend", "attr_reader", "attr_writer",
      "attr_accessor", "raise", "lambda", "proc", "loop", "private", "protected", "public", "format", "gets"
    ],
    "tokenizer": {
      "root": [
        ["^=begin\\b.*$","comment","@block"],
        ["#.*$","comment"],
        ["\\s+",""],
        ["\"","string","@dq"],
        ["'(?:[^'\\\\]|\\\\.)*'","string"],
        [":[A-Za-z_]\\w*[?!]?","predefined"],
        ["@@?[A-Za-z_]\\w*|\\$[A-Za-z_]\\w*","variable"],
        ["[A-Z]\\w*","type"],
        ["[a-z_]\\w*[?!]?",{"cases":{"@words":"keyword","@constants":"predefined","@functions":"predefined","@default":"identifier"}}],
        ["0[xX][\\da-fA-F_]+|0[bB][01_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][-+]?\\d+)?r?i?","number"],
        ["[{}()\\[\\]]","@brackets"],
        ["[-+*/%=<>!&|^~?:.]+","operator"],
        ["[,;]","delimiter"]
      ],
      "block": [["^=end\\b.*$","comment","@pop"],[".+","comment"]],
      "dq": [["[^\"\\\\#]+","string"],["\\\\.","string.escape"],["#\\{[^}]*\\}","variable"],["#","string"],["\"","string","@pop"]]
    }
  }
}
