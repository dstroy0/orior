{
  "id": "xterm",
  "name": "Terminal",
  "version": "1.0.0",
  "type": "language",
  "extensions": ["ans","ansi"],
  "comments": {},
  "pairs": [],
  "quotes": [],
  "palette": {
    "keyword": "#a48cffff"
  },
  "grammar": {
    "perLine": true,
    "tokenizer": {
      "root": [
        ["\u001b\\[(?=m)", "keyword.reset", "@sgr"],
        ["\u001b\\[(?=[0-9;:]*m)", "keyword", "@sgr"],
        ["\u001b\\[[0-9;:<=>?]*[ -/]*[@-~]", "keyword"],
        ["\u001b\\][^\u0007\u001b]*(?:\u0007|\u001b\\\\)?", "keyword"],
        ["\u001b.?", "keyword"],
        ["[^\u001b]+", ""]
      ],
      "sgr": [
        ["(38)([;:]5[;:])([0-9]+)", ["keyword.foreground.indexed", "keyword", "keyword.foreground.index"]],
        ["(48)([;:]5[;:])([0-9]+)", ["keyword.background.indexed", "keyword", "keyword.background.index"]],
        ["(38)([;:]2[;:]:?)([0-9]*)([;:])([0-9]*)([;:])([0-9]*)", ["keyword.foreground.direct", "keyword", "keyword.foreground.red", "keyword", "keyword.foreground.green", "keyword", "keyword.foreground.blue"]],
        ["(48)([;:]2[;:]:?)([0-9]*)([;:])([0-9]*)([;:])([0-9]*)", ["keyword.background.direct", "keyword", "keyword.background.red", "keyword", "keyword.background.green", "keyword", "keyword.background.blue"]],
        ["0+(?=[0-9])", "keyword"],
        ["[0-9]+", {"cases": {
          "0": "keyword.reset",
          "1": "keyword.bold",
          "2": "keyword.dim",
          "3": "keyword.italic",
          "4": "keyword.underline",
          "7": "keyword.inverse",
          "9": "keyword.strike",
          "22": "keyword.normal",
          "23": "keyword.italic.off",
          "24": "keyword.underline.off",
          "27": "keyword.inverse.off",
          "29": "keyword.strike.off",
          "30": "keyword.foreground.0",
          "31": "keyword.foreground.1",
          "32": "keyword.foreground.2",
          "33": "keyword.foreground.3",
          "34": "keyword.foreground.4",
          "35": "keyword.foreground.5",
          "36": "keyword.foreground.6",
          "37": "keyword.foreground.7",
          "39": "keyword.foreground.default",
          "40": "keyword.background.0",
          "41": "keyword.background.1",
          "42": "keyword.background.2",
          "43": "keyword.background.3",
          "44": "keyword.background.4",
          "45": "keyword.background.5",
          "46": "keyword.background.6",
          "47": "keyword.background.7",
          "49": "keyword.background.default",
          "90": "keyword.foreground.8",
          "91": "keyword.foreground.9",
          "92": "keyword.foreground.10",
          "93": "keyword.foreground.11",
          "94": "keyword.foreground.12",
          "95": "keyword.foreground.13",
          "96": "keyword.foreground.14",
          "97": "keyword.foreground.15",
          "100": "keyword.background.8",
          "101": "keyword.background.9",
          "102": "keyword.background.10",
          "103": "keyword.background.11",
          "104": "keyword.background.12",
          "105": "keyword.background.13",
          "106": "keyword.background.14",
          "107": "keyword.background.15",
          "@default": "keyword"
        }}],
        ["[;:]", "keyword"],
        ["m", "keyword", "@pop"]
      ]
    }
  }
}
