{
  "id": "kfile",
  "name": "k-file",
  "version": "1.0.0",
  "kind": "language",
  "each": {
    "folder": "includes/file_defs",
    "table": "{name}/{name}.oracle.tsv",
    "unless": {"column": "where", "match": "^head \\d"},
    "except": ["g", "gsm"]
  },
  "pairs": ["()", "[]", "{}"],
  "quotes": ["\""],
  "palette": {
    "comment": "#6e6b99ff",
    "delimiter": "#9e9bc4ff",
    "identifier": "#9ea3b5ff",
    "keyword": "#a48cffff",
    "number": "#f2d48aff",
    "operator": "#ffffffff",
    "string": "#9fe3c8ff",
    "type": "#6fdcb4ff",
    "variable": "#a8c8ffff"
  },
  "grammar": {
    "perLine": true,
    "keywords": {
      "table": "includes/file_defs/{name}/{name}.oracle.tsv", "columns": ["form"],
      "match": "^\\s*([A-Za-z_][\\w-]*)"
    },
    "commentMarks": {
      "table": "includes/file_defs/{name}/{name}.oracle.tsv", "columns": ["form"],
      "rows": {"column": "kind", "match": "^comment$"}, "match": "^#"
    },
    "tokenizer": {
      "root": [
        [{"words": "commentMarks", "before": "^\\s*", "after": ".*$"}, "comment"],
        ["^(\\s*)([A-Za-z_][\\w-]*)", ["", {"cases": {"@keywords": "keyword", "@default": "identifier"}}]],
        ["<[^>\\s]*>", "type"],
        ["\\{[^}\\s]*\\}", "variable"],
        ["-?\\d+(?:\\/\\d+)?\\b", "number"],
        ["->|x>|\\*>|[=:|]", "operator"],
        ["\"[^\"]*\"", "string"],
        ["[A-Za-z_][\\w.$%-]*", "identifier"],
        ["\\s+", ""],
        [".", "delimiter"]
      ]
    }
  }
}
