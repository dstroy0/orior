{
  "id": "python",
  "name": "Python",
  "version": "1.0.0",
  "kind": "language",
  "extensions": ["py"],
  "names": ["SConstruct","SConscript"],
  "comments": {"line":"#"},
  "pairs": ["()","[]","{}"],
  "quotes": ["\"","'"],
  "indentAfter": "(?::\\s*(?:#.*)?|[{[(]\\s*)$",
  "grammar": {
    "words": [
      "False", "None", "True", "and", "as", "assert", "async", "await", "break", "class", "continue", "def",
      "del", "elif", "else", "except", "finally", "for", "from", "global", "if", "import", "in", "is",
      "lambda", "nonlocal", "not", "or", "pass", "raise", "return", "try", "while", "with", "yield", "match",
      "case", "self"
    ],
    "builtins": [
      "abs", "all", "any", "bool", "bytes", "callable", "chr", "dict", "dir", "divmod", "enumerate", "filter",
      "float", "format", "frozenset", "getattr", "hasattr", "hash", "hex", "id", "input", "int", "isinstance",
      "issubclass", "iter", "len", "list", "map", "max", "min", "next", "object", "open", "ord", "pow",
      "print", "range", "repr", "reversed", "round", "set", "setattr", "slice", "sorted", "str", "sum",
      "super", "tuple", "type", "vars", "zip"
    ],
    "indent": {
      "states": {"block": "operator.region.close"},
      "tab": 8,
      "skip": "^\\s*(?:#.*)?$",
      "begins": ["root", "block"]
    },
    "tokenizer": {
      "root": [
        ["$","delimiter.statement"],
        [":(?=\\s*(?:#.*)?$)","operator.region.open","@block"],
        {"include":"@code"}
      ],
      "block": [
        ["$","delimiter.statement"],
        [":(?=\\s*(?:#.*)?$)","operator.region.open","@block"],
        {"include":"@code"}
      ],
      "continued": [["^","","@pop"]],
      "code": [
        ["^(?=[A-Z0-9_]*[A-Z])[A-Z_][A-Z0-9_]*(?=\\s*(?::|=(?!=)))","identifier.declaration.constant"],
        ["^(\\s*)([A-Za-z_]\\w*)(\\s*:)(?=[^=]*=(?!=)(?!.*,\\s*$))",["","identifier.local","delimiter"],"@annotation"],
        ["^(\\s*)([A-Za-z_]\\w*)(?=\\s*=(?!=)(?!.*,\\s*$))",["","identifier.local"]],
        ["\\s+",""],
        ["#.*$","comment"],
        ["\\\\$","delimiter.continued","@continued"],
        ["(def)(\\s+)([A-Za-z_]\\w*)",["keyword","","identifier.declaration.function"],"@params"],
        ["(class)(\\s+)([A-Za-z_]\\w*)",["keyword","","identifier.declaration.class"]],
        ["@[A-Za-z_][\\w.]*","tag"],
        ["[rRbBfFuU]{0,2}\"\"\"","string","@long2"],
        ["[rRbBfFuU]{0,2}'''","string","@long1"],
        ["[rRbBfFuU]{0,2}\"(?:[^\"\\\\]|\\\\.)*\"","string"],
        ["[rRbBfFuU]{0,2}'(?:[^'\\\\]|\\\\.)*'","string"],
        ["[A-Za-z_]\\w*(?=\\s*\\()",{"cases":{"@words":"keyword","@builtins":"predefined.call","@default":"identifier.call"}}],
        ["[A-Za-z_]\\w*",{"cases":{"@words":"keyword","@builtins":"predefined","@default":"identifier"}}],
        [
          "0[xX][\\da-fA-F_']+[uUlLzZ]*|0[bB][01_']+[uUlL]*|(?:\\d[\\d_']*)?\\.?\\d[\\d_']*(?:[eE][+-]?\\d+)?[fFuUlLjJ]*",
          "number"
        ],
        ["[(\\[{]","delimiter.bracket.open","@nested"],
        ["[)\\]}]","delimiter.bracket.close"],
        ["=(?!=)","operator.assign"],
        ["[<>=!~:&|+\\-*/^%@]+","operator"],
        [";","delimiter.statement"],
        [",","delimiter.separator"],
        ["\\.","delimiter"]
      ],
      "params": [
        ["\\s+",""],
        ["#.*$","comment"],
        ["\\(","delimiter.bracket.parameter.open"],
        ["\\)","delimiter.bracket.parameter.close","@pop"],
        ["\\*{1,2}","operator.rest"],
        ["[A-Za-z_]\\w*(?=\\s*[:=,)])",{"cases":{"@words":"keyword","@default":"identifier.parameter"}}],
        [":","delimiter","@annotation"],
        ["=","operator.assign","@value"],
        [",","delimiter.separator"],
        {"include":"@code"}
      ],
      "annotation": [
        ["\\s+",""],
        ["(?=[,=)])","","@pop"],
        ["(?:int|float|complex|bool)(?![\\w.])","type.number"],
        ["(?:str|bytes)(?![\\w.])","type.string"],
        ["[A-Za-z_][\\w.]*","type"],
        ["\\[","delimiter.bracket.open","@arguments"],
        ["\\|","operator"]
      ],
      "arguments": [
        ["\\s+",""],
        ["\\]","delimiter.bracket.close","@pop"],
        ["\\[","delimiter.bracket.open","@arguments"],
        ["(?:int|float|complex|bool)(?![\\w.])","type.number"],
        ["(?:str|bytes)(?![\\w.])","type.string"],
        ["[A-Za-z_][\\w.]*","type"],
        [",","delimiter.separator"],
        ["\\|","delimiter"]
      ],
      "value": [
        ["(?=[,)])","","@pop"],
        {"include":"@code"}
      ],
      "nested": [
        ["[)\\]}]","delimiter.bracket.close","@pop"],
        {"include":"@code"}
      ],
      "long2": [["\"\"\"","string","@pop"],["[^\"\\\\]+|\\\\.|\"","string"]],
      "long1": [["'''","string","@pop"],["[^'\\\\]+|\\\\.|'","string"]]
    }
  }
}
