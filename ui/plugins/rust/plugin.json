{
  "id": "rust",
  "name": "Rust",
  "version": "1.0.0",
  "kind": "language",
  "extensions": ["rs"],
  "comments": {"line":"//","block":["/*","*/"]},
  "pairs": ["()","[]","{}"],
  "quotes": ["\"","'"],
  "indentAfter": "[{[(]\\s*$",
  "grammar": {
    "words": [
      "as", "async", "await", "break", "const", "continue", "crate", "dyn", "else", "enum", "extern", "false",
      "fn", "for", "if", "impl", "in", "let", "loop", "match", "mod", "move", "mut", "pub", "ref", "return",
      "self", "Self", "static", "struct", "super", "trait", "true", "type", "unsafe", "use", "where", "while"
    ],
    "types": [
      "i8", "i16", "i32", "i64", "i128", "isize", "u8", "u16", "u32", "u64", "u128", "usize", "f32", "f64",
      "bool", "char", "str", "String", "Vec", "Option", "Result", "Box", "Rc", "Arc", "HashMap", "HashSet",
      "Path", "PathBuf", "Some", "None", "Ok", "Err"
    ],
    "tokenizer": {
      "root": [
        ["#!?\\[","keyword.directive","@attribute"],
        {"include":"@whitespace"},
        ["(macro_rules!)(\\s*)([A-Za-z_]\\w*)",["predefined","","identifier.declaration.function"]],
        ["(fn)(\\s+)([A-Za-z_]\\w*)",["keyword","","identifier.declaration.function"],"@params"],
        ["(let)(\\s+)((?:mut\\s+)?)([A-Za-z_]\\w*)(\\s*:(?!:))",["keyword","","keyword","identifier.local","delimiter"],"@annotation"],
        ["(let)(\\s+)((?:mut\\s+)?)([A-Za-z_]\\w*)(?=\\s*[=;])",["keyword","","keyword","identifier.local"]],
        ["(struct|enum|union|trait|type)(\\s+)([A-Za-z_]\\w*)",["keyword","","identifier.declaration.class"]],
        ["(mod)(\\s+)([A-Za-z_]\\w*)",["keyword","","identifier.declaration.module"]],
        ["(static)(\\s+)(mut)(\\s+)([A-Za-z_]\\w*)(?=\\s*:)",["keyword","","keyword","","identifier.declaration.constant"]],
        ["(const|static)(\\s+)([A-Za-z_]\\w*)(?=\\s*:)",["keyword","","identifier.declaration.constant"]],
        ["[a-z_]\\w*!(?=\\s*[(\\[{])","predefined.call"],
        ["[a-z_]\\w*!","predefined"],
        ["'[A-Za-z_]\\w*(?!')","type"],
        ["[A-Za-z_]\\w*(?=\\s*\\()",{"cases":{"@types":"type","@words":"keyword","@default":"identifier.call"}}],
        ["[A-Za-z_]\\w*",{"cases":{"@types":"type","@words":"keyword","@default":"identifier"}}],
        [
          "0[xX][\\da-fA-F_']+[uUlLzZ]*|0[bB][01_']+[uUlL]*|(?:\\d[\\d_']*)?\\.?\\d[\\d_']*(?:[eE][+-]?\\d+)?[fFuUlLjJ]*",
          "number"
        ],
        ["b?r(#*)\"","string","@raw"],
        ["b?\"","string","@string"],
        ["b?'(?:[^'\\\\]|\\\\.[^']*)'","string"],
        ["\\{","delimiter.bracket.region.depth.open"],
        ["\\}","delimiter.bracket.region.depth.close"],
        ["[(\\[]","delimiter.bracket.depth.open"],
        ["[)\\]]","delimiter.bracket.depth.close"],
        ["=(?![=>])","operator.assign"],
        ["[<>=!~?:&|+\\-*/^%@]+","operator"],
        [";","delimiter.statement"],
        [",","delimiter.separator"],
        ["\\.","delimiter"]
      ],
      "params": [
        {"include":"@whitespace"},
        ["<[^()]*>","type"],
        ["\\(","delimiter.bracket.parameter.depth.open"],
        ["\\)","delimiter.bracket.parameter.depth.close","@pop"],
        ["&|\\*","operator.memory"],
        ["'[A-Za-z_]\\w*","type"],
        ["[A-Za-z_]\\w*(?=\\s*:(?!:))",{"cases":{"@words":"keyword","@default":"identifier.parameter"}}],
        [":(?!:)","delimiter","@annotation"],
        [",","delimiter.separator"],
        ["[A-Za-z_]\\w*",{"cases":{"@words":"keyword","@default":"identifier"}}]
      ],
      "annotation": [
        {"include":"@whitespace"},
        ["(?=[,)=;{])","","@pop"],
        ["(?:i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f32|f64)(?![\\w:])","type.number"],
        ["(?:str|String)(?![\\w:])","type.string"],
        ["&|\\*","operator.memory"],
        ["'[A-Za-z_]\\w*","type"],
        ["[<\\[(]","delimiter.bracket.depth.open","@generic"],
        ["[A-Za-z_][\\w:]*",{"cases":{"@words":"keyword","@default":"type"}}]
      ],
      "generic": [
        {"include":"@whitespace"},
        ["[>\\])]","delimiter.bracket.depth.close","@pop"],
        ["[<\\[(]","delimiter.bracket.depth.open","@generic"],
        ["(?:i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f32|f64)(?![\\w:])","type.number"],
        ["(?:str|String)(?![\\w:])","type.string"],
        ["&|\\*","operator.memory"],
        ["'[A-Za-z_]\\w*","type"],
        ["[A-Za-z_][\\w:]*",{"cases":{"@words":"keyword","@default":"type"}}],
        [",","delimiter.separator"],
        [";","delimiter.statement"],
        ["\\d+","number"]
      ],
      "attribute": [
        ["\\]","keyword.directive","@pop"],
        ["\"(?:[^\"\\\\]|\\\\.)*\"","string"],
        ["[^\\]\"]+","keyword.directive"]
      ],
      "string": [["[^\\\\\"]+","string"],["\\\\.","string.escape"],["\"","string","@pop"]],
      "raw": [["\"#*","string","@pop"],["[^\"]+","string"]],
      "whitespace": [["\\s+",""],["\\/\\*","comment","@comment"],["\\/\\/.*$","comment"]],
      "comment": [["[^/*]+","comment"],["\\/\\*","comment","@comment"],["\\*\\/","comment","@pop"],["[/*]","comment"]]
    }
  }
}
