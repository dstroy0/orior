{
  "id": "jenkins",
  "name": "Jenkins Pipeline",
  "version": "1.0.0",
  "kind": "language",
  "extensions": ["jenkinsfile","jenkins"],
  "names": ["Jenkinsfile"],
  "comments": {"line":"//","block":["/*","*/"]},
  "pairs": ["()","[]","{}"],
  "quotes": ["\"","'"],
  "indentAfter": "[{[(]\\s*$",
  "outline": [
    ["^(\\s*)(pipeline|post)\\s*\\{", "module"],
    ["^(\\s*)stage\\s*\\(\\s*['\"]([^'\"]+)['\"]", "module"],
    ["^(\\s*)(?:def|void|String|boolean|int)\\s+([A-Za-z_]\\w*)\\s*\\(", "function"]
  ],
  "grammar": {
    "words": [
      "as", "assert", "break", "case", "catch", "class", "continue", "def", "default", "do", "else", "false", "final", "finally",
      "for", "if", "import", "in", "instanceof", "new", "null", "return", "static", "switch", "this", "throw", "true", "try",
      "void", "while"
    ],
    "steps": [
      "pipeline", "agent", "stages", "stage", "steps", "post", "environment", "options", "parameters", "triggers", "tools", "when",
      "parallel", "matrix", "axes", "axis", "input", "script", "node", "always", "success", "failure", "unstable", "changed",
      "cleanup", "aborted", "fixed", "regression", "any", "none", "label", "docker", "dockerfile", "kubernetes", "branch",
      "expression", "allOf", "anyOf", "not", "beforeAgent"
    ],
    "calls": [
      "sh", "bat", "powershell", "pwsh", "echo", "checkout", "git", "timeout", "retry", "withCredentials", "withEnv",
      "archiveArtifacts", "junit", "stash", "unstash", "dir", "deleteDir", "error", "sleep", "readFile", "writeFile",
      "fileExists", "build", "string", "booleanParam", "choice", "credentials", "cron", "pollSCM", "skipDefaultCheckout",
      "buildDiscarder", "logRotator", "disableConcurrentBuilds", "catchError", "waitUntil", "mail", "emailext"
    ],
    "tokenizer": {
      "root": [
        {"include":"@whitespace"},
        ["[A-Za-z_$][\\w$]*",{"cases":{"@words":"keyword","@steps":"type","@calls":"predefined","@default":"identifier"}}],
        ["0[xX][\\da-fA-F_]+[lLgG]?|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?[lLfFdDgG]?","number"],
        ["\"\"\"","string","@triple"],
        ["'''","string","@single_triple"],
        ["\"","string","@double"],
        ["'(?:[^'\\\\]|\\\\.)*'","string"],
        ["[{}()[\\]]","@brackets"],
        ["[<>=!~?:&|+\\-*/^%]+","operator"],
        ["[;,.@]","delimiter"]
      ],
      "double": [
        ["\"","string","@pop"],
        ["\\$\\{","delimiter.bracket","@inner"],
        ["\\\\.","string.escape"],
        ["[^\"\\\\$]+|\\$","string"]
      ],
      "triple": [
        ["\"\"\"","string","@pop"],
        ["\\$\\{","delimiter.bracket","@inner"],
        ["[^\"$]+|[\"$]","string"]
      ],
      "single_triple": [["'''","string","@pop"],["[^']+|'","string"]],
      "inner": [["\\}","delimiter.bracket","@pop"],{"include":"@root"}],
      "whitespace": [["\\s+",""],["\\/\\*","comment","@comment"],["\\/\\/.*$","comment"]],
      "comment": [["[^/*]+","comment"],["\\*\\/","comment","@pop"],["[/*]","comment"]]
    }
  }
}
