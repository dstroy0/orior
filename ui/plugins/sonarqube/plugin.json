{
  "id": "sonarqube",
  "name": "SonarQube",
  "version": "6.1.1",
  "kind": "script",
  "api": 5,
  "about": "SonarQube's analysis of the tree's code: the language server and analyzers of SonarQube for IDE, found through the toolchain sonarqube-ide, analyse each file as it opens and changes, alone or bound to a project of a SonarQube Server or SonarQube Cloud. Its issues are the file's problems, with their fixes; its security hotspots, taint vulnerabilities and dependency risks, its rules and their descriptions, its connections and bindings each have a panel.",
  "main": ["base.js", "files.js", "settings.js", "server.js", "rules.js", "findings.js", "connected.js", "bindings.js", "status.js", "duplications.js", "commands.js"],
  "reads": ["**"],
  "writes": [".sonarlint/*.json"],
  "reaches": ["localhost", "127.0.0.1", "host.docker.internal", "*.sonarcloud.io", "*.sonarqube.us"],
  "server": {
    "toolchain": "sonarqube-ide",
    "program": "java",
    "args": [
      "-Dsonarlint.telemetry.disabled=true",
      "-jar",
      "{folder}/../../../server/sonarlint-ls.jar",
      "-stdio",
      "-analyzers",
      "{folder}/../../../analyzers/sonargo.jar",
      "{folder}/../../../analyzers/sonarjava.jar",
      "{folder}/../../../analyzers/sonarjavasymbolicexecution.jar",
      "{folder}/../../../analyzers/sonarjs.jar",
      "{folder}/../../../analyzers/sonarphp.jar",
      "{folder}/../../../analyzers/sonarpython.jar",
      "{folder}/../../../analyzers/sonarhtml.jar",
      "{folder}/../../../analyzers/sonarxml.jar",
      "{folder}/../../../analyzers/sonartext.jar",
      "{folder}/../../../analyzers/sonariac.jar",
      "{folder}/../../../analyzers/sonarcsharp.jar",
      "{folder}/../../../analyzers/sonarlintomnisharp.jar"
    ],
    "languages": ["*"]
  },
  "commands": [
    { "id": "analyse", "title": "SonarQube: Analyze Current File" },
    { "id": "changed", "title": "SonarQube: Analyze Changed Files" },
    { "id": "reopen", "title": "SonarQube: Reopen Local Issues for Current File" },
    { "id": "findings", "title": "SonarQube: Show Findings" },
    { "id": "hotspots", "title": "SonarQube: Scan for Hotspots in Folder" },
    { "id": "duplications", "title": "SonarQube: Show Duplications" },
    { "id": "rules", "title": "SonarQube: Show All Rules" },
    { "id": "rulesActive", "title": "SonarQube: Show Active Rules" },
    { "id": "rulesInactive", "title": "SonarQube: Show Inactive Rules" },
    { "id": "ruleByKey", "title": "SonarQube: Find Rule By Key" },
    { "id": "connections", "title": "SonarQube: Connections and Bindings" },
    { "id": "connectServer", "title": "SonarQube: Connect to SonarQube Server" },
    { "id": "connectCloud", "title": "SonarQube: Connect to SonarQube Cloud" },
    { "id": "bind", "title": "SonarQube: Add Project Binding" },
    { "id": "autobind", "title": "SonarQube: Bind All Workspace Folders" },
    { "id": "share", "title": "SonarQube: Share Connected Mode Configuration" },
    { "id": "compile", "title": "SonarQube: Configure the Compilation Database for C and C++" },
    { "id": "newCode", "title": "SonarQube: Focus on New Code" },
    { "id": "overallCode", "title": "SonarQube: Focus on Overall Code" },
    { "id": "automaticOn", "title": "SonarQube: Enable Automatic Analysis" },
    { "id": "automaticOff", "title": "SonarQube: Disable Automatic Analysis" },
    { "id": "clearLocations", "title": "SonarQube: Clear Locations" },
    { "id": "languages", "title": "SonarQube: Show Supported Languages & Analyzers" },
    { "id": "verbose", "title": "SonarQube: Enable Verbose Logging" },
    { "id": "output", "title": "SonarQube: Show Output" },
    { "id": "settings", "title": "SonarQube: Settings" }
  ]
}
