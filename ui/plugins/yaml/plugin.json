{
  "id": "yaml",
  "name": "YAML",
  "version": "1.0.0",
  "kind": "language",
  "extensions": ["yml","yaml"],
  "comments": {"line":"#"},
  "pairs": ["()","[]","{}"],
  "quotes": ["\"","'"],
  "indentAfter": ":\\s*$",
  "palette": {
    "comment": "#6e6b99ff",
    "delimiter": "#9e9bc4ff",
    "keyword": "#a48cffff",
    "number": "#f2d48aff",
    "operator": "#ffffffff",
    "string": "#9fe3c8ff",
    "tag": "#8ab8ffff",
    "type": "#6fdcb4ff",
    "variable": "#a8c8ffff"
  },
  "grammar": {
    "bracketToken": "delimiter.bracket.depth",
    "perLine": true,
    "tokenizer": {
      "root": [
        ["^(?:---|\\.\\.\\.)\\s*$","keyword"],
        [
          "^(\\s*)(-\\s+)?([^\\s#'\"][^:#]*?|\"[^\"]*\"|'[^']*')(:)(?=\\s|$)",
          ["","delimiter","variable","delimiter"]
        ],
        ["^\\s*-(?=\\s|$)","delimiter"],
        ["(^|\\s)#.*$","comment"],
        ["[&*][\\w-]+","tag"],
        ["![\\w!-]*","type"],
        ["\"(?:[^\"\\\\]|\\\\.)*\"","string"],
        ["'(?:[^']|'')*'","string"],
        [{"pattern":"\\b(?:true|false|null|yes|no|on|off)\\b","flags":"i"},"keyword"],
        ["-?\\d+(?:\\.\\d+)?\\b","number"],
        ["[{}[\\]]","@brackets"],
        ["[|>]-?(?=\\s*$)","operator"],
        ["[,:]","delimiter"],
        ["[^\\s#\"'{}[\\],:]+|\\s+|.","string"]
      ]
    }
  }
}
