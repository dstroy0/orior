{
  "id": "org",
  "name": "Org",
  "version": "1.0.0",
  "type": "language",
  "extensions": ["org"],
  "comments": {"line":"#"},
  "pairs": ["()","[]","{}"],
  "quotes": [],
  "indentAfter": "$^",
  "headings": "^(\\*+)\\s+(.*?)(?:\\s+:[\\w@#%:]+:)?\\s*$",
  "skips": [[{"pattern":"^\\s*#\\+begin_","flags":"i"}, {"pattern":"^\\s*#\\+end_","flags":"i"}]],
  "blocks": [
    [{"pattern":"^\\s*#\\+begin_","flags":"i"}, {"pattern":"^\\s*#\\+end_","flags":"i"}],
    ["^\\s*:(?!END:)[A-Za-z_-]+:\\s*$", "^\\s*:END:\\s*$"]
  ],
  "palette": {
    "comment": "#6e6b99ff",
    "delimiter": "#9e9bc4ff",
    "emphasis": "#c9b8ffff",
    "keyword": "#a48cffff",
    "number": "#f2d48aff",
    "operator": "#ffffffff",
    "string": "#9fe3c8ff",
    "strong": "#e4e3f5ff",
    "tag": "#8ab8ffff"
  },
  "grammar": {
    "tokenizer": {
      "root": [
        ["^\\*+\\s.*$","keyword"],
        [{"pattern":"^\\s*#\\+begin_\\w+.*$","flags":"i"},"string","@block"],
        ["^\\s*#\\+\\w+:.*$","tag"],
        ["^\\s*#(?:\\s.*)?$","comment"],
        ["^\\s*:[\\w-]+:","tag"],
        ["\\[\\[[^\\]]*\\](?:\\[[^\\]]*\\])?\\]","tag"],
        ["<\\d{4}-\\d{2}-\\d{2}[^>]*>|\\[\\d{4}-\\d{2}-\\d{2}[^\\]]*\\]","number"],
        ["^\\s*(?:[-+]|\\d+[.)])(?=\\s)","operator"],
        ["\\[[ X-]\\]","operator"],
        ["\\*[^*\\s][^*]*\\*","strong"],
        ["\\/[^/\\s][^/]*\\/","emphasis"],
        ["=[^=\\s][^=]*=|~[^~\\s][^~]*~","string"],
        ["\\|","delimiter"],
        ["[^*/=~[<|\\\\]+|.",""]
      ],
      "block": [[{"pattern":"^\\s*#\\+end_\\w+.*$","flags":"i"},"string","@pop"],[".*$","string"]]
    }
  }
}
