{
  "id": "toml",
  "name": "TOML",
  "version": "1.0.0",
  "type": "language",
  "extensions": ["toml","ini"],
  "comments": {"line":"#"},
  "pairs": ["()","[]","{}"],
  "quotes": ["\"","'"],
  "indentAfter": "[{[(]\\s*$",
  "palette": {
    "comment": "#6e6b99ff",
    "delimiter": "#9e9bc4ff",
    "keyword": "#a48cffff",
    "number": "#f2d48aff",
    "operator": "#ffffffff",
    "string": "#9fe3c8ff",
    "variable": "#a8c8ffff"
  },
  "grammar": {
    "perLine": true,
    "tokenizer": {
      "root": [
        [
          "^(\\[+)(\\s*)([^\\]\\s](?:[^\\]]*[^\\]\\s])?)(\\s*)(\\]+)",
          ["keyword","keyword","keyword.declaration.module","keyword","keyword"]
        ],
        ["^\\s*\\[\\[?[^\\]]*\\]\\]?","keyword"],
        ["^(\\s*)([\\w.\\-\"']+)(\\s*)([=:])",["","variable","","operator"]],
        ["[#;].*$","comment"],
        ["\"(?:[^\"\\\\]|\\\\.)*\"","string"],
        ["'[^']*'","string"],
        ["\\b(?:true|false)\\b","keyword"],
        ["[+-]?\\d[\\d_:.eE+\\-TZ]*","number"],
        ["[{\\[]","delimiter.bracket.depth.open"],
        ["[}\\]]","delimiter.bracket.depth.close"],
        ["[,=]","delimiter"],
        ["[^\\s#;\"'{}[\\],=]+|\\s+",""]
      ]
    }
  }
}
