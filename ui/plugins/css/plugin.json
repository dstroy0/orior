{
  "id": "css",
  "name": "CSS",
  "version": "1.0.0",
  "type": "language",
  "extensions": ["css"],
  "comments": {"block":["/*","*/"]},
  "pairs": ["()","[]","{}"],
  "quotes": ["\"","'"],
  "indentAfter": "[{[(]\\s*$",
  "palette": {
    "attribute": "#c9b8ffff",
    "comment": "#6e6b99ff",
    "delimiter": "#9e9bc4ff",
    "keyword": "#a48cffff",
    "number": "#f2d48aff",
    "operator": "#ffffffff",
    "predefined": "#8ab8ffff",
    "string": "#9fe3c8ff",
    "tag": "#8ab8ffff",
    "variable": "#a8c8ffff"
  },
  "grammar": {
    "bracketToken": "delimiter.bracket.depth",
    "tokenizer": {
      "root": [
        {"include":"@whitespace"},
        ["@[\\w-]+","keyword"],
        ["\\{","@brackets","@block"],
        ["::?[\\w-]+","attribute.name"],
        ["[.#]?[\\w-]+","tag"],
        ["\\[[^\\]]*\\]","attribute.name"],
        ["[>+~,*()]","operator"]
      ],
      "block": [
        {"include":"@whitespace"},
        ["\\}","@brackets","@pop"],
        ["\\{","@brackets","@block"],
        ["--[\\w-]+","variable"],
        ["[\\w-]+(?=\\s*:)","variable"],
        ["#[\\da-fA-F]{3,8}\\b","number"],
        ["-?\\d*\\.?\\d+(?:[a-z%]+)?","number"],
        ["\"[^\"]*\"|'[^']*'","string"],
        ["!important","keyword"],
        ["[\\w-]+(?=\\()","predefined"],
        ["[\\w-]+",""],
        ["[:;,()/]","delimiter"]
      ],
      "whitespace": [["\\s+",""],["\\/\\*","comment","@comment"]],
      "comment": [["[^/*]+","comment"],["\\*\\/","comment","@pop"],["[/*]","comment"]]
    }
  }
}
