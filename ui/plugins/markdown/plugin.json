{
  "id": "markdown",
  "name": "Markdown",
  "version": "1.0.0",
  "kind": "language",
  "extensions": ["md"],
  "comments": {"block":["<!--","-->"]},
  "pairs": ["()","[]","``"],
  "quotes": [],
  "indentAfter": "[{[(]\\s*$",
  "grammar": {
    "tokenizer": {
      "root": [
        ["^\\s*(?:```|~~~).*$","string","@fence"],
        ["^\\s{0,3}#{1,6}\\s.*$","keyword"],
        ["^\\s*>","comment"],
        ["^\\s*(?:[-*+]|\\d+[.)])(?=\\s)","operator"],
        ["^\\s*(?:-{3,}|\\*{3,}|_{3,})\\s*$","operator"],
        ["<!--","comment","@comment"],
        ["`[^`]+`","string"],
        ["\\$\\$?[^$]+\\$\\$?","number"],
        ["!?\\[[^\\]]*\\]\\([^)]*\\)","tag"],
        ["\\[[^\\]]*\\]\\[[^\\]]*\\]","tag"],
        ["\\*\\*[^*]+\\*\\*|__[^_]+__","strong"],
        ["\\*[^*\\s][^*]*\\*|\\b_[^_\\s][^_]*_\\b","emphasis"],
        ["\\|","delimiter"],
        ["<\\/?[\\w-]+[^>]*>","tag"],
        ["[^`$!*_[|<\\\\]+|.",""]
      ],
      "fence": [["^\\s*(?:```|~~~)\\s*$","string","@pop"],[".*$","string"]],
      "comment": [["-->","comment","@pop"],["[^-]+|-","comment"]]
    }
  }
}
