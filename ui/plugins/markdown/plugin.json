{
  "id": "markdown",
  "name": "Markdown",
  "version": "1.0.0",
  "kind": "language",
  "extensions": ["md"],
  "comments": {"block":["<!--","-->"]},
  "pairs": ["()","[]","``"],
  "quotes": [],
  "indentAfter": "[{[(]\\s*$",
  "palette": {
    "comment": "#6e6b99ff",
    "delimiter": "#9e9bc4ff",
    "emphasis": "#c9b8ffff",
    "keyword": "#a48cffff",
    "number": "#f2d48aff",
    "operator": "#ffffffff",
    "string": "#9fe3c8ff",
    "strong": "#e4e3f5ff",
    "tag": "#8ab8ffff"
  },
  "grammar": {
    "tokenizer": {
      "root": [
        ["^\\s*(?:```|~~~).*$","string","@fence"],
        ["^(#{1,6})(\\s+)(.*?[^\\s#].*?)(\\s*#*\\s*)$",["keyword","keyword","keyword.declaration.heading","keyword"]],
        ["^\\s{0,3}#{1,6}\\s.*$","keyword"],
        ["^\\s*>","comment"],
        ["^\\s*(?:[-*+]|\\d+[.)])(?=\\s)","operator"],
        ["^\\s*(?:-{3,}|\\*{3,}|_{3,})\\s*$","operator"],
        ["<!--","comment","@comment"],
        ["`[^`]+`","string"],
        ["\\$\\$?[^$]+\\$\\$?","number"],
        ["!?\\[[^\\]]*\\]\\([^)]*\\)","tag"],
        ["\\[[^\\]]*\\]\\[[^\\]]*\\]","tag"],
        ["\\*\\*[^*]+\\*\\*|__[^_]+__","strong"],
        ["\\*[^*\\s][^*]*\\*|\\b_[^_\\s][^_]*_\\b","emphasis"],
        ["\\|","delimiter"],
        ["<\\/?[\\w-]+[^>]*>","tag"],
        ["[^`$!*_[|<\\\\]+|.",""]
      ],
      "fence": [["^\\s*(?:```|~~~)\\s*$","string","@pop"],[".*$","string"]],
      "comment": [["-->","comment","@pop"],["[^-]+|-","comment"]]
    }
  }
}
