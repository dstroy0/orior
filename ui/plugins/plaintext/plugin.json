{
  "id": "plaintext",
  "name": "Plain Text",
  "version": "1.0.0",
  "kind": "language",
  "extensions": ["txt","log"],
  "comments": {},
  "pairs": [],
  "quotes": [],
  "indentAfter": "[{[(]\\s*$",
  "grammar": {
    "tokenizer": {
      "root": [["^\\s*\\S.*", "text.region.open", "@block"]],
      "block": [{"include": "@root"}]
    },
    "indent": {
      "states": {"block": "text.region.close"},
      "skip": "^\\s*$",
      "begins": ["root", "block"]
    }
  }
}
