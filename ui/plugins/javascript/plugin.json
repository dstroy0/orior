{
  "id": "javascript",
  "name": "JavaScript",
  "version": "1.0.0",
  "kind": "language",
  "extensions": ["js","mjs"],
  "comments": {"line":"//","block":["/*","*/"]},
  "pairs": ["()","[]","{}"],
  "quotes": ["\"","'","`"],
  "indentAfter": "[{[(]\\s*$",
  "grammar": {
    "words": [
      "async", "await", "break", "case", "catch", "class", "const", "continue", "debugger", "default",
      "delete", "do", "else", "export", "extends", "false", "finally", "for", "from", "function", "if",
      "import", "in", "instanceof", "let", "new", "null", "of", "return", "static", "super", "switch", "this",
      "throw", "true", "try", "typeof", "undefined", "var", "void", "while", "with", "yield"
    ],
    "tokenizer": {
      "root": [
        [
          "^((?:export\\s+)?)(const|let|var)(\\s+)([A-Za-z_$][\\w$]*)(?=\\s*=(?!=)\\s*(?:async\\s*)?(?:\\([^)]*\\)|[A-Za-z_$][\\w$]*)\\s*=>)",
          ["keyword","keyword","","identifier.declaration.function"]
        ],
        ["^((?:export\\s+)?)(const|let|var)(\\s+)([A-Za-z_$][\\w$]*)(?=\\s*=(?!=))",["keyword","keyword","","identifier.declaration.constant"]],
        [
          "^(\\s+)((?:(?:static|async|get|set)\\s+)*)(?!(?:if|for|while|switch|catch|return|function)(?![\\w$]))([A-Za-z_$][\\w$]*)(?=\\s*\\([^)]*\\)\\s*\\{\\s*$)",
          ["","keyword","identifier.declaration.method"],
          "@params"
        ],
        ["^(\\s+)(const|let|var)(\\s+)([A-Za-z_$][\\w$]*)(?=\\s*=(?!=))",["","keyword","","identifier.local"]],
        ["(function)(?![\\w$])(\\s*\\**\\s*)([A-Za-z_$][\\w$]*)",["keyword","","identifier.declaration.function"],"@params"],
        ["(class)(?![\\w$])(\\s+)([A-Za-z_$][\\w$]*)",["keyword","","identifier.declaration.class"]],
        {"include":"@whitespace"},
        ["[A-Za-z_$][\\w$]*(?=\\s*\\()",{"cases":{"@words":"keyword","@default":"identifier.call"}}],
        ["[A-Za-z_$][\\w$]*",{"cases":{"@words":"keyword","@default":"identifier"}}],
        [
          "0[xX][\\da-fA-F_']+[uUlLzZ]*|0[bB][01_']+[uUlL]*|(?:\\d[\\d_']*)?\\.?\\d[\\d_']*(?:[eE][+-]?\\d+)?[fFuUlLjJ]*",
          "number"
        ],
        ["\"(?:[^\"\\\\]|\\\\.)*\"","string"],
        ["'(?:[^'\\\\]|\\\\.)*'","string"],
        ["`","string","@template"],
        ["\\{","delimiter.bracket.region.depth.open"],
        ["\\}","delimiter.bracket.region.depth.close"],
        ["[(\\[]","delimiter.bracket.depth.open"],
        ["[)\\]]","delimiter.bracket.depth.close"],
        ["=(?![=>])","operator.assign"],
        ["[<>=!~?:&|+\\-*/^%]+","operator"],
        [";","delimiter.statement"],
        [",","delimiter.separator"],
        ["\\.","delimiter"]
      ],
      "params": [
        {"include":"@whitespace"},
        ["\\(","delimiter.bracket.parameter.depth.open"],
        ["\\)","delimiter.bracket.parameter.depth.close","@pop"],
        ["\\.\\.\\.","operator.rest"],
        ["[A-Za-z_$][\\w$]*(?=\\s*[,)=])",{"cases":{"@words":"keyword","@default":"identifier.parameter"}}],
        ["=","operator.assign","@value"],
        [",","delimiter.separator"],
        {"include":"@root"}
      ],
      "value": [
        ["(?=[,)])","","@pop"],
        ["[(\\[{]","delimiter.bracket.depth.open","@nested"],
        {"include":"@root"}
      ],
      "nested": [
        ["[)\\]}]","delimiter.bracket.depth.close","@pop"],
        ["[(\\[{]","delimiter.bracket.depth.open","@nested"],
        {"include":"@root"}
      ],
      "template": [
        ["`","string","@pop"],
        ["\\$\\{","delimiter.bracket.depth.open","@inner"],
        ["\\\\.","string.escape"],
        ["[^`\\\\$]+|\\$","string"]
      ],
      "inner": [["\\}","delimiter.bracket.depth.close","@pop"],{"include":"@root"}],
      "whitespace": [["\\s+",""],["\\/\\*","comment","@comment"],["\\/\\/.*$","comment"]],
      "comment": [["[^/*]+","comment"],["\\*\\/","comment","@pop"],["[/*]","comment"]]
    }
  }
}
