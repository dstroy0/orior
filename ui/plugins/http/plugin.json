{
  "id": "http",
  "name": "HTTP Requests",
  "version": "1.0.0",
  "kind": "language",
  "extensions": ["http","rest"],
  "comments": {"line":"#"},
  "pairs": ["()","[]","{}"],
  "quotes": ["\""],
  "indentAfter": "[{[(]\\s*$",
  "palette": {
    "comment": "#6e6b99ff",
    "delimiter": "#9e9bc4ff",
    "keyword": "#a48cffff",
    "number": "#f2d48aff",
    "operator": "#ffffffff",
    "string": "#9fe3c8ff",
    "variable": "#a8c8ffff"
  },
  "grammar": {
    "bracketToken": "delimiter.bracket.depth",
    "perLine": true,
    "tokenizer": {
      "root": [
        ["^###.*$","keyword"],
        ["^\\s*(?:#|//).*$","comment"],
        ["^(@)([\\w.\\-]+)(\\s*=)",["operator","variable","operator"]],
        ["^(?:GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|TRACE|CONNECT)\\b","keyword"],
        ["\\{\\{[^}]*\\}\\}","variable"],
        ["https?://[^\\s{]+","string"],
        ["\\bHTTP/[\\d.]+","keyword"],
        ["^([\\w\\-]+)(:)",["type","delimiter"]],
        ["^[<>] .*$","string"],
        ["\"(?:[^\"\\\\]|\\\\.)*\"","string"],
        ["-?\\d+(?:\\.\\d+)?","number"],
        ["\\b(?:true|false|null)\\b","keyword"],
        ["[{}[\\]]","@brackets"],
        ["[^\\s{}[\\]\"#/<>]+|\\s+|.",""]
      ]
    }
  }
}
