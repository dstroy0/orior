{
  "id": "tsv",
  "name": "Tables",
  "version": "1.0.0",
  "kind": "language",
  "extensions": ["tsv","csv"],
  "comments": {"line":"#"},
  "pairs": [],
  "quotes": [],
  "indentAfter": "[{[(]\\s*$",
  "palette": {
    "comment": "#6e6b99ff",
    "delimiter": "#9e9bc4ff",
    "identifier": "#9ea3b5ff",
    "keyword": "#a48cffff",
    "number": "#f2d48aff",
    "string": "#9fe3c8ff",
    "type": "#6fdcb4ff",
    "variable": "#a8c8ffff"
  },
  "grammar": {
    "tokenizer": {
      "root": [["^\\s*#.*$","comment"],["^[ \\t]+",""],["[^\\t]+","identifier.region.open","@block"],["\\t","delimiter","@c1"]],
      "block": [{"include":"@root"}],
      "c1": [["[^\\t]+","type"],["\\t","delimiter","@pop@c2"],["$","","@pop"]],
      "c2": [["[^\\t]+","variable"],["\\t","delimiter","@pop@c3"],["$","","@pop"]],
      "c3": [["[^\\t]+","string"],["\\t","delimiter","@pop@c4"],["$","","@pop"]],
      "c4": [["[^\\t]+","keyword"],["\\t","delimiter","@pop@c5"],["$","","@pop"]],
      "c5": [["[^\\t]+","number"],["\\t","delimiter","@pop@c1"],["$","","@pop"]]
    },
    "indent": {
      "states": {"block": "delimiter.region.close"},
      "skip": "^\\s*$",
      "begins": ["root", "block"]
    }
  }
}
