{
  "id": "html",
  "name": "HTML and XML",
  "version": "1.0.0",
  "type": "language",
  "extensions": ["html","htm","svg","xml"],
  "comments": {"block":["<!--","-->"]},
  "pairs": ["()","[]","{}"],
  "quotes": ["\"","'"],
  "indentAfter": "<(?!\\/|br|hr|img|input|meta|link)[\\w-]+[^>]*>\\s*$",
  "palette": {
    "attribute": "#c9b8ffff",
    "comment": "#6e6b99ff",
    "delimiter": "#9e9bc4ff",
    "keyword": "#a48cffff",
    "string": "#9fe3c8ff",
    "tag": "#8ab8ffff",
    "variable": "#a8c8ffff"
  },
  "grammar": {
    "tokenizer": {
      "root": [
        ["<!--","comment","@comment"],
        ["<!\\w[^>]*>","keyword"],
        ["(<\\/?)([\\w-]+)",["delimiter","tag"],"@tag"],
        ["&\\w+;|&#\\d+;","variable"],
        ["[^<&]+|.",""]
      ],
      "tag": [
        ["\\s+",""],
        ["([\\w:@.-]+)(\\s*=\\s*)(\"[^\"]*\"|'[^']*'|[^\\s>]+)",["attribute.name","delimiter","string"]],
        ["[\\w:@.-]+","attribute.name"],
        ["\\/?>","delimiter","@pop"]
      ],
      "comment": [["-->","comment","@pop"],["[^-]+|-","comment"]]
    }
  }
}
