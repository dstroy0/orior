{
  "id": "powershell",
  "name": "PowerShell",
  "version": "1.0.0",
  "kind": "language",
  "extensions": ["ps1","psm1"],
  "comments": {"line":"#","block":["<#","#>"]},
  "pairs": ["()","[]","{}"],
  "quotes": ["\"","'"],
  "indentAfter": "[{[(]\\s*$",
  "palette": {
    "comment": "#6e6b99ff",
    "delimiter": "#9e9bc4ff",
    "keyword": "#a48cffff",
    "number": "#f2d48aff",
    "operator": "#ffffffff",
    "predefined": "#8ab8ffff",
    "string": "#9fe3c8ff",
    "type": "#6fdcb4ff",
    "variable": "#a8c8ffff"
  },
  "grammar": {
    "ignoreCase": true,
    "words": [
      "begin", "break", "catch", "class", "continue", "data", "do", "dynamicparam", "else", "elseif", "end",
      "exit", "filter", "finally", "for", "foreach", "function", "if", "in", "param", "process", "return",
      "switch", "throw", "trap", "try", "until", "using", "while"
    ],
    "tokenizer": {
      "root": [
        [
          "^(\\s*)([Ff][Uu][Nn][Cc][Tt][Ii][Oo][Nn])(\\s+)([A-Za-z]+-[A-Za-z]+)(?![\\w-])",
          ["","keyword","","predefined.declaration.function"]
        ],
        ["^(\\s*)([Ff][Uu][Nn][Cc][Tt][Ii][Oo][Nn])(\\s+)([\\w-]+)",["","keyword","","declaration.function"]],
        ["\\s+",""],
        ["<#","comment","@comment"],
        ["#.*$","comment"],
        ["\\$(?:\\{[^}]*\\}|[\\w:]+)","variable"],
        ["\"","string","@string"],
        ["'(?:[^']|'')*'","string"],
        ["-[A-Za-z]+","operator"],
        ["[A-Za-z]+-[A-Za-z]+","predefined"],
        ["\\[[A-Za-z.]+\\]","type"],
        ["[A-Za-z_]\\w*",{"cases":{"@words":"keyword","@default":""}}],
        ["\\d+","number"],
        ["\\{","delimiter.bracket.region.depth.open"],
        ["\\}","delimiter.bracket.region.depth.close"],
        ["[(\\[]","delimiter.bracket.depth.open"],
        ["[)\\]]","delimiter.bracket.depth.close"],
        ["[<>=!&|;+*/%-]+","operator"]
      ],
      "comment": [["#>","comment","@pop"],["[^#]+|#","comment"]],
      "string": [
        ["\\$(?:\\{[^}]*\\}|[\\w:]+)","variable"],
        ["`.","string.escape"],
        ["\"","string","@pop"],
        ["[^\"`$]+|\\$","string"]
      ]
    }
  }
}
