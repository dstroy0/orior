{
  "id": "kotlin",
  "name": "Kotlin",
  "version": "1.0.0",
  "type": "language",
  "extensions": ["kt","kts"],
  "comments": {"line":"//","block":["/*","*/"]},
  "pairs": ["()","[]","{}"],
  "quotes": ["\"","'"],
  "indentAfter": "[{[(]\\s*$",
  "palette": {
    "comment": "#6e6b99ff",
    "delimiter": "#9e9bc4ff",
    "identifier": "#9ea3b5ff",
    "keyword": "#a48cffff",
    "number": "#f2d48aff",
    "operator": "#ffffffff",
    "string": "#9fe3c8ff"
  },
  "grammar": {
    "bracketToken": "delimiter.bracket.depth",
    "words": [
      "abstract", "annotation", "as", "break", "by", "catch", "class", "companion", "const", "constructor", "continue", "crossinline",
      "data", "do", "else", "enum", "external", "false", "final", "finally", "for", "fun", "get", "if", "import", "in", "infix", "init",
      "inline", "inner", "interface", "internal", "is", "lateinit", "noinline", "null", "object", "open", "operator", "out", "override",
      "package", "private", "protected", "public", "reified", "return", "sealed", "set", "super", "suspend", "tailrec", "this", "throw",
      "true", "try", "typealias", "val", "var", "vararg", "when", "where", "while"
    ],
    "tokenizer": {
      "root": [
        {"include":"@whitespace"},
        ["`[^`]*`","identifier"],
        ["[A-Za-z_][\\w]*",{"cases":{"@words":"keyword","@default":"identifier"}}],
        ["0[xX][\\da-fA-F_]+[uUL]*|0[bB][01_]+[uUL]*|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?[fFuUL]*","number"],
        ["\"\"\"","string","@raw"],
        ["\"","string","@double"],
        ["'(?:[^'\\\\]|\\\\.)*'","string"],
        ["[{}()[\\]]","@brackets"],
        ["[<>=!~?:&|+\\-*/^%]+","operator"],
        ["[;,.@]","delimiter"]
      ],
      "double": [
        ["\"","string","@pop"],
        ["\\$\\{","delimiter.bracket","@inner"],
        ["\\\\.","string.escape"],
        ["[^\"\\\\$]+|\\$","string"]
      ],
      "raw": [
        ["\"\"\"","string","@pop"],
        ["\\$\\{","delimiter.bracket","@inner"],
        ["[^\"$]+|[\"$]","string"]
      ],
      "inner": [["\\}","delimiter.bracket","@pop"],{"include":"@root"}],
      "whitespace": [["\\s+",""],["\\/\\*","comment","@comment"],["\\/\\/.*$","comment"]],
      "comment": [["[^/*]+","comment"],["\\*\\/","comment","@pop"],["[/*]","comment"]]
    }
  }
}
