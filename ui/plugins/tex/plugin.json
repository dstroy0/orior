{
  "id": "tex",
  "name": "TeX",
  "version": "1.0.0",
  "kind": "language",
  "extensions": ["tex","sty","cls","bib"],
  "comments": {"line":"%"},
  "pairs": ["{}","[]","()","$$"],
  "quotes": [],
  "indentAfter": "[{[(]\\s*$",
  "palette": {
    "comment": "#6e6b99ff",
    "delimiter": "#9e9bc4ff",
    "keyword": "#a48cffff",
    "number": "#f2d48aff",
    "operator": "#ffffffff",
    "predefined": "#8ab8ffff",
    "type": "#6fdcb4ff"
  },
  "grammar": {
    "tokenizer": {
      "root": [
        ["%.*$","comment"],
        ["(\\\\(?:begin|end))(\\{)([^}]*)(\\})",["keyword","delimiter.bracket","type","delimiter.bracket"]],
        [
          "(\\\\(?:part|chapter|section|subsection|subsubsection|paragraph)\\*?)(\\s*)(\\[)([^\\]]*)(\\])(\\s*)(\\{)(\\s*)([^}]*?)(\\s*)(\\})",
          ["keyword","","delimiter.bracket","","delimiter.bracket","","delimiter.bracket","","declaration.heading","","delimiter.bracket"]
        ],
        [
          "(\\\\(?:part|chapter|section|subsection|subsubsection|paragraph)\\*?)(\\s*)(\\{)(\\s*)([^}]*?)(\\s*)(\\})",
          ["keyword","","delimiter.bracket","","declaration.heading","","delimiter.bracket"]
        ],
        ["\\\\(?:[A-Za-z@]+|.)","keyword"],
        ["\\$\\$?","number","@math"],
        ["\\\\\\[|\\\\\\(","number","@math"],
        ["[{\\[]","delimiter.bracket.depth.open"],
        ["[}\\]]","delimiter.bracket.depth.close"],
        ["[&~^_]","operator"],
        ["[^\\\\$%{}[\\]&~^_]+",""]
      ],
      "math": [
        ["\\$\\$?|\\\\\\]|\\\\\\)","number","@pop"],
        ["\\\\(?:[A-Za-z@]+|.)","predefined"],
        ["%.*$","comment"],
        ["[^$\\\\%]+","number"]
      ]
    }
  }
}
