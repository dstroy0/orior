{
  "id": "json",
  "name": "JSON",
  "version": "1.0.0",
  "kind": "language",
  "extensions": ["json","cfg"],
  "comments": {"line":"//"},
  "pairs": ["()","[]","{}"],
  "quotes": ["\""],
  "indentAfter": "[{[(]\\s*$",
  "palette": {
    "comment": "#6e6b99ff",
    "delimiter": "#9e9bc4ff",
    "keyword": "#a48cffff",
    "number": "#f2d48aff",
    "string": "#9fe3c8ff",
    "variable": "#a8c8ffff"
  },
  "grammar": {
    "bracketToken": "delimiter.bracket.depth",
    "tokenizer": {
      "root": [
        ["\\s+",""],
        ["\"(?:[^\"\\\\]|\\\\.)*\"(?=\\s*:)","variable"],
        ["\"(?:[^\"\\\\]|\\\\.)*\"","string"],
        ["-?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?","number"],
        ["\\b(?:true|false|null)\\b","keyword"],
        ["[{}[\\]]","@brackets"],
        ["[:,]","delimiter"],
        ["\\/\\/.*$","comment"]
      ]
    }
  }
}
