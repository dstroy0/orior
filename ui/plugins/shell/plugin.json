{
  "id": "shell",
  "name": "Shell",
  "version": "1.0.0",
  "kind": "language",
  "extensions": ["sh","bash"],
  "comments": {"line":"#"},
  "pairs": ["()","[]","{}"],
  "quotes": ["\"","'"],
  "indentAfter": "(?:\\b(?:then|do|else)|[{[(]|\\bin)\\s*$",
  "palette": {
    "attribute": "#c9b8ffff",
    "comment": "#6e6b99ff",
    "delimiter": "#9e9bc4ff",
    "keyword": "#a48cffff",
    "number": "#f2d48aff",
    "operator": "#ffffffff",
    "predefined": "#8ab8ffff",
    "string": "#9fe3c8ff",
    "variable": "#a8c8ffff"
  },
  "grammar": {
    "words": [
      "if", "then", "else", "elif", "fi", "for", "while", "until", "do", "done", "case", "esac", "in",
      "function", "select", "time", "return", "local", "export", "readonly", "declare", "set", "unset",
      "shift", "exit", "break", "continue", "source", "trap", "eval", "exec"
    ],
    "builtins": ["echo","printf","cd","test","read","pwd","true","false","command","type","wait","kill"],
    "tokenizer": {
      "root": [
        ["^(\\s*)(function)(\\s+)([\\w-]+)",["","keyword","","declaration.function"]],
        ["^(\\s*)([A-Za-z_][\\w-]*)(?=\\s*\\(\\))",["","declaration.function"]],
        ["\\s+",""],
        ["#.*$","comment"],
        ["\\$(?:\\{[^}]*\\}|[A-Za-z_]\\w*|[0-9#?@*$!-])","variable"],
        ["\\$\\(\\(?","operator"],
        ["\"","string","@string"],
        ["'[^']*'","string"],
        ["'","string","@quoted"],
        ["[A-Za-z_][\\w-]*(?==)","variable"],
        ["[A-Za-z_][\\w.-]*",{"cases":{"@words":"keyword","@builtins":"predefined","@default":""}}],
        ["-{1,2}[A-Za-z][\\w-]*","attribute.name"],
        ["\\d+","number"],
        ["\\{","delimiter.bracket.region.depth.open"],
        ["\\}","delimiter.bracket.region.depth.close"],
        ["[(\\[]","delimiter.bracket.depth.open"],
        ["[)\\]]","delimiter.bracket.depth.close"],
        ["[<>=!&|;]+","operator"]
      ],
      "string": [
        ["\\$(?:\\{[^}]*\\}|[A-Za-z_]\\w*|[0-9#?@*$!-])","variable"],
        ["\\\\.","string.escape"],
        ["\"","string","@pop"],
        ["[^\"\\\\$]+|\\$","string"]
      ],
      "quoted": [["'","string","@pop"],["[^']+","string"]]
    }
  }
}
