{
  "id": "quarto",
  "name": "Quarto",
  "version": "1.0.0",
  "kind": "language",
  "extensions": ["qmd"],
  "comments": {"block":["<!--","-->"]},
  "pairs": ["()","[]","{}","``"],
  "quotes": [],
  "indentAfter": "[{[(]\\s*$",
  "headings": "^(#{1,6})\\s+(.+?)\\s*#*\\s*(?:\\{[^}]*\\})?\\s*$",
  "skips": [["^\\s*(?:```|~~~)", "^\\s*(?:```|~~~)\\s*$"]],
  "blocks": [["^\\s*```\\{", "^\\s*```\\s*$"], ["^:::+\\s*\\{", "^:::+\\s*$"]],
  "outline": [["^()#\\|\\s*label:\\s*(\\S+)", "field"]],
  "grammar": {
    "tokenizer": {
      "root": [
        ["^---\\s*$","keyword"],
        ["^\\s*```\\{[^}]*\\}.*$","keyword","@chunk"],
        ["^\\s*(?:```|~~~).*$","string","@fence"],
        ["^\\s{0,3}#{1,6}\\s.*$","keyword"],
        ["^:::+.*$","tag"],
        ["^\\s*>","comment"],
        ["^\\s*(?:[-*+]|\\d+[.)])(?=\\s)","operator"],
        ["<!--","comment","@comment"],
        ["`\\{[^}]*\\}[^`]*`","predefined"],
        ["`[^`]+`","string"],
        ["\\$\\$?[^$]+\\$\\$?","number"],
        ["@[\\w:-]+","tag"],
        ["!?\\[[^\\]]*\\]\\([^)]*\\)(?:\\{[^}]*\\})?","tag"],
        ["\\*\\*[^*]+\\*\\*|__[^_]+__","strong"],
        ["\\*[^*\\s][^*]*\\*|\\b_[^_\\s][^_]*_\\b","emphasis"],
        ["\\|","delimiter"],
        ["<\\/?[\\w-]+[^>]*>","tag"],
        ["[^`$!*_[|<@\\\\]+|.",""]
      ],
      "chunk": [["^\\s*```\\s*$","keyword","@pop"],["^#\\|.*$","comment"],[".*$","string"]],
      "fence": [["^\\s*(?:```|~~~)\\s*$","string","@pop"],[".*$","string"]],
      "comment": [["-->","comment","@pop"],["[^-]+|-","comment"]]
    }
  }
}
