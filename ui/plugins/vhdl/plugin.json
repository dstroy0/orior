{
  "id": "vhdl",
  "name": "VHDL",
  "version": "1.0.0",
  "kind": "language",
  "extensions": ["vhd","vhdl"],
  "comments": {"line":"--","block":["/*","*/"]},
  "pairs": ["()","[]"],
  "quotes": ["\""],
  "indentAfter": "(?:\\b(?:is|begin|then|else|loop|generate|record|units|protected)|=>|\\()\\s*(?:--.*)?$",
  "grammar": {
    "ignoreCase": true,
    "words": [
      "abs", "access", "after", "alias", "all", "and", "architecture", "array", "assert", "assume", "attribute",
      "begin", "block", "body", "buffer", "bus", "case", "component", "configuration", "constant", "context",
      "cover", "default", "disconnect", "downto", "else", "elsif", "end", "entity", "exit", "fairness", "file",
      "for", "force", "function", "generate", "generic", "group", "guarded", "if", "impure", "in", "inertial",
      "inout", "is", "label", "library", "linkage", "literal", "loop", "map", "mod", "nand", "new", "next", "nor",
      "not", "null", "of", "on", "open", "or", "others", "out", "package", "parameter", "port", "postponed",
      "procedure", "process", "property", "protected", "pure", "range", "record", "register", "reject", "release",
      "rem", "report", "restrict", "return", "rol", "ror", "select", "sequence", "severity", "shared", "signal",
      "sla", "sll", "sra", "srl", "strong", "subtype", "then", "to", "transport", "type", "unaffected", "units",
      "until", "use", "variable", "vmode", "vprop", "vunit", "wait", "when", "while", "with", "xnor", "xor"
    ],
    "types": [
      "bit", "bit_vector", "boolean", "boolean_vector", "character", "integer", "integer_vector", "natural",
      "positive", "real", "real_vector", "string", "time", "time_vector", "delay_length", "severity_level",
      "file_open_kind", "file_open_status", "line", "text", "std_logic", "std_logic_vector",
      "std_ulogic", "std_ulogic_vector", "signed", "unsigned", "sfixed", "ufixed", "float", "float32", "float64",
      "unresolved_signed", "unresolved_unsigned", "u_signed", "u_unsigned"
    ],
    "constants": [
      "true", "false", "note", "warning", "error", "failure", "fs", "ps", "ns", "us", "ms", "sec", "min", "hr",
      "ieee", "std", "work", "std_logic_1164", "numeric_std", "numeric_bit", "math_real", "textio",
      "std_logic_textio", "fixed_pkg", "float_pkg", "env"
    ],
    "functions": [
      "rising_edge", "falling_edge", "to_integer", "to_unsigned", "to_signed", "to_stdlogicvector",
      "to_stdulogicvector", "to_bitvector", "to_x01", "to_01", "is_x", "resize", "shift_left", "shift_right",
      "rotate_left", "rotate_right", "std_match", "now", "readline", "writeline", "read", "write", "hread",
      "hwrite", "to_string", "to_hstring", "to_ostring", "minimum", "maximum", "finish", "stop", "deallocate",
      "endfile", "file_open", "file_close", "conv_integer", "conv_std_logic_vector"
    ],
    "tokenizer": {
      "root": [
        ["--.*$","comment"],
        ["/\\*","comment","@comment"],
        ["\\s+",""],
        [{"pattern":"\\d*[us]?[box]\"[0-9a-f_xzuwlh-]*\"","flags":"i"},"number"],
        ["\"","string","@string"],
        ["'.'","string"],
        ["'[A-Za-z]\\w*","attribute"],
        ["\\\\[^\\\\]*\\\\","identifier"],
        ["[A-Za-z]\\w*",{"cases":{"@words":"keyword","@types":"type","@constants":"predefined","@functions":"predefined","@default":"identifier"}}],
        [{"pattern":"\\d[\\d_]*(?:#[0-9a-f_]+(?:\\.[0-9a-f_]+)?#)?(?:\\.[\\d_]+)?(?:e[-+]?\\d+)?","flags":"i"},"number"],
        ["[()\\[\\]]","@brackets"],
        ["<=|=>|:=|/=|>=|\\?\\?|\\?[<>/]?=?|\\*\\*|<<|>>|[-+*/&<>=|@^]","operator"],
        ["[;,.:]","delimiter"]
      ],
      "string": [["[^\"]+","string"],["\"\"","string.escape"],["\"","string","@pop"]],
      "comment": [["[^*]+","comment"],["\\*/","comment","@pop"],["\\*","comment"]]
    }
  }
}
